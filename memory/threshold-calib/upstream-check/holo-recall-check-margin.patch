--- /dev/null
+++ b/tests/test_holographic_recall_check_margin.py
@@ -0,0 +1,246 @@
+"""embeddings.RECALL_CHECK_MARGIN: a lower margin whose facts a cross-encoder has to confirm (a measurement).
+
+A lower RECALL_MARGIN before every turn lets in facts that turn silence into noise (#17). With this value set, a fact
+that stands out at the lower margin but not at RECALL_MARGIN is offered on meaning only when the cross-encoder at
+rerank_url says the fact answers the message; a fact that stands out at RECALL_MARGIN is offered as before, unasked.
+None, the default, changes nothing. No endpoint, a failed call or a no: the fact stays out. The meaning is given (no
+request), as in test_holographic_names_fit_cases; the facts are made up, the cross-encoder is a stand-in.
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+np = pytest.importorskip("numpy")
+pytest.importorskip("snowballstemmer")
+
+from hermes_plugin_holographic import HolographicMemoryProvider, embeddings, rerank  # noqa: E402
+
+_REPO = Path(__file__).resolve().parent.parent
+if str(_REPO / "tools") not in sys.path:
+    sys.path.insert(0, str(_REPO / "tools"))
+
+import mcnemar_gate as mcnemar  # noqa: E402
+import provenance_probe as pp  # noqa: E402
+
+ON = {"embeddings": "on", "embedding_url": "https://embeddings.example.net/v1", "embedding_model": "m",
+      "embedding_key_env": "TEST_EMBEDDINGS_KEY"}
+
+KEY = "The spare key hangs behind the blue flowerpot on the balcony."  # what the meaning stream may add
+FILLERS = [f"Shelf {n} of the archive holds the folders of year {1990 + n}." for n in range(32)]
+ASKS = "Whereabouts of the hidden gadget?"  # no word of a fact, no name: the words leave the turn silent
+
+
+class _NoNetwork:
+    def open(self, *a, **k):
+        raise AssertionError("no request in these tests: meaning and the verdict are given")
+
+
+class _Checker:
+    """A cross-encoder that answers one score for every question, and remembers what it was asked."""
+
+    def __init__(self, score, scale="logit"):
+        self.settings, self.score, self.asked = SimpleNamespace(scale=scale), score, []
+
+    def scores(self, query, documents, single=False):
+        self.asked.append((query, list(documents), single))
+        return None if self.score is None else [(0, self.score)]
+
+
+def _provider(tmp_path, monkeypatch, **extra):
+    monkeypatch.setattr(embeddings, "_OPENER", _NoNetwork())
+    monkeypatch.setattr(rerank, "_OPENER", _NoNetwork())
+    monkeypatch.setenv("TEST_EMBEDDINGS_KEY", "sk-test-not-a-real-key")
+    p = HolographicMemoryProvider(config={"db_path": str(tmp_path / "memory_store.db"), "hrr_dim": 64, **ON, **extra})
+    p.initialize(session_id="s1")
+    return p
+
+
+@pytest.fixture
+def provider(tmp_path, monkeypatch):
+    p = _provider(tmp_path, monkeypatch)
+    yield p
+    p.shutdown()
+
+
+def _store(provider, monkeypatch, key_similarity=0.30):
+    """KEY among the fillers; at 0.30 it stands out more than 0.5 over the chance maximum and less than
+    RECALL_MARGIN, at 0.60 it stands out at RECALL_MARGIN too."""
+    ids = {}
+    for text in (KEY, *FILLERS):
+        result = json.loads(provider.handle_tool_call("fact_store", {"action": "add", "content": text}))
+        assert "fact_id" in result, result
+        ids[text] = result["fact_id"]
+    order = list(ids)
+    sims = [key_similarity if t == KEY else 0.10 + 0.01 * (i % 12) for i, t in enumerate(order)]
+    meaning = embeddings.Meaning([ids[t] for t in order], np.array(sims), 0.3,
+                                 [embeddings.text_hash(t) for t in order])
+    assert meaning.standout(ids[KEY], 0.5, None)
+    assert meaning.standout(ids[KEY], embeddings.RECALL_MARGIN, None) == (key_similarity > 0.5)
+    monkeypatch.setattr(provider, "_meaning_of", lambda q, before_turn: meaning)
+    return ids[KEY]
+
+
+def _asked_with(provider, monkeypatch, score, scale="logit"):
+    checker = _Checker(score, scale)
+    monkeypatch.setattr(provider, "_recall_checker", lambda: checker)
+    return checker
+
+
+def _by_meaning(block: str, fact_id: int) -> bool:
+    return any(f"#{fact_id} " in line and line.endswith("(by meaning)") for line in block.splitlines())
+
+
+def test_nothing_is_asked_and_nothing_added_by_default(provider, monkeypatch):
+    _store(provider, monkeypatch)
+    checker = _asked_with(provider, monkeypatch, 5.0)
+    assert embeddings.RECALL_CHECK_MARGIN is None
+    assert provider.prefetch(ASKS) == "" and checker.asked == []
+
+
+def test_a_fact_between_the_margins_enters_when_the_cross_encoder_says_it_answers(provider, monkeypatch):
+    key = _store(provider, monkeypatch)
+    checker = _asked_with(provider, monkeypatch, 2.0)
+    monkeypatch.setattr(embeddings, "RECALL_CHECK_MARGIN", 0.5)
+    assert _by_meaning(provider.prefetch(ASKS), key)
+    assert checker.asked == [(ASKS, [KEY], True)]  # one fact, as recall shows it, scored though it is alone
+
+
+@pytest.mark.parametrize("score", [-1.0, 0.0, None])  # a no, the middle of the scale itself, a failed call
+def test_a_no_or_a_failed_call_keeps_the_fact_out(provider, monkeypatch, score):
+    _store(provider, monkeypatch)
+    checker = _asked_with(provider, monkeypatch, score)
+    monkeypatch.setattr(embeddings, "RECALL_CHECK_MARGIN", 0.5)
+    assert provider.prefetch(ASKS) == "" and len(checker.asked) == 1
+
+
+def test_one_question_a_turn_about_the_closest_fact(provider, monkeypatch):
+    """A second fact between the margins is not asked about after a no: a turn has one call's worth of time."""
+    second = "The spare bulb lies behind the green bucket in the cellar."
+    ids = {}
+    for text in (KEY, second, *FILLERS):
+        ids[text] = json.loads(provider.handle_tool_call("fact_store", {"action": "add", "content": text}))["fact_id"]
+    order = list(ids)
+    sims = [{KEY: 0.40, second: 0.39}.get(t, 0.10 + 0.01 * (i % 12)) for i, t in enumerate(order)]
+    meaning = embeddings.Meaning([ids[t] for t in order], np.array(sims), 0.3,
+                                 [embeddings.text_hash(t) for t in order])
+    for fact in (KEY, second):  # two facts this close widen the scale: both between the margins at this height
+        assert meaning.standout(ids[fact], 0.5, None) and not meaning.standout(ids[fact], embeddings.RECALL_MARGIN, None)
+    monkeypatch.setattr(provider, "_meaning_of", lambda q, before_turn: meaning)
+    checker = _asked_with(provider, monkeypatch, -1.0)
+    monkeypatch.setattr(embeddings, "RECALL_CHECK_MARGIN", 0.5)
+    assert provider.prefetch(ASKS) == "" and checker.asked == [(ASKS, [KEY], True)]
+
+
+@pytest.mark.parametrize("score,enters", [(0.6, True), (0.4, False)])
+def test_on_the_unit_scale_the_middle_is_one_half(provider, monkeypatch, score, enters):
+    key = _store(provider, monkeypatch)
+    _asked_with(provider, monkeypatch, score, scale="unit")
+    monkeypatch.setattr(embeddings, "RECALL_CHECK_MARGIN", 0.5)
+    assert _by_meaning(provider.prefetch(ASKS), key) is enters
+
+
+def test_a_fact_that_stands_out_at_the_recall_margin_is_not_asked_about(provider, monkeypatch):
+    key = _store(provider, monkeypatch, key_similarity=0.60)
+    checker = _asked_with(provider, monkeypatch, -5.0)
+    monkeypatch.setattr(embeddings, "RECALL_CHECK_MARGIN", 0.5)
+    assert _by_meaning(provider.prefetch(ASKS), key) and checker.asked == []
+
+
+def test_without_an_endpoint_the_margin_stays_the_recall_margin(provider, monkeypatch):
+    _store(provider, monkeypatch)
+    monkeypatch.setattr(embeddings, "RECALL_CHECK_MARGIN", 0.5)
+    assert provider._recall_checker() is None  # no rerank_url in this config: no call to an assumed address
+    assert provider.prefetch(ASKS) == ""
+
+
+def test_the_check_uses_the_rerank_keys_with_rerank_off(tmp_path, monkeypatch):
+    p = _provider(tmp_path, monkeypatch, rerank_url="http://127.0.0.1:9/v1/rerank", rerank_scale="unit")
+    try:
+        checker = p._recall_checker()
+        assert p._rescorer is None and checker is p._recall_checker()  # rerank stays off; one client
+        assert (checker.settings.url, checker.settings.scale) == ("http://127.0.0.1:9/v1/rerank", "unit")
+    finally:
+        p.shutdown()
+
+
+def test_one_document_is_scored_only_when_asked_for(monkeypatch):
+    client = rerank.Rescorer(rerank.Settings({"rerank_url": "http://127.0.0.1:9/v1/rerank"}))
+    sent = []
+    monkeypatch.setattr(client, "_request", lambda body: sent.append(body) or [(0, 1.5)])
+    assert client.scores("question", ["document"]) == [(0, 1.0)] and client.last_status == "skipped_single"
+    assert sent == []  # the reranker's own path: one document is not sent
+    assert client.scores("question", ["document"], single=True) == [(0, 1.5)] and client.last_status == "answered"
+    assert [body["documents"] for body in sent] == [["document"]]
+
+
+# ---------------------------------------------------------------- the probe and the gate
+
+def _stub_run(langs, modes, emb, endpoint):
+    return [{"set": "multi", "lang": "en", "qid": "0", "split": "all", "kind": "real", "q": "query",
+             "keys": ["f1"], "targets": ["t"], "hit": True, "hit5": True, "wrong": [], "wrong5": [],
+             "sources": {"f1": ["words"]}, "miss_cls": "-", "mode": modes[0], "emb": emb, "out_n": 1}]
+
+
+def _rows_in(path):
+    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
+
+
+def test_the_probe_stamps_the_checked_margin_and_puts_it_back(monkeypatch, tmp_path):
+    monkeypatch.setattr(pp, "run_multilingual", _stub_run)
+    monkeypatch.setattr(pp, "ENDPOINT", pp.ENDPOINT)
+    monkeypatch.setattr(pp._holographic_embeddings, "RECALL_MARGIN", 1.0)
+    common = ["--set", "multi", "--modes", "off", "--out", str(tmp_path), "--endpoint", "http://a/v1/rerank"]
+
+    rows = pp.main([*common, "--recall-check-margin", "0.5"])
+    assert (rows[0]["margin"], rows[0]["margin_check"]) == (0.5, 1.0)  # admitted at 0.5, checked below 1.0
+    assert pp._holographic_embeddings.RECALL_CHECK_MARGIN is None  # gone by the time main() returned
+    assert _rows_in(tmp_path / "provenance_multi_c0.5_off.jsonl")[0]["margin_check"] == 1.0
+
+    again = pp.main(common)  # the baseline run, same process: its own file, no check
+    assert (again[0]["margin"], again[0]["margin_check"]) == (1.0, None)
+    assert _rows_in(tmp_path / "provenance_multi_off.jsonl")[0]["margin_check"] is None
+
+
+def _mrow(margin, qid, keys, hit5, **over):
+    row = {"set": "multi", "lang": "en", "qid": qid, "margin": margin, "kind": "real", "q": "query",
+           "split": "all", "mode": "off", "emb": "on", "scale": "logit", "git_sha": "958de48",
+           "endpoint": "http://127.0.0.1:1237/v1/rerank", "targets": ["t"], "keys": list(keys),
+           "hit5": hit5, "wrong": [], "wrong5": [], "out_n": len(keys)}
+    row.update(over)
+    return row
+
+
+def _pair(hi, lo, tmp_path):
+    default, proposal = tmp_path / "m1_on.jsonl", tmp_path / "c0.5_on.jsonl"
+    default.write_text("\n".join(json.dumps(r) for r in hi), encoding="utf-8")
+    proposal.write_text("\n".join(json.dumps(r) for r in lo), encoding="utf-8")
+    return [str(default), str(proposal)]
+
+
+def _six_rescued(**stamp):
+    hi = [_mrow(1.0, f"r{i}", ["f1", "f2"], False) for i in range(6)]
+    lo = [_mrow(0.5, f"r{i}", ["f1", "f2", "t"], True, **stamp) for i in range(6)]
+    return hi, lo
+
+
+def test_the_gate_names_the_check_beside_the_margin(tmp_path, capsys):
+    mcnemar.report_margins(_pair(*_six_rescued(margin_check=1.0), tmp_path))
+    out = capsys.readouterr().out
+    assert "vs 0.5, checked by the cross-encoder below 1.0 (proposal)" in out and "=> gate PASSES" in out
+
+
+def test_a_bare_margin_reads_as_before(tmp_path, capsys):
+    mcnemar.report_margins(_pair(*_six_rescued(), tmp_path))  # rows written before the stamp existed
+    assert "vs 0.5 (proposal)" in capsys.readouterr().out
+
+
+def test_checked_and_bare_rows_under_one_margin_are_refused(tmp_path):
+    hi, lo = _six_rescued(margin_check=1.0)
+    lo[0]["margin_check"] = None
+    with pytest.raises(SystemExit, match="margin_check"):
+        mcnemar.report_margins(_pair(hi, lo, tmp_path))
