@@ -0,0 +1,184 @@
+import { cleanup, render, screen, within } from '@testing-library/react'
+import { afterEach, describe, expect, it } from 'vitest'
+
+import type { MemoryLayers, ProviderMemoryLayer } from '@/types/memory-layers'
+
+import { MemoryCapacity } from './memory-capacity'
+import { MemoryLayersSummary } from './memory-layers'
+
+function layers(provider: ProviderMemoryLayer, over: Partial<MemoryLayers> = {}): MemoryLayers {
+  return {
+    user: { state: 'ok', chars: 550, char_limit: 1375, entries: 6 },
+    memory: { state: 'disabled', chars: 420, char_limit: 2200, entries: 3 },
+    provider,
+    ...over
+  }
+}
+
+const FACTS: ProviderMemoryLayer = {
+  state: 'ok',
+  name: 'holographic-semantic',
+  items: 56,
+  storage_bytes: 180224,
+  budgets: [
+    {
+      key: 'catalog',
+      label: 'Fact catalog',
+      unit: 'estimated tokens',
+      enabled: true,
+      used: 1170,
+      limit: 3000,
+      listed: 54,
+      eligible: 56
+    }
+  ]
+}
+
+// The ListRow whose title is `title`, so assertions read one layer, not the card.
+function row(title: string): HTMLElement {
+  const card = screen.getByTestId('memory-capacity')
+  const label = within(card).getByText(title)
+  const container = [...card.children].find(child => child.contains(label))
+
+  if (!(container instanceof HTMLElement)) {
+    throw new Error(`no row titled ${title}`)
+  }
+
+  return container
+}
+
+afterEach(cleanup)
+
+describe('memory capacity', () => {
+  it('shows each layer on its own: the built-in files against their caps, the store as a count and a size', () => {
+    render(<MemoryCapacity layers={layers(FACTS)} />)
+
+    expect(within(row('USER.md')).getByText('550 / 1,375 characters · 40%')).toBeTruthy()
+    expect(within(row('USER.md')).getByText('6 entries')).toBeTruthy()
+    expect(within(row('Fact store')).getByText('56 active facts · 176.0 KB')).toBeTruthy()
+  })
+
+  it('gives the fact store no ceiling: no percentage and no meter', () => {
+    render(<MemoryCapacity layers={layers(FACTS)} />)
+
+    expect(row('Fact store').textContent).not.toContain('%')
+    expect(within(row('Fact store')).queryByRole('progressbar')).toBeNull()
+    // Meters exist only where something enforces a limit: USER.md's cap and the provider's catalog budget.
+    expect(screen.getAllByRole('progressbar')).toHaveLength(2)
+  })
+
+  it('shows the catalog by the provider\'s own budget, and says it is an estimate', () => {
+    render(<MemoryCapacity layers={layers(FACTS)} />)
+
+    const catalog = row('Fact catalog')
+
+    expect(within(catalog).getByText('1,170 / 3,000 estimated tokens · 39%')).toBeTruthy()
+    expect(within(catalog).getByText(/54 of 56 eligible facts listed/)).toBeTruthy()
+    expect(within(catalog).getByText(/not what a model was sent or billed/)).toBeTruthy()
+  })
+
+  it('leaves a budget bound to a settings field to the settings below it, and lists it where there are none', () => {
+    const bound = layers({ ...FACTS, budgets: [{ ...FACTS.budgets![0], field: 'catalog_max_tokens' }] })
+    const inSettings = render(<MemoryCapacity boundBelow layers={bound} />)
+
+    expect(screen.queryByText('Fact catalog')).toBeNull()
+    expect(row('Fact store')).toBeTruthy() // the store itself is still summarized
+    inSettings.unmount()
+
+    render(<MemoryCapacity layers={bound} />) // Command Center: no settings on that page
+    expect(within(row('Fact catalog')).getByText('1,170 / 3,000 estimated tokens · 39%')).toBeTruthy()
+  })
+
+  it('suggests MEMORY.md is optional while a catalog lists the same facts, with what it costs, and changes nothing', () => {
+    const catalog = { ...FACTS.budgets![0], overlaps: ['memory' as const] }
+    const overlapping: ProviderMemoryLayer = { ...FACTS, budgets: [catalog] }
+    const memoryOn = { state: 'ok' as const, chars: 1900, char_limit: 2200, entries: 9, tokens: 610 }
+
+    render(<MemoryCapacity layers={layers(overlapping, { memory: memoryOn })} />)
+
+    const hint = row('MEMORY.md is optional while Fact catalog is on')
+
+    expect(hint.textContent).toContain('(about 610 tokens)')
+    expect(hint.textContent).toContain('both can stay on')
+    expect(within(hint).queryByRole('button')).toBeNull() // a suggestion: nothing is switched off from here
+    expect(within(hint).queryByRole('switch')).toBeNull()
+    cleanup()
+
+    // Not while MEMORY.md is off (the default here) or empty, nor while the catalog itself is off.
+    for (const shown of [
+      layers(overlapping),
+      layers(overlapping, { memory: { ...memoryOn, state: 'empty' } }),
+      layers({ ...FACTS, budgets: [{ ...catalog, enabled: false }] }, { memory: memoryOn })
+    ]) {
+      render(<MemoryCapacity layers={shown} />)
+      expect(screen.queryByText(/is optional while/)).toBeNull()
+      cleanup()
+    }
+  })
+
+  it('says off, empty, unreadable and not reported apart, never as zero', () => {
+    const cases: [ProviderMemoryLayer, string, RegExp][] = [
+      [{ state: 'disabled', name: '' }, 'Off', /No memory provider is active/],
+      [{ state: 'empty', name: 'p', items: 0 }, 'Empty', /p holds no facts yet/],
+      [{ state: 'unavailable', name: 'p' }, 'Unreadable', /p could not be read/],
+      [{ state: 'unsupported', name: 'p' }, 'Not reported', /p does not report what it stores/]
+    ]
+
+    for (const [provider, pill, description] of cases) {
+      render(<MemoryCapacity layers={layers(provider)} />)
+      expect(within(row('Fact store')).getByText(pill)).toBeTruthy()
+      expect(within(row('Fact store')).getByText(description)).toBeTruthy()
+      expect(row('Fact store').textContent).not.toMatch(/\d/)
+      cleanup()
+    }
+  })
+
+  it('keeps a switched-off file distinct from an empty and an unreadable one', () => {
+    render(
+      <MemoryCapacity
+        layers={layers(FACTS, { user: { state: 'unavailable', chars: 0, char_limit: 1375, entries: 0 } })}
+      />
+    )
+
+    // Off: what is on disk is named, and no usage percentage is claimed for a layer no session loads.
+    expect(within(row('MEMORY.md')).getByText('Off')).toBeTruthy()
+    expect(within(row('MEMORY.md')).getByText(/not loaded into sessions. 3 entries/)).toBeTruthy()
+    expect(row('MEMORY.md').textContent).not.toContain('%')
+    expect(within(row('USER.md')).getByText('Unreadable')).toBeTruthy()
+    cleanup()
+
+    render(
+      <MemoryCapacity layers={layers(FACTS, { memory: { state: 'empty', chars: 0, char_limit: 2200, entries: 0 } })} />
+    )
+    expect(within(row('MEMORY.md')).getByText('Empty')).toBeTruthy()
+  })
+
+  it('shows a budget that is switched off as off, not as 0 used', () => {
+    const off = { ...FACTS, budgets: [{ ...FACTS.budgets![0], enabled: false, used: 0 }] }
+
+    render(<MemoryCapacity layers={layers(off)} />)
+
+    expect(within(row('Fact catalog')).getByText('Off')).toBeTruthy()
+    expect(row('Fact catalog').textContent).not.toMatch(/\d/)
+  })
+
+  it('appears in the Memory Layers summary, which then says which built-in file is switched off', () => {
+    render(
+      <MemoryLayersSummary
+        status={{ active: 'holographic-semantic', providers: [], builtin_files: { memory: 420, user: 550 }, layers: layers(FACTS) }}
+      />
+    )
+
+    expect(within(row('USER.md')).getByText('550 / 1,375 characters · 40%')).toBeTruthy()
+    // Maintenance passes no config draft: the pill follows the backend instead of claiming "On by default".
+    expect(screen.getByText('USER.md only')).toBeTruthy()
+    expect(screen.queryByText('On by default')).toBeNull()
+  })
+
+  it('reads a backend that predates the report as not reported, not as empty', () => {
+    render(<MemoryCapacity layers={undefined} />)
+
+    expect(within(row('Memory usage')).getByText('Not reported')).toBeTruthy()
+    expect(screen.queryByText('USER.md')).toBeNull()
+  })
+})
diff --git a/apps/desktop/src/app/settings/memory/memory-capacity.tsx b/apps/desktop/src/app/settings/memory/memory-capacity.tsx
