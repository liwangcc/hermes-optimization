@@ -0,0 +1,104 @@
+import { useState } from 'react'
+
+import { connectMemoryProvider } from '@/api/system'
+import { Button } from '@/components/ui/button'
+import { useI18n } from '@/i18n'
+import { Loader2 } from '@/lib/icons'
+import { notify } from '@/store/notifications'
+import type { MemoryProviderField } from '@/types/hermes'
+
+import { ListRow } from '../primitives'
+
+import { FieldControl, FieldTitle } from './field-control'
+
+interface Props {
+  /** A provider job is running: it may be changing the connection. */
+  disabled?: boolean
+  fields: MemoryProviderField[]
+  profile?: string
+  provider: string
+  onConnected: () => void
+}
+
+function blankSecrets(fields: MemoryProviderField[]): Record<string, string> {
+  return Object.fromEntries(fields.filter(field => field.kind === 'secret').map(field => [field.key, '']))
+}
+
+// Secrets seed blank: values are write-only and blank reuses the key saved for the address.
+function seed(fields: MemoryProviderField[]): Record<string, string> {
+  return { ...Object.fromEntries(fields.map(field => [field.key, field.value])), ...blankSecrets(fields) }
+}
+
+/**
+ * The cloud side of the connection: its fields, then Test and connect. The provider probes before it saves, so a
+ * failed test leaves the saved connection and the mode in effect as they were.
+ */
+export function ProviderConnectionForm({ disabled = false, fields, profile, provider, onConnected }: Props) {
+  const { t } = useI18n()
+  const copy = t.settings.memoryLayers.connection
+  const [values, setValues] = useState(() => seed(fields))
+  const [pending, setPending] = useState(false)
+  const [failure, setFailure] = useState<string | null>(null)
+
+  const connect = async () => {
+    setPending(true)
+    setFailure(null)
+
+    try {
+      await connectMemoryProvider(provider, values, profile)
+      // The key is saved now: its field goes blank again.
+      setValues(current => ({ ...current, ...blankSecrets(fields) }))
+      onConnected()
+      notify({ kind: 'success', message: '', title: copy.connected })
+    } catch (error) {
+      setFailure(error instanceof Error && error.message ? error.message : copy.failed)
+    } finally {
+      setPending(false)
+    }
+  }
+
+  return (
+    <form
+      aria-busy={pending}
+      data-testid="provider-connection-form"
+      onSubmit={event => {
+        event.preventDefault()
+
+        if (!pending && !disabled) {
+          void connect()
+        }
+      }}
+    >
+      <fieldset disabled={pending || disabled}>
+        {fields.map(field => (
+          <ListRow
+            action={
+              <FieldControl
+                field={field}
+                onChange={value => setValues(current => ({ ...current, [field.key]: value }))}
+                value={values[field.key] ?? ''}
+              />
+            }
+            description={field.description}
+            key={field.key}
+            title={<FieldTitle field={field} />}
+          />
+        ))}
+      </fieldset>
+      <p className="text-[length:var(--conversation-caption-font-size)] text-(--ui-text-tertiary)">
+        {copy.formDescription}
+      </p>
+      {failure && (
+        <p className="py-2 text-sm text-destructive" role="alert">
+          {failure}
+        </p>
+      )}
+      <div className="flex justify-end py-2">
+        <Button disabled={pending || disabled} size="sm" type="submit">
+          {pending && <Loader2 className="size-3.5 animate-spin" />}
+          {pending ? copy.testing : copy.testAndConnect}
+        </Button>
+      </div>
+    </form>
+  )
+}
