+import { act, cleanup, fireEvent, render, screen, within } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type * as MemoryJobsApi from '@/api/memory-jobs'
+import { getMemoryJobs, runMemoryJob } from '@/api/memory-jobs'
+import type * as SystemApi from '@/api/system'
+import { getActionStatus } from '@/api/system'
+import type { ActionStatusResponse } from '@/types/hermes'
+import type { ProviderJobsResponse } from '@/types/provider-jobs'
+
+import { ProviderJobs } from './provider-jobs'
+import { useProviderJobs } from './use-provider-jobs'
+
+// The settings panel owns the jobs' state and hands it down; this stands in for the panel.
+function Jobs() {
+  const state = useProviderJobs({ profile: 'work', provider: 'jobprov' })
+
+  return <ProviderJobs profile="work" provider="jobprov" state={state} />
+}
+
+vi.mock('@/api/memory-jobs', async importOriginal => ({
+  ...(await importOriginal<typeof MemoryJobsApi>()),
+  getMemoryJobs: vi.fn(),
+  runMemoryJob: vi.fn()
+}))
+
+vi.mock('@/api/system', async importOriginal => ({
+  ...(await importOriginal<typeof SystemApi>()),
+  getActionStatus: vi.fn()
+}))
+
+const listing = (indexed: number, ready = true): ProviderJobsResponse => ({
+  provider: 'jobprov',
+  state: 'ok',
+  actions: [
+    {
+      id: 'index',
+      label: 'Build index',
+      description: 'Index every stored fact.',
+      status: ready ? `${indexed} of 5 facts indexed` : 'The index server is not running.',
+      ready
+    }
+  ]
+})
+
+const status = (running: boolean, exitCode: null | number, lines: string[]): ActionStatusResponse => ({
+  name: 'memory-action',
+  running,
+  exit_code: exitCode,
+  pid: 7,
+  lines
+})
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  vi.mocked(getMemoryJobs).mockReset()
+  vi.mocked(runMemoryJob).mockReset().mockResolvedValue({ name: 'memory-action', ok: true, pid: 7 })
+  vi.mocked(getActionStatus).mockReset()
+})
+
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+})
+
+async function mount(): Promise<void> {
+  render(<Jobs />)
+  await act(() => vi.runOnlyPendingTimersAsync())
+}
+
+describe('provider jobs', () => {
+  it('shows where each job stands, and a job that cannot run yet cannot be started', async () => {
+    vi.mocked(getMemoryJobs).mockResolvedValue(listing(0, false))
+    await mount()
+
+    expect(screen.getByText('The index server is not running.')).toBeTruthy()
+    expect((screen.getByRole('button', { name: 'Run' }) as HTMLButtonElement).disabled).toBe(true)
+    expect(getMemoryJobs).toHaveBeenCalledWith('work')
+  })
+
+  it('runs a job for the profile, follows its output to the end, then shows where it stands', async () => {
+    vi.mocked(getMemoryJobs).mockResolvedValueOnce(listing(0)).mockResolvedValueOnce(listing(5))
+    vi.mocked(getActionStatus)
+      .mockResolvedValueOnce(
+        status(true, null, [
+          '=== memory-action started 2026-11-20 04:46:41 ===',
+          'Build index: 0 of 5 facts indexed',
+          '2 of 5 facts indexed'
+        ])
+      )
+      .mockResolvedValueOnce(status(false, 0, ['5 of 5 facts indexed', 'All 5 facts are indexed.']))
+    await mount()
+
+    fireEvent.click(screen.getByRole('button', { name: 'Run' }))
+    await act(() => vi.runOnlyPendingTimersAsync())
+
+    expect(runMemoryJob).toHaveBeenCalledWith('index', 'work')
+    const output = screen.getByTestId('provider-job-output')
+
+    expect(within(output).getByRole('status').textContent).toBe('Running…')
+    expect(output.textContent).toContain('2 of 5 facts indexed')
+    expect(output.textContent).not.toContain('=== memory-action started')
+    expect((screen.getByRole('button', { name: 'Running…' }) as HTMLButtonElement).disabled).toBe(true)
+
+    await act(() => vi.advanceTimersByTimeAsync(1200))
+
+    expect(within(screen.getByTestId('provider-job-output')).getByRole('status').textContent).toBe('Finished.')
+    expect(screen.getByText(/All 5 facts are indexed\./)).toBeTruthy()
+    expect(screen.getByText('5 of 5 facts indexed', { selector: 'span' })).toBeTruthy() // the list, read again
+    expect(getActionStatus).toHaveBeenCalledTimes(2)
+  })
+
+  it('says how a failed job ended, with its output', async () => {
+    vi.mocked(getMemoryJobs).mockResolvedValue(listing(2))
+    vi.mocked(getActionStatus).mockResolvedValue(status(false, 1, ['Failed: the index server refused the batch']))
+    await mount()
+
+    fireEvent.click(screen.getByRole('button', { name: 'Run' }))
+    await act(() => vi.runOnlyPendingTimersAsync())
+
+    expect(screen.getByRole('status').textContent).toBe('Failed (exit code 1).')
+    expect(screen.getByText(/refused the batch/)).toBeTruthy()
+  })
+
+  it('shows nothing for a provider without jobs, or on a Hermes older than the route', async () => {
+    vi.mocked(getMemoryJobs).mockResolvedValue({ provider: 'jobprov', state: 'unsupported', actions: [] })
+    await mount()
+    expect(screen.queryByTestId('provider-jobs')).toBeNull()
+    cleanup()
+
+    vi.mocked(getMemoryJobs).mockRejectedValue(new Error('404: {"detail":"No such API endpoint: /api/memory/actions"}'))
+    await mount()
+    expect(screen.queryByTestId('provider-jobs')).toBeNull()
+  })
+})
