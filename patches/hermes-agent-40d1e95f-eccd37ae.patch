+// The active memory provider's maintenance jobs: `GET /api/memory/actions`.
+
+export interface ProviderJob {
+  id: string
+  label: string
+  description: string
+  /** Where the job stands now, in the provider's words ("80 of 120 facts indexed"). */
+  status: string
+  /** False when it cannot run yet; `status` says why. */
+  ready: boolean
+  /** A job run with one choice (a model, say); `selected` is the one in use. */
+  options?: ProviderJobOption[]
+  selected?: string
+  /** The config field this job proposes a value for: it shows beside that field. */
+  field?: string
+  /** The proposed value once a run produced one; `status` says what it rests on. */
+  suggestion?: string
+}
+
+export interface ProviderJobOption {
+  id: string
+  label: string
+  /** What choosing it means, one fact per line (sizes, where it is cached). */
+  description: string
+}
+
+export interface ProviderJobsResponse {
+  provider: string
+  state: 'disabled' | 'ok' | 'unavailable' | 'unsupported'
+  actions: ProviderJob[]
+}
