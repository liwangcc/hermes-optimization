index 0000000000000000000000000000000000000000..1f396779091145dbe546d0a9086500f0177fdba3
--- /dev/null
+++ b/apps/desktop/src/store/memory-checkup-reminder.ts
@@ -0,0 +1,227 @@
+import { LOCAL_CONNECTION_ID } from '@hermes/shared'
+import { atom } from 'nanostores'
+
+import { $apiRequestScope } from '@/api/client'
+import { readJson, writeJson } from '@/lib/storage'
+import { $activeGatewayProfile } from '@/store/profile'
+import { $gatewayState } from '@/store/session'
+
+import { checkupScopeFor, memoryCheckupScope } from './memory-checkup'
+
+// The memory checkup's reminder: on until the user turns it off (a checkup
+// nobody is told about is never run), a clock kept per (connection, profile)
+// on this device. No cron, no background model turn, nothing in the system
+// prompt: the reminder is this app's alone, and the model runs only when the
+// user answers "Review now".
+
+const KEY_PREFIX = 'hermes:memory-checkup-reminder:'
+const DAY_MS = 24 * 60 * 60 * 1000
+const CHECK_INTERVAL_MS = 60 * 60 * 1000
+
+export const REMINDER_INTERVAL_DAYS = [10, 14] as const
+export type ReminderIntervalDays = (typeof REMINDER_INTERVAL_DAYS)[number]
+export const DEFAULT_REMINDER_INTERVAL_DAYS: ReminderIntervalDays = 14
+
+export interface MemoryCheckupReminder {
+  enabled: boolean
+  intervalDays: ReminderIntervalDays
+  /** When the next reminder is due (epoch ms); null while off. */
+  dueAt: null | number
+  /** A reminder waits for the user's answer: on screen, or queued behind another offer. */
+  pending: boolean
+}
+
+const OFF: MemoryCheckupReminder = {
+  enabled: false,
+  intervalDays: DEFAULT_REMINDER_INTERVAL_DAYS,
+  dueAt: null,
+  pending: false
+}
+
+function readReminder(scope: string, now = Date.now()): MemoryCheckupReminder {
+  const stored = readJson<Partial<MemoryCheckupReminder>>(KEY_PREFIX + scope)
+
+  if (!stored || typeof stored !== 'object') {
+    // Never set here: on, first due one interval after this first look. Stored, so the clock does not start again
+    // with every read; "off" is stored too (save), so no record only ever means never set.
+    const first: MemoryCheckupReminder = {
+      enabled: true,
+      intervalDays: DEFAULT_REMINDER_INTERVAL_DAYS,
+      dueAt: now + DEFAULT_REMINDER_INTERVAL_DAYS * DAY_MS,
+      pending: false
+    }
+
+    writeJson(KEY_PREFIX + scope, first)
+
+    return first
+  }
+
+  const intervalDays = REMINDER_INTERVAL_DAYS.find(days => days === stored.intervalDays) ?? OFF.intervalDays
+  const dueAt = typeof stored.dueAt === 'number' && Number.isFinite(stored.dueAt) ? stored.dueAt : null
+  const enabled = stored.enabled === true && dueAt !== null
+
+  return { enabled, intervalDays, dueAt: enabled ? dueAt : null, pending: enabled && stored.pending === true }
+}
+
+export const $memoryCheckupReminder = atom<MemoryCheckupReminder>(OFF)
+
+function show(next: MemoryCheckupReminder): void {
+  const shown = $memoryCheckupReminder.get()
+
+  // Reference identity on no-ops: an hourly check must not repaint the strip.
+  if (JSON.stringify(shown) !== JSON.stringify(next)) {
+    $memoryCheckupReminder.set(next)
+  }
+}
+
+function save(scope: string, next: MemoryCheckupReminder): void {
+  // Always the record, "off" included: a missing one reads as never set, which is on.
+  writeJson(KEY_PREFIX + scope, next)
+
+  if (scope === memoryCheckupScope()) {
+    show(next)
+  }
+}
+
+/**
+ * A due reminder becomes pending: one reminder, however many intervals passed
+ * while the app was closed. The clock does not move here; it moves when the
+ * reminder is actually shown (below), which can be later when another offer
+ * holds the composer's one slot.
+ */
+export function checkMemoryCheckupDue(now = Date.now()): void {
+  const scope = memoryCheckupScope()
+  const stored = readReminder(scope, now)
+
+  if (stored.enabled && !stored.pending && stored.dueAt !== null && now >= stored.dueAt) {
+    save(scope, { ...stored, pending: true })
+  } else {
+    show(stored)
+  }
+}
+
+/**
+ * The reminder is on screen: the next interval starts now, when it is first
+ * shown, not when a checkup completes. The read is fresh from storage, so a
+ * rerender, a reload or another window finds the due date already in the
+ * future and changes nothing.
+ */
+// shortcut: localStorage has no cross-window transaction; two windows that first show it within the same few
+// milliseconds both write a due date, a moment apart. Move the clock to the main process if that must be exact.
+export function markMemoryCheckupReminderShown(now = Date.now()): void {
+  const scope = memoryCheckupScope()
+  const stored = readReminder(scope, now)
+
+  if (stored.pending && stored.dueAt !== null && now >= stored.dueAt) {
+    save(scope, { ...stored, dueAt: now + stored.intervalDays * DAY_MS })
+  }
+}
+
+/** The user's setting. Turning it on or changing the interval starts the clock from now. */
+export function setMemoryCheckupReminder(
+  change: { enabled?: boolean; intervalDays?: ReminderIntervalDays },
+  now = Date.now()
+): void {
+  const scope = memoryCheckupScope()
+  const current = readReminder(scope, now)
+  const enabled = change.enabled ?? current.enabled
+  const intervalDays = change.intervalDays ?? current.intervalDays
+
+  save(scope, {
+    enabled,
+    intervalDays,
+    dueAt: enabled ? now + intervalDays * DAY_MS : null,
+    pending: enabled && current.pending
+  })
+}
+
+/** "Next time", and the first half of "Review now" (on the strip or in
+ *  Maintenance): the reminder leaves the screen and no checkup is recorded. The
+ *  clock moved when it was shown; one answered before it ever was starts it now. */
+export function dismissMemoryCheckupReminder(now = Date.now()): void {
+  const scope = memoryCheckupScope()
+  const current = readReminder(scope, now)
+
+  if (current.pending && current.dueAt !== null) {
+    const dueAt = now >= current.dueAt ? now + current.intervalDays * DAY_MS : current.dueAt
+
+    save(scope, { ...current, dueAt, pending: false })
+  }
+}
+
+/** Rename counterpart (local connection only, like the tiles it joins). */
+export function migrateMemoryCheckupReminder(from: string, to: string): void {
+  const stored = readJson<unknown>(KEY_PREFIX + checkupScopeFor(LOCAL_CONNECTION_ID, from))
+
+  writeJson(KEY_PREFIX + checkupScopeFor(LOCAL_CONNECTION_ID, to), stored)
+  writeJson(KEY_PREFIX + checkupScopeFor(LOCAL_CONNECTION_ID, from), null)
+}
+
+/** A deleted profile's clock, so a later profile of the same name starts without one. */
+export function dropMemoryCheckupReminder(profile: string, connectionId?: string): void {
+  writeJson(KEY_PREFIX + checkupScopeFor(connectionId ?? $apiRequestScope.get().connectionId, profile), null)
+}
+
+let stop: (() => void) | null = null
+
+/** Wire the reminder to gateway/profile state. Idempotent. */
+export function startMemoryCheckupReminder(): void {
+  if (stop || typeof window === 'undefined') {
+    return
+  }
+
+  let timer: null | ReturnType<typeof setInterval> = null
+
+  const disarm = () => {
+    if (timer !== null) {
+      clearInterval(timer)
+      timer = null
+    }
+  }
+
+  // Only while the gateway is connected: before that the profile in view is
+  // not known, and the wrong profile's reminder would be raised.
+  const arm = () => {
+    disarm()
+
+    if ($gatewayState.get() === 'open') {
+      checkMemoryCheckupDue()
+      timer = setInterval(() => checkMemoryCheckupDue(), CHECK_INTERVAL_MS)
+    } else {
+      show(OFF)
+    }
+  }
+
+  // Another window answered or changed it: show what is stored, move nothing.
+  const onStorage = (event: StorageEvent) => {
+    if (event.key === KEY_PREFIX + memoryCheckupScope() && $gatewayState.get() === 'open') {
+      show(readReminder(memoryCheckupScope()))
+    }
+  }
+
+  let observedConnection = $apiRequestScope.get().connectionId
+
+  const offs = [
+    $gatewayState.subscribe(arm),
+    $activeGatewayProfile.listen(arm),
+    $apiRequestScope.listen(({ connectionId }) => {
+      if (connectionId !== observedConnection) {
+        observedConnection = connectionId
+        arm()
+      }
+    })
+  ]
+
+  window.addEventListener('storage', onStorage)
+
+  stop = () => {
+    disarm()
+    offs.forEach(off => off())
+    window.removeEventListener('storage', onStorage)
+    stop = null
+  }
+}
+
+export function stopMemoryCheckupReminder(): void {
+  stop?.()
+}
