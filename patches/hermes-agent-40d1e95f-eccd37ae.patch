@@ -0,0 +1,79 @@
+import { Button } from '@/components/ui/button'
+import { useI18n } from '@/i18n'
+import type { ProviderJob } from '@/types/provider-jobs'
+
+import type { useProviderJobs } from './use-provider-jobs'
+
+type JobState = Pick<ReturnType<typeof useProviderJobs>, 'output' | 'running' | 'start' | 'status' | 'tail'>
+
+interface Props {
+  /** The surface is saving: nothing starts or applies meanwhile. */
+  disabled?: boolean
+  job: ProviderJob
+  state: JobState
+}
+
+/** Run, for a job bound to a settings field (a threshold calibration, say): it sits beside that field's control. */
+export function FieldJobButton({ disabled = false, job, state }: Props) {
+  const { t } = useI18n()
+
+  return (
+    <Button
+      disabled={!job.ready || state.running || disabled}
+      onClick={() => void state.start(job)}
+      size="xs"
+      type="button"
+      variant="textStrong"
+    >
+      {state.running && state.tail?.id === job.id ? t.settings.memoryLayers.jobs.running : job.label}
+    </Button>
+  )
+}
+
+/**
+ * The job's line under its field: its last output while it runs, how it failed, else where it stands (the basis of a
+ * suggestion included), and the suggestion itself until the user confirms it.
+ */
+export function FieldJobNote({
+  current,
+  disabled = false,
+  job,
+  onApply,
+  state
+}: Props & { /** The field's saved value, to set against the suggestion. */ current: string; onApply: (value: string) => void }) {
+  const { t } = useI18n()
+  const copy = t.settings.memoryLayers.providerConfig
+  const j = t.settings.memoryLayers.jobs
+  const followed = state.tail?.id === job.id
+  const busy = followed && state.running
+  const lastLine = state.output?.split(/\r?\n/).pop() ?? ''
+
+  return (
+    <div
+      className="mt-2 text-[length:var(--conversation-caption-font-size)] text-(--ui-text-tertiary)"
+      data-testid="field-job"
+    >
+      <p className="whitespace-pre-line" data-selectable-text="true" role="status">
+        {busy
+          ? lastLine || j.running
+          : followed && state.status && state.status.exit_code !== 0
+            ? `${j.failed(state.status.exit_code)} ${lastLine}`
+            : job.status || job.description}
+      </p>
+      {job.suggestion && !busy && (
+        <div className="mt-1 flex flex-wrap items-center gap-2 text-foreground">
+          <span>{copy.suggestion(current, job.suggestion)}</span>
+          <Button
+            disabled={disabled}
+            onClick={() => onApply(job.suggestion ?? '')}
+            size="xs"
+            type="button"
+            variant="textStrong"
+          >
+            {copy.applySuggestion}
+          </Button>
+        </div>
+      )}
+    </div>
+  )
+}
