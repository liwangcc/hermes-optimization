diff --git a/tests/hermes_cli/test_memory_actions.py b/tests/hermes_cli/test_memory_actions.py
new file mode 100644
index 0000000000000000000000000000000000000000..e912661d6c8d08d49fab7b179872321ec85c7fc6
--- /dev/null
+++ b/tests/hermes_cli/test_memory_actions.py
@@ -0,0 +1,220 @@
+"""Memory provider maintenance jobs, against a real temp ``HERMES_HOME`` and a synthetic provider plugin loaded
+through real discovery: ``GET/POST /api/memory/actions`` and ``hermes memory action`` run in-process."""
+
+import json
+from argparse import Namespace
+from types import SimpleNamespace
+
+import hermes_yaml as yaml
+import pytest
+
+from hermes_cli import plugins as plugins_mod
+
+_JOBPROV = '''
+import json
+from pathlib import Path
+
+from agent.memory_provider import MemoryProvider
+
+
+class JobProv(MemoryProvider):
+    """Items in <hermes_home>/jobprov.json; the "index" job copies them two per step into jobprov.index.json."""
+
+    @property
+    def name(self):
+        return "jobprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        pass
+
+    def get_tool_schemas(self):
+        return []
+
+    def _paths(self, home):
+        return Path(home, "jobprov.json"), Path(home, "jobprov.index.json")
+
+    def _state(self, home):
+        data, index = self._paths(home)
+        items = json.loads(data.read_text(encoding="utf-8"))
+        done = json.loads(index.read_text(encoding="utf-8")) if index.exists() else []
+        return items, done
+
+    def maintenance_actions(self, hermes_home):
+        items, done = self._state(hermes_home)
+        if "listing breaks" in items:
+            raise RuntimeError("store is locked")
+        return [
+            {"id": "index", "label": "Build index", "description": "Index every item.",
+             "status": f"{len(done)} of {len(items)} items indexed", "ready": True},
+            {"id": "broken", "label": "Broken", "status": "", "ready": True},
+            {"id": "stuck", "label": "Stuck", "status": "", "ready": True},
+            {"id": "later", "label": "Later", "status": "The index server is not running.", "ready": False},
+            {"id": "../evil", "label": "not a job id"},
+            "not a job",
+        ]
+
+    def run_maintenance_step(self, action_id, hermes_home):
+        items, done = self._state(hermes_home)
+        if action_id == "broken":
+            raise RuntimeError("the index server refused the batch")
+        if action_id == "stuck":
+            return {"done": False, "status": "waiting"}
+        done = items[: len(done) + 2]
+        self._paths(hermes_home)[1].write_text(json.dumps(done), encoding="utf-8")
+        status = f"{len(done)} of {len(items)} items indexed"
+        if len(done) == len(items):
+            return {"done": True, "status": status, "result": f"All {len(items)} items are indexed."}
+        return {"done": False, "status": status}
+
+
+def register(ctx):
+    ctx.register_memory_provider(JobProv())
+'''
+
+_PLAINPROV = '''
+from agent.memory_provider import MemoryProvider
+
+
+class PlainProv(MemoryProvider):
+    @property
+    def name(self):
+        return "plainprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        pass
+
+    def get_tool_schemas(self):
+        return []
+
+
+def register(ctx):
+    ctx.register_memory_provider(PlainProv())
+'''
+
+
+def _write_home(home, *, provider="jobprov", items=("a", "b", "c", "d", "e")):
+    for name, source in (("jobprov", _JOBPROV), ("plainprov", _PLAINPROV)):
+        (home / "plugins" / name).mkdir(parents=True, exist_ok=True)
+        (home / "plugins" / name / "__init__.py").write_text(source, encoding="utf-8")
+    (home / "jobprov.json").write_text(json.dumps(list(items)), encoding="utf-8")
+    (home / "config.yaml").write_text(yaml.safe_dump({"memory": {"provider": provider}}), encoding="utf-8")
+
+
+@pytest.fixture
+def home(_isolate_hermes_home):
+    from hermes_constants import get_hermes_home
+
+    plugins_mod._reset_plugin_managers_for_tests()
+    yield get_hermes_home()
+    plugins_mod._reset_plugin_managers_for_tests()
+
+
+@pytest.fixture
+def client(home):
+    from starlette.testclient import TestClient
+    from hermes_cli.web_server import _SESSION_HEADER_NAME, _SESSION_TOKEN, app
+
+    return TestClient(app, headers={_SESSION_HEADER_NAME: _SESSION_TOKEN})
+
+
+@pytest.fixture
+def spawned(monkeypatch):
+    """What would have been started: argv and action name, instead of a real process."""
+    calls = []
+
+    def fake(argv, name, **_):
+        calls.append((argv, name))
+        return SimpleNamespace(pid=4242, poll=lambda: 0)
+
+    monkeypatch.setattr("hermes_cli.web_server_gateway._spawn_hermes_action", fake)
+    return calls
+
+
+def _run(action_id, capsys):
+    from hermes_cli.memory_actions import cmd_memory_action
+
+    with pytest.raises(SystemExit) as stop:
+        cmd_memory_action(Namespace(action_id=action_id))
+    return stop.value.code, capsys.readouterr().out.splitlines()
+
+
+def test_lists_only_well_formed_jobs_with_where_each_stands(home, client):
+    _write_home(home)
+    data = client.get("/api/memory/actions").json()
+    assert data["provider"] == "jobprov" and data["state"] == "ok"
+    assert [a["id"] for a in data["actions"]] == ["index", "broken", "stuck", "later"]  # bad ids and non-dicts dropped
+    assert data["actions"][0] == {"id": "index", "label": "Build index", "description": "Index every item.",
+                                  "status": "0 of 5 items indexed", "ready": True}
+    assert data["actions"][3]["ready"] is False
+
+
+@pytest.mark.parametrize("provider, items, state", [
+    ("", ("a",), "disabled"),  # no provider: no jobs
+    ("plainprov", ("a",), "unsupported"),  # a provider without jobs
+    ("no-such-provider", ("a",), "unavailable"),  # configured but not loadable
+    ("jobprov", ("listing breaks",), "unavailable"),  # its listing raised
+])
+def test_no_jobs_says_why(home, client, provider, items, state):
+    _write_home(home, provider=provider, items=items)
+    assert client.get("/api/memory/actions").json() == {"provider": provider, "state": state, "actions": []}
+
+
+def test_starting_a_job_spawns_it_for_the_profile_and_refuses_what_cannot_run(home, client, spawned):
+    _write_home(home)
+    response = client.post("/api/memory/actions", json={"action": "index"})
+    assert response.status_code == 200, response.text
+    assert response.json()["name"] == "memory-action"
+    [(argv, name)] = spawned
+    assert argv[-3:] == ["memory", "action", "index"] and name == "memory-action"
+
+    assert client.post("/api/memory/actions", json={"action": "../evil"}).status_code == 400
+    assert client.post("/api/memory/actions", json={"action": "nope"}).status_code == 404
+    later = client.post("/api/memory/actions", json={"action": "later"})
+    assert later.status_code == 409 and "not running" in later.json()["detail"]
+    assert len(spawned) == 1  # nothing else was started
+
+
+def test_a_job_already_running_is_not_started_twice(home, client, spawned, monkeypatch):
+    import hermes_cli.web_server_gateway as gateway
+
+    _write_home(home)
+    monkeypatch.setitem(gateway._ACTION_PROCS, "memory-action", SimpleNamespace(poll=lambda: None))
+    assert client.post("/api/memory/actions", json={"action": "index"}).status_code == 409
+    assert spawned == []
+
+
+def test_the_cli_runs_a_job_step_by_step_to_the_end(home, capsys):
+    _write_home(home)
+    code, out = _run("index", capsys)
+    assert code == 0
+    assert out == ["Build index: 0 of 5 items indexed", "2 of 5 items indexed", "4 of 5 items indexed",
+                   "5 of 5 items indexed", "All 5 items are indexed."]
+    assert json.loads((home / "jobprov.index.json").read_text(encoding="utf-8")) == ["a", "b", "c", "d", "e"]
+
+
+@pytest.mark.parametrize("action, code, last", [
+    ("broken", 1, "Failed: the index server refused the batch"),
+    ("stuck", 1, "Stopped: 20 steps in a row changed nothing (waiting)."),
+    ("later", 1, "Later cannot run yet: The index server is not running."),
+    ("nope", 2, "jobprov offers no job 'nope'."),
+])
+def test_the_cli_ends_a_job_that_cannot_finish_with_a_reason(home, capsys, action, code, last):
+    _write_home(home)
+    got, out = _run(action, capsys)
+    assert (got, out[-1]) == (code, last)
+
+
+def test_the_cli_lists_jobs_without_running_one(home, capsys):
+    from hermes_cli.memory_actions import cmd_memory_action
+
+    _write_home(home)
+    cmd_memory_action(Namespace(action_id=None))
+    out = capsys.readouterr().out
+    assert "index: Build index — 0 of 5 items indexed" in out and "later: Later (not ready)" in out
+    assert not (home / "jobprov.index.json").exists()
diff --git a/tests/hermes_cli/test_web_memory_checkup.py b/tests/hermes_cli/test_web_memory_checkup.py
new file mode 100644
index 0000000000000000000000000000000000000000..c018d22ea689aceaa99ec7d1443e180c3760691e
--- /dev/null
+++ b/tests/hermes_cli/test_web_memory_checkup.py
@@ -0,0 +1,278 @@
+"""``POST /api/memory/checkup``, against a real temp ``HERMES_HOME``: synthetic MEMORY.md / USER.md, a synthetic
+provider plugin, and a model that is a function in this file.
+
+The checkup must only read. Each test that runs it compares every memory file before and after."""
+
+import hashlib
+import json
+from types import SimpleNamespace
+
+import hermes_yaml as yaml
+import pytest
+
+from hermes_cli import plugins as plugins_mod
+
+_CHECKUPPROV = '''
+import json
+import time
+from pathlib import Path
+
+from agent.memory_provider import MemoryProvider
+
+
+class CheckupProv(MemoryProvider):
+    """Reads <hermes_home>/checkupprov.json. A checkup that initialized it or called its tools leaves a mark."""
+
+    @property
+    def name(self):
+        return "checkupprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        Path(kwargs["hermes_home"], "checkupprov.touched").write_text("initialize")
+
+    def get_tool_schemas(self):
+        return [{"name": "checkupprov_write", "description": "d", "parameters": {"type": "object", "properties": {}}}]
+
+    def handle_tool_call(self, tool_name, args, **kwargs):
+        Path(kwargs["hermes_home"], "checkupprov.touched").write_text(tool_name)
+        return "{}"
+
+    def _data(self, hermes_home):
+        data = json.loads(Path(hermes_home, "checkupprov.json").read_text(encoding="utf-8"))
+        if data.get("broken"):
+            raise RuntimeError("store is locked")
+        return data
+
+    def review_items(self, hermes_home):
+        now = time.time()
+        items = self._data(hermes_home).get("items")
+        if items is None:
+            return {}
+        return {"items": [{**i, "created_at": now - i["age_days"] * 86400} for i in items]}
+
+
+def register(ctx):
+    ctx.register_memory_provider(CheckupProv())
+'''
+
+_PLAINPROV = '''
+from agent.memory_provider import MemoryProvider
+
+
+class PlainProv(MemoryProvider):
+    """A provider written before the optional reads existed."""
+
+    @property
+    def name(self):
+        return "plainprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        pass
+
+    def get_tool_schemas(self):
+        return []
+
+
+def register(ctx):
+    ctx.register_memory_provider(PlainProv())
+'''
+
+_ITEMS = [
+    {"id": "7", "text": "The database is Postgres", "age_days": 90, "uses": 0, "score": 0.5},
+    {"id": "8", "text": "The database is PostgreSQL 16", "age_days": 40, "uses": 6, "score": 0.9},
+    {"id": "9", "text": "Trying out a new editor", "age_days": 2, "uses": 0, "score": 0.5},
+    {"id": "10", "text": "Never deploy on Fridays", "age_days": 300, "uses": 0, "score": 0.2, "protected": True},
+]
+
+
+def _write_home(home, *, provider="checkupprov", memory=None, data=None, user="Prefers replies in Chinese\n§\nWorks at Acme",
+                notes="Deploy from the release branch"):
+    (home / "memories").mkdir(parents=True, exist_ok=True)
+    (home / "memories" / "USER.md").write_text(user, encoding="utf-8")
+    (home / "memories" / "MEMORY.md").write_text(notes, encoding="utf-8")
+    for name, source in (("checkupprov", _CHECKUPPROV), ("plainprov", _PLAINPROV)):
+        (home / "plugins" / name).mkdir(parents=True, exist_ok=True)
+        (home / "plugins" / name / "__init__.py").write_text(source, encoding="utf-8")
+    (home / "checkupprov.json").write_text(json.dumps(data if data is not None else {"items": _ITEMS}),
+                                          encoding="utf-8")
+    (home / "config.yaml").write_text(yaml.safe_dump({"memory": {"provider": provider, **(memory or {})}}), encoding="utf-8")
+
+
+def _memory_state(home):
+    """Every byte a checkup could have written: the built-in files, staged writes and the provider's store."""
+    files = sorted(p for root in (home / "memories", home / "pending") if root.exists() for p in root.rglob("*") if p.is_file())
+    files += [p for p in (home / "checkupprov.json", home / "checkupprov.touched") if p.exists()]
+    return {str(p.relative_to(home)): hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
+
+
+class _Model:
+    """The model: what it was asked, and the reply (or the exception) it gives."""
+
+    def __init__(self, monkeypatch):
+        self.calls, self.reply, self.error, self.tool_calls = [], '{"proposals": []}', None, None
+        monkeypatch.setattr("agent.auxiliary_client.call_llm", self)
+
+    def __call__(self, **kwargs):
+        self.calls.append(kwargs)
+        if self.error:
+            raise self.error
+        reply = self.reply(kwargs["messages"]) if callable(self.reply) else self.reply
+        message = SimpleNamespace(content=reply, tool_calls=self.tool_calls)
+        return SimpleNamespace(model="synthetic-model", choices=[SimpleNamespace(message=message)])
+
+    @property
+    def prompt(self):
