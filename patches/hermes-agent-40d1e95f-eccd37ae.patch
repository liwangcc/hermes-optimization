index 0000000000000000000000000000000000000000..37ca04f325b3dbca90c8f6b6c8c6c09526e13ab2
--- /dev/null
+++ b/apps/desktop/src/app/settings/memory/memory-capacity.tsx
@@ -0,0 +1,226 @@
+import { Fragment, type ReactNode } from 'react'
+
+import { Progress } from '@/components/ui/progress'
+import { useI18n } from '@/i18n'
+import type { MemoryCapacityTranslations } from '@/i18n/types_memory_capacity'
+import type {
+  BuiltinMemoryLayer,
+  MemoryBudget,
+  MemoryLayers,
+  MemoryLayerState,
+  ProviderMemoryLayer
+} from '@/types/memory-layers'
+
+import { ListRow, Pill } from '../primitives'
+
+type Capacity = MemoryCapacityTranslations
+
+const STATE_TONE: Record<Exclude<MemoryLayerState, 'ok'>, 'destructive' | 'muted'> = {
+  disabled: 'muted',
+  empty: 'muted',
+  unavailable: 'destructive',
+  unsupported: 'muted'
+}
+
+const count = (value: number) => value.toLocaleString()
+
+export function formatBytes(size: number): string {
+  if (size <= 0) {
+    return ''
+  }
+
+  if (size >= 1024 * 1024) {
+    return `${(size / (1024 * 1024)).toFixed(1)} MB`
+  }
+
+  if (size >= 1024) {
+    return `${(size / 1024).toFixed(1)} KB`
+  }
+
+  return `${size} B`
+}
+
+function StatePill({ c, state }: { c: Capacity; state: Exclude<MemoryLayerState, 'ok'> }) {
+  return <Pill tone={STATE_TONE[state]}>{c.state[state]}</Pill>
+}
+
+/** Used against a limit something enforces. No limit, no bar and no percentage. */
+function Meter({ label, limit, used }: { label: string; limit: number; used: number }) {
+  if (limit <= 0) {
+    return <span className="text-[length:var(--conversation-caption-font-size)]">{label}</span>
+  }
+
+  return (
+    <div className="grid w-full min-w-40 gap-1">
+      <span className="text-[length:var(--conversation-caption-font-size)] text-(--ui-text-secondary)">
+        {label} · {Math.round((used / limit) * 100)}%
+      </span>
+      <Progress aria-label={label} destructive={used > limit} size="sm" value={used / limit} />
+    </div>
+  )
+}
+
+function BuiltinRow({ c, layer, title }: { c: Capacity; layer: BuiltinMemoryLayer; title: string }) {
+  const description: Record<MemoryLayerState, ReactNode> = {
+    ok: c.entries(layer.entries),
+    disabled: layer.entries > 0 ? `${c.disabledDesc} ${c.entries(layer.entries)}.` : c.disabledDesc,
+    empty: c.emptyDesc,
+    unavailable: c.unavailableDesc,
+    unsupported: c.unavailableDesc
+  }
+
+  return (
+    <ListRow
+      action={
+        layer.state === 'ok' ? (
+          <Meter label={c.chars(count(layer.chars), count(layer.char_limit))} limit={layer.char_limit} used={layer.chars} />
+        ) : (
+          <StatePill c={c} state={layer.state} />
+        )
+      }
+      description={description[layer.state]}
+      title={<span className="font-mono">{title}</span>}
+    />
+  )
+}
+
+/** How much of a provider's budget is used, or that it is switched off. */
+function BudgetUse({ budget, c }: { budget: MemoryBudget; c: Capacity }) {
+  return budget.enabled ? (
+    <Meter
+      label={c.budgetUsed(count(budget.used), count(budget.limit), budget.unit ?? '')}
+      limit={budget.limit}
+      used={budget.used}
+    />
+  ) : (
+    <StatePill c={c} state="disabled" />
+  )
+}
+
+/** What the budget holds, in words: how many items fit, that the count is the provider's estimate, its own note. */
+function budgetText(budget: MemoryBudget, c: Capacity): string | undefined {
+  if (!budget.enabled) {
+    return undefined
+  }
+
+  const listed =
+    budget.listed !== undefined && budget.eligible !== undefined
+      ? `${c.budgetListed(count(budget.listed), count(budget.eligible))}. `
+      : ''
+
+  return `${listed}${c.budgetNote}${budget.note ? ` ${budget.note}` : ''}`
+}
+
+function BudgetRow({ budget, c }: { budget: MemoryBudget; c: Capacity }) {
+  return (
+    <ListRow
+      action={<BudgetUse budget={budget} c={c} />}
+      description={budgetText(budget, c)}
+      title={budget.label ?? budget.key ?? ''}
+    />
+  )
+}
+
+/** A budget bound to a settings field, under that field in the provider's settings: the limit is edited there, so
+ *  its use is shown there too, once. */
+export function FieldBudget({ budget }: { budget: MemoryBudget }) {
+  const { t } = useI18n()
+  const c = t.memoryCapacity
+  const text = budgetText(budget, c)
+
+  return (
+    <div className="mt-2 grid gap-1" data-testid="field-budget">
+      <BudgetUse budget={budget} c={c} />
+      {text && (
+        <p className="text-[length:var(--conversation-caption-font-size)] text-(--ui-text-tertiary)">{text}</p>
+      )}
+    </div>
+  )
+}
+
+const FILES = { memory: 'MEMORY.md', user: 'USER.md' } as const
+
+/** The built-in files a budget's text makes optional: only one that is on and holds something. */
+function overlapped(budget: MemoryBudget, layers: MemoryLayers): (keyof typeof FILES)[] {
+  return budget.enabled ? (budget.overlaps ?? []).filter(name => layers[name].state === 'ok') : []
+}
+
+/** A suggestion, never a change: nothing is switched off here, and both can stay on. What each costs in every
+ *  session is on screen: the budget's own row above, and the file's estimate here. */
+function OverlapRow({ budget, c, layer, name }: { budget: MemoryBudget; c: Capacity; layer: BuiltinMemoryLayer; name: keyof typeof FILES }) {
+  const label = budget.label ?? budget.key ?? ''
+  const tokens = layer.tokens !== undefined ? count(layer.tokens) : undefined
+
+  return (
+    <ListRow
+      description={c.overlapDesc(label, FILES[name], tokens)}
+      title={c.overlapTitle(FILES[name], label)}
+    />
+  )
+}
+
+function ProviderRow({ c, layer }: { c: Capacity; layer: ProviderMemoryLayer }) {
+  const description: Record<MemoryLayerState, string> = {
+    ok: c.factStoreDesc,
+    disabled: c.noProviderDesc,
+    empty: c.providerEmptyDesc(layer.name),
+    unavailable: c.providerUnavailableDesc(layer.name),
+    unsupported: c.providerUnsupportedDesc(layer.name)
+  }
+
+  const reported = [
+    layer.items !== undefined ? c.facts(count(layer.items)) : '',
+    // A size, never a fill level: the store has no ceiling to measure it against.
+    layer.storage_bytes !== undefined ? formatBytes(layer.storage_bytes) : ''
+  ].filter(Boolean)
+
+  return (
+    <ListRow
+      action={
+        layer.state === 'ok' ? (
+          <span className="text-[length:var(--conversation-caption-font-size)] text-(--ui-text-secondary)">
+            {reported.join(' · ')}
+          </span>
+        ) : (
+          <StatePill c={c} state={layer.state} />
+        )
+      }
+      description={description[layer.state]}
+      title={c.factStore}
+    />
+  )
+}
+
+/** How much each memory layer carries: USER.md and MEMORY.md against their
+ *  character caps, the provider's store as a count and a size, and any budget
+ *  the provider enforces. `layers` is undefined on a backend that predates the
+ *  report, which reads as not reported rather than as empty. `boundBelow`: the provider's settings follow on
+ *  this page and show a budget bound to one of their fields beside it, so it is not repeated here. */
+export function MemoryCapacity({ boundBelow = false, layers }: { boundBelow?: boolean; layers: MemoryLayers | undefined }) {
+  const { t } = useI18n()
+  const c = t.memoryCapacity
+
+  if (!layers) {
+    return (
+      <div data-testid="memory-capacity">
+        <ListRow action={<StatePill c={c} state="unsupported" />} description={c.olderBackendDesc} title={c.usage} />
+      </div>
+    )
+  }
+
+  return (
+    <div className="grid gap-1" data-testid="memory-capacity">
+      <BuiltinRow c={c} layer={layers.user} title="USER.md" />
+      <BuiltinRow c={c} layer={layers.memory} title="MEMORY.md" />
+      <ProviderRow c={c} layer={layers.provider} />
+      {(layers.provider.budgets ?? []).map((budget, index) => (
+        <Fragment key={budget.key ?? index}>
+          {boundBelow && budget.field ? null : <BudgetRow budget={budget} c={c} />}
+          {overlapped(budget, layers).map(name => (
+            <OverlapRow budget={budget} c={c} key={name} layer={layers[name]} name={name} />
+          ))}
+        </Fragment>
+      ))}
+    </div>
+  )
+}
