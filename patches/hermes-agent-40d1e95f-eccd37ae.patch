+        ``options`` (``[{"id", "label", "description"}]``: the user picks one before running; ``selected`` names the
+        one in use) and ``field`` (a config field key the job proposes a value for: the Desktop shows the job beside
+        that field) with ``suggestion`` (that value once a run produced one, written only when the user confirms;
+        ``status`` says what it rests on)."""
+        return []
+
+    def run_maintenance_step(self, action_id: str, hermes_home: str) -> dict[str, Any]:
