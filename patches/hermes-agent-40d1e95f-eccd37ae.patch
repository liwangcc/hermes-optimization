diff --git a/apps/desktop/src/types/memory-checkup.ts b/apps/desktop/src/types/memory-checkup.ts
new file mode 100644
index 0000000000000000000000000000000000000000..522a63b10a35b0cb8c8d9a158c5f82b196d3a455
