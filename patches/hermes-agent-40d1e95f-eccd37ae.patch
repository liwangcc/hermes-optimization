+import { useMemo, useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { SegmentedControl } from '@/components/ui/segmented-control'
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select'
+import { useI18n } from '@/i18n'
+import type { MemoryProviderConfig } from '@/types/hermes'
+import type { ProviderJob } from '@/types/provider-jobs'
+
+import { CONTROL_TEXT } from '../constants'
+import { ListRow, Pill } from '../primitives'
+
+import { ProviderConnectionForm } from './provider-connection-form'
+import type { useProviderJobs } from './use-provider-jobs'
+
+const CAPTION = 'text-[length:var(--conversation-caption-font-size)] text-(--ui-text-tertiary)'
+const HEADING = 'mt-3 text-[0.625rem] font-medium uppercase tracking-[0.08em] text-(--ui-text-tertiary)'
+
+type Mode = 'cloud' | 'local'
+
+/**
+ * The provider's connection and one-click jobs, above its settings: the model is chosen first, and what depends on
+ * it (a threshold, an index) follows. The connection is a Cloud | Local choice: each
+ * side shows its own form, and the mode in effect is marked. A job shows where it stands, Run, its output while it
+ * runs and how it ended; it runs in a process of its own, so leaving the page does not stop it. Nothing shows for a
+ * provider without jobs or on a Hermes older than the route.
+ */
+interface Props {
+  config?: MemoryProviderConfig
+  onConnected?: () => void
+  profile?: string
+  provider: string
+  /** The panel's one view of the jobs: its field rows show the jobs bound to them from the same state. */
+  state: ReturnType<typeof useProviderJobs>
+}
+
+export function ProviderJobs({ config, onConnected, profile, provider, state }: Props) {
+  const { t } = useI18n()
+  const j = t.settings.memoryLayers.jobs
+  const copy = t.settings.memoryLayers.connection
+  const connection = config?.connection
+  const setupJob = connection?.job
+
+  const fields = useMemo(
+    () => config?.fields.filter(field => config.connection?.fields.includes(field.key)) ?? [],
+    [config]
+  )
+
+  const { jobs, output, refresh, running, start, status, tail } = state
+
+  // The side being looked at; until the user picks one, the mode in effect.
+  const [picked, setPicked] = useState<Mode | null>(null)
+  const [choices, setChoices] = useState<Record<string, string>>({})
+
+  if (!connection && jobs.length === 0 && !tail) {
+    return null
+  }
+
+  const active = connection?.state === 'cloud' || connection?.state === 'local' ? connection.state : null
+  const sides: Mode[] = [...(fields.length > 0 ? ['cloud' as const] : []), ...(setupJob ? ['local' as const] : [])]
+  const shown = picked && sides.includes(picked) ? picked : active && sides.includes(active) ? active : sides[0]
+  const setup = jobs.find(job => job.id === setupJob)
+  // A job bound to a settings field shows beside that field, not in this list.
+  const maintenance = jobs.filter(job => job.id !== setupJob && !config?.fields.some(field => field.key === job.field))
+
+  const runButton = (job: ProviderJob, label: string, option?: string) => (
+    <Button
+      disabled={!job.ready || running}
+      onClick={() => void start(job, option)}
+      size="xs"
+      type="button"
+      variant="textStrong"
+    >
+      {running && tail?.id === job.id ? j.running : label}
+    </Button>
+  )
+
+  const jobText = (job: ProviderJob) => (
+    <>
+      {job.description}
+      {job.status && <span className={`block ${CAPTION}`}>{job.status}</span>}
+    </>
+  )
+
+  const setupRow = (job: ProviderJob) => {
+    const option = job.options?.find(entry => entry.id === (choices[job.id] ?? job.selected)) ?? job.options?.[0]
+
+    return (
+      <ListRow
+        action={
+          <>
+            {job.options && option && (
+              <Select
+                disabled={running}
+                onValueChange={id => setChoices(current => ({ ...current, [job.id]: id }))}
+                value={option.id}
+              >
+                <SelectTrigger aria-label={job.label} className={CONTROL_TEXT}>
+                  <SelectValue />
+                </SelectTrigger>
+                <SelectContent>
+                  {job.options.map(entry => (
+                    <SelectItem key={entry.id} value={entry.id}>
+                      {entry.label}
+                    </SelectItem>
+                  ))}
+                </SelectContent>
+              </Select>
+            )}
+            {runButton(job, copy.deploy, option?.id)}
+          </>
+        }
+        below={
+          option?.description && (
+            <p className={`mt-1 whitespace-pre-line ${CAPTION}`} data-selectable-text="true" data-testid="job-option">
+              {option.description}
+            </p>
+          )
+        }
+        description={jobText(job)}
+        title={job.label}
+      />
+    )
+  }
+
+  return (
+    <div data-testid="provider-jobs">
+      {connection && (
+        <section aria-label={copy.title} data-testid="provider-connection">
+          <div className={HEADING}>{copy.title}</div>
+          <div className="mt-2 flex flex-wrap items-center gap-2">
+            {sides.length > 1 && (
+              <SegmentedControl
+                onChange={setPicked}
+                options={[
+                  { id: 'cloud', label: copy.cloud },
+                  { id: 'local', label: copy.local }
+                ]}
+                value={shown}
+              />
+            )}
+            <Pill data-testid="connection-active" tone={active ? 'primary' : 'muted'}>
+              {active === 'cloud' ? copy.cloudSelected : active === 'local' ? copy.localSelected : copy.noneSelected}
+            </Pill>
+          </div>
+          {shown === 'cloud' && (
+            <ProviderConnectionForm
+              disabled={running}
+              fields={fields}
+              // The stored connection changed (a connect, a deployment): start again from it.
+              key={fields.map(field => field.value).join('\n')}
+              onConnected={() => {
+                void refresh()
+                onConnected?.()
+              }}
+              profile={profile}
+              provider={provider}
+            />
+          )}
+          {shown === 'local' && setup && setupRow(setup)}
+        </section>
+      )}
+      {maintenance.length > 0 && <div className={HEADING}>{j.title}</div>}
+      {maintenance.map(job => (
+        <ListRow action={runButton(job, j.run)} description={jobText(job)} key={job.id} title={job.label} />
+      ))}
+      {tail && status && (
+        <div className="mt-2" data-testid="provider-job-output">
+          <div className={CAPTION} role="status">
+            {status.running ? j.running : status.exit_code === 0 ? j.finished : j.failed(status.exit_code)}
+          </div>
+          <pre
+            className="mt-1 max-h-48 overflow-auto whitespace-pre-wrap wrap-break-word rounded-lg border border-(--ui-stroke-tertiary) bg-(--ui-bg-quinary) p-3 font-mono text-[0.65rem] leading-relaxed text-(--ui-text-tertiary)"
+            data-selectable-text="true"
+          >
+            {output}
+          </pre>
+        </div>
+      )}
+    </div>
+  )
+}
diff --git a/apps/desktop/src/app/settings/memory/use-provider-jobs.ts b/apps/desktop/src/app/settings/memory/use-provider-jobs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..43c28ae024898c2cc7da1ef04e67a1abe8ab25fb
--- /dev/null
+++ b/apps/desktop/src/app/settings/memory/use-provider-jobs.ts
@@ -0,0 +1,145 @@
+import { useCallback, useEffect, useState } from 'react'
+
+import { getMemoryJobs, getMemoryJobStatus, MEMORY_JOB_ACTION, runMemoryJob } from '@/api/memory-jobs'
+import { getActionStatus } from '@/api/system'
+import { useI18n } from '@/i18n'
+import { notifyError } from '@/store/notifications'
+import type { ActionStatusResponse } from '@/types/hermes'
+import type { ProviderJob } from '@/types/provider-jobs'
+
+const POLL_MS = 1200
+const LOG_LINES = 200
+
+interface Options {
+  /** False while the surface is closed: nothing is listed or followed. */
+  enabled?: boolean
+  /** The setup job ended well: the connection it made is saved. */
+  onSetupDone?: () => void
+  profile?: null | string
+  provider: string
+  setupJob?: string
+}
+
+/**
+ * The provider's jobs and the one being followed: list them, start one, tail its output until it ends, then list
+ * them again. A job runs in a process of its own, so leaving the page does not stop it.
+ */
+export function useProviderJobs({ enabled = true, onSetupDone, profile, provider, setupJob }: Options) {
+  const { t } = useI18n()
+  const j = t.settings.memoryLayers.jobs
+  const [jobs, setJobs] = useState<ProviderJob[]>([])
+  const [starting, setStarting] = useState(false)
+  // A fresh object per launch: the backend reuses one action name, so a bare id would not restart the tail.
+  const [tail, setTail] = useState<null | { id: string }>(null)
+  const [status, setStatus] = useState<ActionStatusResponse | null>(null)
+
+  const refresh = useCallback(async () => {
+    try {
+      const next = await getMemoryJobs(profile)
+      setJobs(next.state === 'ok' && next.provider === provider ? next.actions : [])
+    } catch {
+      setJobs([]) // an older Hermes (no route) or a backend hiccup: the settings above stay usable
+    }
+  }, [profile, provider])
+
+  useEffect(() => {
+    if (enabled) {
+      void refresh()
+    }
+  }, [enabled, refresh])
+
+  useEffect(() => {
+    if (!enabled || !setupJob) {
+      return
+    }
+
+    let cancelled = false
+
+    // Leaving Settings does not interrupt a model download. Reattach on return.
+    void getMemoryJobStatus(profile)
+      .then(next => {
+        if (!cancelled && next.running) {
+          setTail(current => current ?? { id: next.job })
+        }
+      })
+      .catch(() => {})
+
+    return () => {
+      cancelled = true
+    }
+  }, [enabled, profile, setupJob])
+
+  // Follow the job's output until it ends, then read where every job stands now.
+  useEffect(() => {
+    if (!tail) {
+      return
+    }
+
+    let cancelled = false
+    let timer: null | number = null
+
+    const poll = async () => {
+      try {
+        const next = setupJob ? await getMemoryJobStatus(profile) : await getActionStatus(MEMORY_JOB_ACTION, LOG_LINES, profile)
+
+        if (cancelled) {
+          return
+        }
+
+        setStatus(next)
+
+        if (next.running) {
+          timer = window.setTimeout(() => void poll(), POLL_MS)
+        } else {
+          void refresh()
+
+          if (next.exit_code === 0 && tail.id === setupJob) {
+            onSetupDone?.()
+          }
+        }
+      } catch {
+        // The status route hiccuped: stop following; the job itself keeps running.
+      }
+    }
+
+    void poll()
+
+    return () => {
+      cancelled = true
+
+      if (timer !== null) {
+        window.clearTimeout(timer)
+      }
+    }
+  }, [tail, profile, refresh, setupJob, onSetupDone])
+
+  const start = async (job: ProviderJob, option?: string) => {
+    setStarting(true)
+
+    try {
+      await (option ? runMemoryJob(job.id, profile, option) : runMemoryJob(job.id, profile))
+      setStatus(null)
+      setTail({ id: job.id })
+    } catch (err) {
+      notifyError(err, j.startFailed(job.label))
+    } finally {
+      setStarting(false)
+    }
+  }
+
+  // The action log uses a header to mark run boundaries. The provider's output is what follows it.
+  const output = status?.lines
+    .filter(line => !line.startsWith(`=== ${MEMORY_JOB_ACTION} started `))
+    .join('\n')
+    .trimStart()
+
+  return {
+    jobs,
+    output,
+    refresh,
+    running: starting || (tail !== null && (status === null || status.running)),
+    start,
+    status,
+    tail
+  }
+}
diff --git a/apps/desktop/src/components/memory-checkup/reminder-strip.test.tsx b/apps/desktop/src/components/memory-checkup/reminder-strip.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3d85e6231c273e365a2ae78b0189413ef30f61b2
--- /dev/null
+++ b/apps/desktop/src/components/memory-checkup/reminder-strip.test.tsx
@@ -0,0 +1,98 @@
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type * as SystemApi from '@/api/system'
+import { runMemoryCheckup } from '@/api/system'
+import { $routeRequest } from '@/store/recovery-requests'
+import type { MemoryCheckupLayer, MemoryCheckupResponse } from '@/types/memory-checkup'
+
+vi.mock('@/api/system', async importOriginal => ({
+  ...(await importOriginal<typeof SystemApi>()),
+  runMemoryCheckup: vi.fn()
+}))
+
+const { $memoryCheckupRun, clearMemoryCheckupRun } = await import('@/store/memory-checkup')
+
+const { $memoryCheckupReminder, checkMemoryCheckupDue, setMemoryCheckupReminder } = await import(
+  '@/store/memory-checkup-reminder'
+)
+
+const { MemoryCheckupReminderStrip } = await import('./reminder-strip')
+
+const DAY = 24 * 60 * 60 * 1000
+
+const empty: MemoryCheckupLayer = { state: 'empty', total: 0, reviewed: 0, changes: [], needs_evidence: [], keep: [] }
+const done: MemoryCheckupResponse = { model: '', generated_at: 1, dropped: 0, layers: { user: empty, memory: empty, facts: empty } }
+
+const dueReminder = () =>
+  act(() => {
+    setMemoryCheckupReminder({ enabled: true }, Date.now() - 15 * DAY)
+    checkMemoryCheckupDue()
+  })
+
+beforeEach(() => {
+  window.localStorage.clear()
+  vi.mocked(runMemoryCheckup).mockReset()
+  act(() => {
+    clearMemoryCheckupRun()
+    checkMemoryCheckupDue()
+  })
+})
+
+afterEach(cleanup)
+
+describe('memory checkup reminder strip', () => {
+  it('starts the next interval once it has been on screen, and showing it again changes nothing', () => {
+    vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout'] })
+
+    try {
+      dueReminder()
+
+      const past = $memoryCheckupReminder.get().dueAt!
+
+      // A strip that only flashed (another offer took the slot back) has not been shown.
+      render(<MemoryCheckupReminderStrip />)
+      vi.advanceTimersByTime(200)
+      cleanup()
+      vi.advanceTimersByTime(5000)
+      expect($memoryCheckupReminder.get().dueAt).toBe(past)
+
+      render(<MemoryCheckupReminderStrip />)
+      act(() => void vi.advanceTimersByTime(1000))
+
+      const due = $memoryCheckupReminder.get().dueAt!
+
+      expect(due - Date.now()).toBeGreaterThan(13 * DAY)
+      cleanup()
+      render(<MemoryCheckupReminderStrip />)
+      act(() => void vi.advanceTimersByTime(5000))
+      expect($memoryCheckupReminder.get()).toMatchObject({ dueAt: due, pending: true })
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+
+  it('"Next time" dismisses it without running a model or recording a checkup', () => {
+    dueReminder()
+    render(<MemoryCheckupReminderStrip />)
+
+    fireEvent.click(screen.getByRole('button', { name: 'Next time' }))
+
+    expect($memoryCheckupReminder.get().pending).toBe(false)
+    expect(runMemoryCheckup).not.toHaveBeenCalled()
+    expect($memoryCheckupRun.get()).toEqual({ status: 'idle' })
+  })
+
+  it('"Review now" starts the one checkup and opens the panel that shows it', async () => {
+    vi.mocked(runMemoryCheckup).mockResolvedValue(done)
+    dueReminder()
+    render(<MemoryCheckupReminderStrip />)
+
+    fireEvent.click(screen.getByRole('button', { name: 'Review now' }))
+
+    expect($memoryCheckupReminder.get().pending).toBe(false)
+    expect($routeRequest.get()?.path).toBe('/command-center?section=maintenance')
+    await waitFor(() => expect($memoryCheckupRun.get().status).toBe('done'))
+    expect(runMemoryCheckup).toHaveBeenCalledTimes(1)
+  })
+})
diff --git a/apps/desktop/src/components/memory-checkup/reminder-strip.tsx b/apps/desktop/src/components/memory-checkup/reminder-strip.tsx
