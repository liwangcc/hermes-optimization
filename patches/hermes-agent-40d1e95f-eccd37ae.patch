@@ -0,0 +1,71 @@
+import { useEffect } from 'react'
+
+import { StatusRow } from '@/components/chat/status-row'
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import { useI18n } from '@/i18n'
+import { MEMORY_CHECKUP_ROUTE, startMemoryCheckup } from '@/store/memory-checkup'
+import { dismissMemoryCheckupReminder, markMemoryCheckupReminderShown } from '@/store/memory-checkup-reminder'
+import { requestRoute } from '@/store/recovery-requests'
+
+// On screen long enough to be seen. An offer ahead of it in the queue can load a moment after boot and take the
+// slot back; a reminder that only flashed has not been shown.
+const SHOWN_AFTER_MS = 1000
+
+/**
+ * The memory-checkup reminder (on until turned off), in the composer status stack beside the
+ * other offers: it never blocks the composer or takes focus, and it stays
+ * until the user answers. "Next time" only takes it off the screen; the model
+ * runs on "Review now" and at no other time.
+ */
+export function MemoryCheckupReminderStrip() {
+  const { t } = useI18n()
+  const m = t.memoryCheckup
+
+  // On screen for the first time: this, not the due date passing, starts the next interval.
+  useEffect(() => {
+    const timer = window.setTimeout(() => markMemoryCheckupReminderShown(), SHOWN_AFTER_MS)
+
+    return () => window.clearTimeout(timer)
+  }, [])
+
+  const reviewNow = () => {
+    dismissMemoryCheckupReminder()
+    void startMemoryCheckup()
+    requestRoute(MEMORY_CHECKUP_ROUTE)
+  }
+
+  return (
+    <StatusRow
+      leading={<Codicon aria-hidden className="text-(--ui-text-tertiary)" name="history" size="0.8rem" />}
+      trailing={
+        <>
+          <Button
+            className="text-foreground/90 hover:text-foreground"
+            onClick={reviewNow}
+            size="micro"
+            type="button"
+            variant="text"
+          >
+            {m.reviewNow}
+          </Button>
+          <Button
+            className="text-muted-foreground/75 hover:text-foreground/90"
+            onClick={() => dismissMemoryCheckupReminder()}
+            size="micro"
+            type="button"
+            variant="text"
+          >
+            {m.reminder.nextTime}
+          </Button>
+        </>
+      }
+      trailingVisible
+    >
+      <span className="min-w-0 truncate text-[0.73rem] leading-4 text-foreground/92">
+        <span className="font-medium">{m.reminder.title}</span>
+        <span className="text-muted-foreground/80"> {m.reminder.body}</span>
+      </span>
+    </StatusRow>
+  )
+}
