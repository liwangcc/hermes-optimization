diff --git a/apps/desktop/e2e/memory-checkup.spec.ts b/apps/desktop/e2e/memory-checkup.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..af506c2b0160bd55d7609861ee42aba2f37b8af0
--- /dev/null
+++ b/apps/desktop/e2e/memory-checkup.spec.ts
@@ -0,0 +1,303 @@
+import { createHash } from 'node:crypto'
+import * as fs from 'node:fs'
+import * as path from 'node:path'
+
+import type { Page } from '@playwright/test'
+
+import { writeEnvFile, writeMockProviderConfig } from '../../../tests-js/scripts/mock-provider-config'
+import { startMockServer } from '../../../tests-js/scripts/mock-server'
+
+import { buildAppEnv, createSandbox, launchDesktop, type MockBackendFixture, waitForAppReady } from './fixtures'
+import { expect, test } from './test'
+
+// Real Electron, a real `hermes serve` and a real memory-provider plugin over
+// synthetic memory; only the model is the mock server. The checkup reads three
+// layers, proposes, and writes nothing.
+
+const REMINDER_KEY = 'hermes:memory-checkup-reminder:'
+const REVIEW_MARK = 'Find entries that are stale'
+const DAY = 24 * 60 * 60 * 1000
+
+const USER_MD = ['Reply in Chinese; keep code in English', 'Works at Acme on the billing service']
+const MEMORY_MD = ['Config is changed through the CLI, never by patching the file']
+
+const FACTS = [
+  { id: '7', text: 'The billing database is Postgres', age_days: 120, uses: 0, score: 0.5 },
+  { id: '8', text: 'The billing database is PostgreSQL 16 on RDS', age_days: 45, uses: 9, score: 0.8 },
+  { id: '9', text: 'Trying out the Zed editor this week', age_days: 2, uses: 0, score: 0.5, unconfirmed: true },
+  { id: '10', text: 'Never deploy on Fridays', age_days: 300, uses: 0, score: 0.6, protected: true }
+]
+
+const USAGE = {
+  items: FACTS.length,
+  storage_bytes: 180_224,
+  budgets: [
+    {
+      key: 'catalog',
+      label: 'Fact catalog',
+      enabled: true,
+      used: 1170,
+      limit: 3000,
+      unit: 'estimated tokens',
+      listed: 3,
+      eligible: 4
+    }
+  ]
+}
+
+// A provider plugin that only knows how to be read for a checkup: the two optional reads over a JSON file.
+const PROVIDER = `
+import json
+import time
+from pathlib import Path
+
+from agent.memory_provider import MemoryProvider
+
+
+class CheckupProv(MemoryProvider):
+    @property
+    def name(self):
+        return "checkupprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        pass
+
+    def get_tool_schemas(self):
+        return []
+
+    def usage_report(self, hermes_home):
+        return json.loads(Path(hermes_home, "checkupprov.json").read_text(encoding="utf-8"))["usage"]
+
+    def review_items(self, hermes_home):
+        items = json.loads(Path(hermes_home, "checkupprov.json").read_text(encoding="utf-8"))["items"]
+        return {"items": [{**i, "created_at": time.time() - i["age_days"] * 86400} for i in items]}
+
+
+def register(ctx):
+    ctx.register_memory_provider(CheckupProv())
+`
+
+function seedMemory(hermesHome: string): void {
+  fs.mkdirSync(path.join(hermesHome, 'memories'), { recursive: true })
+  fs.writeFileSync(path.join(hermesHome, 'memories', 'USER.md'), USER_MD.join('\n§\n'), 'utf8')
+  fs.writeFileSync(path.join(hermesHome, 'memories', 'MEMORY.md'), MEMORY_MD.join('\n§\n'), 'utf8')
+  fs.mkdirSync(path.join(hermesHome, 'plugins', 'checkupprov'), { recursive: true })
+  fs.writeFileSync(path.join(hermesHome, 'plugins', 'checkupprov', '__init__.py'), PROVIDER, 'utf8')
+  fs.writeFileSync(path.join(hermesHome, 'checkupprov.json'), JSON.stringify({ usage: USAGE, items: FACTS }), 'utf8')
+}
+
+/** Every byte a checkup could have written: the built-in files, staged writes and the provider's data. */
+function memoryState(hermesHome: string): Record<string, string> {
+  const files = ['memories', 'pending']
+    .map(dir => path.join(hermesHome, dir))
+    .filter(dir => fs.existsSync(dir))
+    .flatMap(dir => fs.readdirSync(dir, { recursive: true }).map(name => path.join(dir, String(name))))
+    .concat(path.join(hermesHome, 'checkupprov.json'))
+    .filter(file => fs.statSync(file).isFile())
+
+  return Object.fromEntries(
+    files.map(file => [path.relative(hermesHome, file), createHash('sha256').update(fs.readFileSync(file)).digest('hex')])
+  )
+}
+
+// The mock model's checkup reply: it names entries by the ids the prompt gave them.
+function reviewReply(prompt: string): string {
+  const ref = (text: string) =>
+    prompt
+      .split('\n')
+      .find(line => line.endsWith(`: ${text}`))!
+      .split(/[ :]/)[0]
+
+  return JSON.stringify({
+    proposals: [
+      {
+        target: ref(FACTS[0].text),
+        action: 'remove',
+        basis: 'duplicate',
+        with: [ref(FACTS[1].text)],
+        evidence: 'The newer fact says the same and adds the version and where it runs.',
+        preserve: ''
+      },
+      {
+        target: ref(USER_MD[1]),
+        action: 'update',
+        basis: 'outdated',
+        evidence: 'The entry names a team; nothing else here confirms it is current.',
+        preserve: 'That the user works at Acme.',
+        new_text: 'Works at Acme'
+      },
+      { target: ref(FACTS[2].text), action: 'remove', basis: 'outdated', evidence: 'It says "this week".' },
+      { target: ref(FACTS[3].text), action: 'remove', basis: 'unused', evidence: 'Never recalled.' }
+    ]
+  })
+}
+
+const reminder = (page: Page) =>
+  page.evaluate(prefix => {
+    const key = Object.keys(window.localStorage).find(name => name.startsWith(prefix))
+
+    return key ? { key, ...(JSON.parse(window.localStorage.getItem(key)!) as { dueAt: number; pending: boolean }) } : null
+  }, REMINDER_KEY)
+
+const openRoute = (page: Page, route: string) => page.evaluate(hash => void (window.location.hash = hash), `#${route}`)
+
+test('a due memory-checkup reminder leads to one read-only checkup', async () => {
+  test.setTimeout(240_000)
+
+  const testInfo = test.info()
+
+  const prompts: string[] = []
+
+  const mock = await startMockServer({
+    replyForPrompt: prompt => {
+      if (!prompt.includes(REVIEW_MARK)) {
+        return 'ok'
+      }
+
+      prompts.push(prompt)
+
+      return reviewReply(prompt)
+    }
+  })
+
+  const sandbox = createSandbox('memory-checkup')
+
+  seedMemory(sandbox.hermesHome)
+  // MEMORY.md switched off: a layer that is off must read as off, not as empty.
+  // English whatever the host's locale is: the assertions below read the English copy.
+  writeMockProviderConfig(
+    sandbox.hermesHome,
+    mock.url,
+    'language: en\n',
+    'memory:\n  provider: checkupprov\n  memory_enabled: false\n'
+  )
+  writeEnvFile(sandbox.hermesHome)
+
+  const { app, page } = await launchDesktop(buildAppEnv(sandbox))
+
+  const fixture: MockBackendFixture = {
+    app,
+    page,
+    mock,
+    mockUrl: mock.url,
+    sandbox,
+    cleanup: async () => {
+      await app.close().catch(() => undefined)
+      await mock.close()
+      sandbox.cleanup()
+    }
+  }
+
+  try {
+    await waitForAppReady(fixture)
+
+    // A fresh profile's own first-run question holds the composer's one offer slot: answer it, so the
+    // reminder below has the slot to itself.
+    await page.getByRole('button', { name: 'No thanks' }).click()
+
+    // Opt in. Off until here: no reminder is stored, and no model was asked anything about memory.
+    expect(await reminder(page)).toBeNull()
+    await openRoute(page, '/command-center?section=maintenance')
+
+    const panel = page.getByTestId('memory-checkup')
+
+    await panel.getByRole('switch', { name: 'Remind me to review' }).click()
+    await expect(panel.getByRole('button', { name: '14 days' })).toHaveAttribute('aria-pressed', 'true')
+    await expect(panel.getByRole('button', { name: '10 days' })).toBeVisible()
+
+    const armed = await reminder(page)
+
+    expect(armed!.pending).toBe(false)
+    expect(armed!.dueAt - Date.now()).toBeGreaterThan(13 * DAY)
+
+    // The due date passes while the app is closed: the stored date moves back, and the app is opened again.
+    await page.evaluate(
+      ({ key, dueAt }) => {
+        const stored = JSON.parse(window.localStorage.getItem(key)!)
+
+        window.localStorage.setItem(key, JSON.stringify({ ...stored, dueAt }))
+      },
+      { key: armed!.key, dueAt: Date.now() - 3 * DAY }
+    )
+    await openRoute(page, '/')
+    await page.reload()
+    await waitForAppReady(fixture)
+
+    const strip = page.locator('[data-slot="status-row"]').filter({ hasText: 'Memory checkup' })
+
+    await expect(strip).toHaveCount(1)
+    await expect(strip.getByRole('button', { name: 'Review now' })).toBeVisible()
+    await expect(strip.getByRole('button', { name: 'Next time' })).toBeVisible()
+
+    // The next interval starts once the reminder is on screen, and opening the app again does not restart it.
+    await expect.poll(async () => (await reminder(page))!.dueAt - Date.now()).toBeGreaterThan(13 * DAY)
+
+    const shown = await reminder(page)
+
+    expect(shown!.pending).toBe(true)
+    await page.reload()
+    await waitForAppReady(fixture)
+    await expect(strip).toHaveCount(1)
+    expect(await reminder(page)).toEqual(shown)
+    expect(prompts).toEqual([])
+    await page.screenshot({ path: testInfo.outputPath('memory-checkup-reminder.png') })
+
+    const before = memoryState(sandbox.hermesHome)
+
+    await strip.getByRole('button', { name: 'Review now' }).click()
+
+    // Capacity, by layer: a cap where Hermes enforces one, a count and a size where nothing does.
+    const capacity = page.getByTestId('memory-capacity')
+
+    await expect(capacity.getByText('77 / 1,375 characters · 6%')).toBeVisible({ timeout: 60_000 })
+    await expect(capacity.getByText('4 active facts · 176.0 KB')).toBeVisible()
+    await expect(capacity.getByText('1,170 / 3,000 estimated tokens · 39%')).toBeVisible()
+    await expect(capacity.getByText(/3 of 4 eligible facts listed/)).toBeVisible()
+    await expect(capacity.getByText('Off', { exact: true })).toBeVisible()
+
+    // What the model proposed, and what the rules made of it.
+    const results = page.getByTestId('memory-checkup-results')
+
+    await expect(results).toBeVisible({ timeout: 120_000 })
+    await expect(results.getByText(/Nothing has been changed/)).toBeVisible()
+
+    const facts = page.getByTestId('memory-checkup-facts')
+
+    await expect(facts.getByText('4 reviewed')).toBeVisible()
+    await expect(facts.getByText(`#7 ${FACTS[0].text}`)).toBeVisible()
+    await expect(facts.getByText(/Suggested: Remove\. Added in the last 7 days/)).toBeVisible()
+    await expect(facts.getByText(/Suggested: Remove\. You protected this entry/)).toBeVisible()
+    await expect(page.getByTestId('memory-checkup-user').getByText(USER_MD[1], { exact: true })).toBeVisible()
+    await expect(page.getByTestId('memory-checkup-user').getByText(/^Becomes: Works at Acme$/)).toBeVisible()
+    await expect(page.getByTestId('memory-checkup-memory').getByText('Off, so not reviewed.')).toBeVisible()
+
+    // One model call, and it never saw the layer that is off.
+    expect(prompts).toHaveLength(1)
+    expect(prompts[0]).toContain(USER_MD[0])
+    expect(prompts[0]).not.toContain(MEMORY_MD[0])
+    expect(memoryState(sandbox.hermesHome)).toEqual(before)
+    expect(fs.existsSync(path.join(sandbox.hermesHome, 'pending'))).toBe(false)
+    expect((await reminder(page))!.pending).toBe(false)
+
+    await capacity.scrollIntoViewIfNeeded()
+    await page.screenshot({ path: testInfo.outputPath('memory-checkup-capacity.png') })
+    await results.scrollIntoViewIfNeeded()
+    await page.screenshot({ path: testInfo.outputPath('memory-checkup-proposals.png') })
+
+    // An approved change goes to the chat box as a request. Still nothing is written.
+    await facts.getByRole('checkbox').click()
+    await page.getByRole('button', { name: 'Add selected to chat' }).click()
+    await expect(page.getByText('Added to the chat box. Send it to apply the changes.')).toBeVisible()
+    await openRoute(page, '/')
+    await expect(
+      page.locator('[data-slot="composer-root"] [contenteditable="true"]').filter({ visible: true }).first()
+    ).toContainText(`Remove #7 "${FACTS[0].text}"`)
+    expect(memoryState(sandbox.hermesHome)).toEqual(before)
+    expect(prompts).toHaveLength(1)
+  } finally {
+    await fixture.cleanup()
+  }
+})
