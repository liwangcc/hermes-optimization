diff --git a/hermes_cli/web_routers/memory_actions.py b/hermes_cli/web_routers/memory_actions.py
new file mode 100644
index 0000000000000000000000000000000000000000..236d8a33a8730e5ffa34d98eef7c0657e0f93a85
--- /dev/null
+++ b/hermes_cli/web_routers/memory_actions.py
@@ -0,0 +1,93 @@
+"""The active memory provider's maintenance jobs, for the Desktop's provider settings.
+
+``GET /api/memory/actions`` lists them; ``POST /api/memory/actions`` starts one as ``hermes memory action <id>``,
+tailed through ``/api/actions/memory-action/status`` like the other maintenance actions.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Optional
+
+from fastapi import APIRouter, HTTPException
+from pydantic import BaseModel
+
+from hermes_cli.memory_actions import ACTION_ID_RE, provider_actions
+from hermes_cli.web_deps import LateState, late
+from hermes_cli.web_routers._common import config_scoped_to_thread, destructive_profile, spawn_profile_action
+from hermes_cli.web_routers.actions import get_action_status
+
+router = APIRouter()
+
+# Late-bound so a test's monkeypatch on the owning module wins at call time.
+_load_memory_provider = late("_load_memory_provider", "hermes_cli.web_server_memory")
+get_hermes_home = late("get_hermes_home", "hermes_cli.config")
+load_config = late("load_config", "hermes_cli.config")
+_ACTION_PROCS = LateState("_ACTION_PROCS", "hermes_cli.web_server_gateway")
+
+ACTION_NAME = "memory-action"
+_last_job: tuple[Path, str, int] | None = None
+
+
+class MemoryActionRequest(BaseModel):
+    action: str
+    option: str = ""  # the choice for a job that lists options; blank runs its selected one
+
+
+def _actions() -> dict[str, Any]:
+    return provider_actions(load_config(), str(get_hermes_home()),
+                            lambda name: _load_memory_provider(name, register_skills=False))
+
+
+@router.get("/api/memory/actions")
+async def list_memory_actions(profile: Optional[str] = None):
+    return await config_scoped_to_thread(profile, _actions)
+
+
+@router.post("/api/memory/actions")
+async def run_memory_action(body: MemoryActionRequest, profile: Optional[str] = None):
+    """Start one job; it writes the provider's own data, so it names its profile like the other such routes."""
+    global _last_job
+
+    profile = destructive_profile(profile, "POST /api/memory/actions")
+    if not ACTION_ID_RE.fullmatch(body.action or ""):
+        raise HTTPException(status_code=400, detail="A job id is letters, digits, '-' and '_'.")
+    proc = _ACTION_PROCS.get(ACTION_NAME)
+    if proc is not None and proc.poll() is None:
+        raise HTTPException(status_code=409, detail="A memory provider job is already running. Wait for it to finish.")
+    listing, home = await config_scoped_to_thread(profile, lambda: (_actions(), Path(get_hermes_home()).resolve()))
+    action = next((a for a in listing["actions"] if a["id"] == body.action), None)
+    if action is None:
+        raise HTTPException(status_code=404, detail=f"The active memory provider offers no job {body.action!r}.")
+    if not action["ready"]:
+        raise HTTPException(status_code=409, detail=f"{action['label']} cannot run yet: {action['status']}")
+    option = body.option or action.get("selected", "")
+    if option and all(choice["id"] != option for choice in action.get("options", [])):
+        raise HTTPException(status_code=400, detail=f"{action['label']} has no such option.")
+    # The profile read can yield to another request. The admission and spawn below do not.
+    proc = _ACTION_PROCS.get(ACTION_NAME)
+    if proc is not None and proc.poll() is None:
+        raise HTTPException(status_code=409, detail="A memory provider job is already running. Wait for it to finish.")
+    argv = ["memory", "action", body.action, *(["--option", option] if option else [])]
+    started = spawn_profile_action(profile, argv, ACTION_NAME,
+                                   log_msg="Failed to spawn a memory provider job",
+                                   prefix="Could not start the memory provider job")
+    _last_job = (home, body.action, started["pid"])
+    return started
+
+
+@router.get("/api/memory/actions/status")
+async def memory_action_status(profile: Optional[str] = None):
+    """Follow the last job for the requesting profile, including after leaving Settings."""
+    home = await config_scoped_to_thread(profile, lambda: Path(get_hermes_home()).resolve())
+    empty = {"name": ACTION_NAME, "job": "", "running": False, "exit_code": None, "pid": None, "lines": []}
+    owner = _last_job
+    if owner is None or owner[0] != home:
+        return empty
+    status = await get_action_status(ACTION_NAME, lines=200)
+    if status["pid"] != owner[2]:
+        return empty
+    lines = status["lines"]
+    # Only this run's lines. If the header has slid out of the tail, all lines already belong to it.
+    start = max((i + 1 for i, line in enumerate(lines) if line.startswith(f"=== {ACTION_NAME} started ")), default=0)
+    return {**status, "job": owner[1], "lines": lines[start:]}
diff --git a/hermes_cli/web_routers/memory_checkup.py b/hermes_cli/web_routers/memory_checkup.py
new file mode 100644
index 0000000000000000000000000000000000000000..12016a15dca4ac0e783a42c96e770d7e711dd83b
--- /dev/null
+++ b/hermes_cli/web_routers/memory_checkup.py
@@ -0,0 +1,69 @@
+"""The memory checkup a user starts (``POST /api/memory/checkup``).
+
+One model call with no tools: it reads USER.md, MEMORY.md and the provider's items, returns proposals and applies none.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Optional
+
+from fastapi import APIRouter, HTTPException
+
+from agent import memory_checkup
+from hermes_cli.web_deps import late
+from hermes_cli.web_routers._common import client_error, config_scoped_to_thread, destructive_profile
+from hermes_cli.web_routers.memory_layers import active_provider, builtin_layers, provider_read
+
+_log = logging.getLogger("hermes_cli.web_server")
+router = APIRouter()
+
+# Late-bound so a test's monkeypatch on the owning module wins at call time.
+load_config = late("load_config", "hermes_cli.config")
+call_llm = late("call_llm", "agent.auxiliary_client")
+extract_content_or_reasoning = late("extract_content_or_reasoning", "agent.auxiliary_client")
+
+_CHECKUP_TIMEOUT_S = 120.0
+_CHECKUP_MAX_TOKENS = 4096
+
+
+def _checkup_input(config: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    """What the checkup reads. A layer that is switched off, unreadable or unsupported keeps its state and
+    sends nothing."""
+    layers: dict[str, dict[str, Any]] = {}
+    for name, layer in builtin_layers(config).items():
+        entries = layer["entries"] if layer["state"] == "ok" else []
+        layers[name] = {"state": layer["state"], "items": [{"id": n, "text": text} for n, text in enumerate(entries, 1)]}
+    state, report = provider_read(active_provider(config), "review_items")
+    items = [i for i in report.get("items") or [] if isinstance(i, dict) and "id" in i] if state == "ok" else []
+    layers["facts"] = {"state": "empty" if state == "ok" and not items else state, "items": items}
+    return layers
+
+
+def _run_checkup(config: dict[str, Any], now: float) -> dict[str, Any]:
+    prepared = memory_checkup.prepare(_checkup_input(config), now)
+    if not any(prepared[name]["items"] for name in memory_checkup.LAYERS):
+        return {"model": "", "generated_at": now, **memory_checkup.read_reply('{"proposals": []}', prepared)}
+    try:
+        # No tools: the model can only answer. An unconfigured task resolves to the profile's main model.
+        response = call_llm(task="memory_checkup", messages=memory_checkup.build_messages(prepared, now),
+                            temperature=None, max_tokens=_CHECKUP_MAX_TOKENS, timeout=_CHECKUP_TIMEOUT_S)
+    except Exception as exc:
+        _log.warning("POST /api/memory/checkup: the model call failed", exc_info=True)
+        raise HTTPException(status_code=503, detail=client_error(
+            f"The memory checkup could not reach the model ({type(exc).__name__}: {exc}). Nothing was changed. "
+            "Check the model and its credentials under Settings, then retry.")) from exc
+    try:
+        result = memory_checkup.read_reply(extract_content_or_reasoning(response), prepared)
+    except memory_checkup.CheckupReplyError as exc:
+        raise HTTPException(status_code=502, detail=f"The memory checkup failed: {exc}. Nothing was changed. "
+                                                    "Retry, or try another model.") from exc
+    return {"model": str(getattr(response, "model", "") or ""), "generated_at": now, **result}
+
+
+@router.post("/api/memory/checkup")
+async def checkup_memory(profile: Optional[str] = None):
+    """Proposals only: nothing is written here or later without the user approving it elsewhere."""
+    profile = destructive_profile(profile, "POST /api/memory/checkup")  # it sends one profile's memory to a model
+    return await config_scoped_to_thread(profile, lambda: _run_checkup(load_config(), time.time()))
diff --git a/hermes_cli/web_routers/memory_layers.py b/hermes_cli/web_routers/memory_layers.py
new file mode 100644
index 0000000000000000000000000000000000000000..ebac9c870d221549e29cec9cd8b15b48ac04c8dc
--- /dev/null
+++ b/hermes_cli/web_routers/memory_layers.py
@@ -0,0 +1,113 @@
+"""Memory capacity by layer, the ``layers`` of ``GET /api/memory``: USER.md, MEMORY.md and the provider's store.
+
+Only reads. Each layer carries its own state and only the limits something enforces.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Optional
+
+from agent.i18n import get_language
+from hermes_cli.web_deps import late
+from hermes_cli.web_server_memory import _normalize_memory_provider_name
+from plugins.memory.config_schema import translated_text
+
+_log = logging.getLogger("hermes_cli.web_server")
+
+# Late-bound so a test's monkeypatch on the owning module wins at call time.
+_load_memory_provider = late("_load_memory_provider", "hermes_cli.web_server_memory")
+get_hermes_home = late("get_hermes_home", "hermes_cli.config")
+builtin_memory_layers = late("builtin_memory_layers", "tools.memory_tool")
+estimate_tokens_rough = late("estimate_tokens_rough", "agent.model_metadata")
+
+_BUDGET_INT = ("used", "limit", "listed", "eligible")
+_BUILTIN = ("memory", "user")
+
+
+def _is_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def layer_state(enabled: bool, readable: bool, count: Optional[int]) -> str:
+    """``disabled`` (switched off), ``unavailable`` (could not be read), ``empty`` or ``ok``: never all "zero"."""
+    if not enabled:
+        return "disabled"
+    if not readable:
+        return "unavailable"
+    return "ok" if count else "empty"
+
+
+def active_provider(config: dict[str, Any]) -> str:
+    section = config.get("memory")
+    return _normalize_memory_provider_name(section.get("provider")) if isinstance(section, dict) else ""
+
+
+def provider_read(active: str, method: str) -> tuple[str, dict[str, Any]]:
+    """``(state, report)`` of the active provider's optional read *method*: ``disabled`` (no provider is
+    configured), ``unavailable`` (it did not load, or the read failed), ``unsupported`` (it reports nothing)."""
+    if not active:
+        return "disabled", {}
+    provider = _load_memory_provider(active, register_skills=False)
+    if provider is None:
+        return "unavailable", {}
+    try:
+        report = getattr(provider, method)(str(get_hermes_home()))
+    except Exception:  # health: allow BLE001 -- a plugin's read may raise anything; the layer then reads as unavailable
+        _log.warning("memory provider %s failed in %s()", active, method, exc_info=True)
+        return "unavailable", {}
+    return ("ok", report) if isinstance(report, dict) and report else ("unsupported", {})
+
+
+def _budget(raw: Any, language: str) -> Optional[dict[str, Any]]:
+    """One provider-enforced budget, or None when it does not say how much of what is used."""
+    if not isinstance(raw, dict) or not _is_int(raw.get("used")) or not _is_int(raw.get("limit")):
+        return None
+    budget: dict[str, Any] = {"enabled": raw.get("enabled") is not False}
+    for key in ("key", "field"):  # field: the settings field that sets this limit; the Desktop shows the budget beside it
+        if raw.get(key):
+            budget[key] = str(raw[key])
+    for key in ("label", "unit", "note"):  # note: one line in the provider's words about what the budget holds
+        text = translated_text(raw.get("translations"), language, key, str(raw.get(key) or ""))
+        if text:
+            budget[key] = text
+    budget.update({k: raw[k] for k in _BUDGET_INT if _is_int(raw.get(k))})
+    overlaps = [name for name in _BUILTIN if name in (raw.get("overlaps") or ())]
+    if overlaps:  # the built-in files this budget's text makes optional: the Desktop may suggest turning one off
+        budget["overlaps"] = overlaps
+    return budget
+
+
+def builtin_layers(config: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    """USER.md and MEMORY.md as the store reads them, each with its ``state``."""
+    layers = builtin_memory_layers(config)
+    for layer in layers.values():
+        layer["state"] = layer_state(layer["enabled"], layer["readable"], len(layer["entries"]))
+    return layers
+
+
+def memory_layers(config: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    """USER.md, MEMORY.md and the provider's store, each with its own state and only the limits something
+    enforces: the built-in files' character caps, and whatever budgets the provider reports."""
+    from tools.memory_tool import ENTRY_DELIMITER  # here, not at import: importing the tool registers it
+
+    layers: dict[str, dict[str, Any]] = {
+        name: {"state": layer["state"], "chars": layer["chars"], "char_limit": layer["char_limit"],
+               "entries": len(layer["entries"]),
+               # what it costs in every session, by core's own estimate: a file holds characters, a prompt tokens
+               "tokens": estimate_tokens_rough(ENTRY_DELIMITER.join(layer["entries"]))}
+        for name, layer in builtin_layers(config).items()
+    }
+    active = active_provider(config)
+    state, report = provider_read(active, "usage_report")
+    provider: dict[str, Any] = {"state": state, "name": active}
+    if state == "ok":
+        provider.update({k: report[k] for k in ("items", "storage_bytes") if _is_int(report.get(k))})
+        language = get_language()
+        budgets = [budget for raw in report.get("budgets") or [] if (budget := _budget(raw, language))]
+        if budgets:
+            provider["budgets"] = budgets
+        if provider.get("items") == 0:
+            provider["state"] = "empty"
+    layers["provider"] = provider
+    return layers
