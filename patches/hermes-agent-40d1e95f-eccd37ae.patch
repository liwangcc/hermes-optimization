+import type { ActionResponse, ActionStatusResponse } from '@/types/hermes'
+import type { ProviderJobsResponse } from '@/types/provider-jobs'
+
+import { hermesApi, profileScoped } from './client'
+
+/** The action name a provider job runs under; its log is tailed through `/api/actions/<name>/status`. */
+export const MEMORY_JOB_ACTION = 'memory-action'
+
+export function getMemoryJobs(profile?: null | string): Promise<ProviderJobsResponse> {
+  return hermesApi<ProviderJobsResponse>({ ...profileScoped(profile), path: '/api/memory/actions' })
+}
+
+/** Starts `hermes memory action <action>` on the backend; the job writes the provider's own data.
+ *  `option`: the choice for a job that lists options. */
+export function runMemoryJob(action: string, profile?: null | string, option?: string): Promise<ActionResponse> {
+  return hermesApi<ActionResponse>({
+    ...profileScoped(profile),
+    path: '/api/memory/actions',
+    method: 'POST',
+    body: option ? { action, option } : { action }
+  })
+}
+
+export function getMemoryJobStatus(profile?: null | string): Promise<ActionStatusResponse & { job: string }> {
+  return hermesApi<ActionStatusResponse & { job: string }>({
+    ...profileScoped(profile),
+    path: '/api/memory/actions/status'
+  })
+}
