@@ -0,0 +1,33 @@
+"""read_config_fields / write_config_fields: the Desktop's memory provider panel (config_schema.py) reads and writes
+plugins.hermes-memory-store of the profile it configures, through the writer `hermes memory setup` uses."""
+
+from __future__ import annotations
+
+from typing import Callable
+
+from .embeddings import _RE_ENV_NAME, _RE_KEY_PREFIX
+
+
+def stored(hermes_home: str, load: Callable[[], dict]) -> dict:
+    """The panel's keys as *hermes_home* stores them, not the profile this process runs; a null is unset. Only a
+    Hermes with the panel calls this, and only it has the module the schema imports."""
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+    from .config_schema import CONFIG_SCHEMA
+
+    token = set_hermes_home_override(hermes_home)
+    try:
+        section = load()
+    finally:
+        reset_hermes_home_override(token)
+    return {f.key: section[f.key] for f in CONFIG_SCHEMA.fields if section.get(f.key) is not None}
+
+
+def to_save(values: dict, stored_now: dict) -> dict:
+    """The submitted fields as setup writes them. A cleared one (None) that is stored is written empty, which the
+    plugin reads as unset (the merging writer cannot drop a key); one never stored is left out, not written as null.
+    An API key pasted where its variable's name goes is refused before it reaches config.yaml."""
+    name = values.get("embedding_key_env")
+    if isinstance(name, str) and (not _RE_ENV_NAME.fullmatch(name) or _RE_KEY_PREFIX.match(name)):
+        raise ValueError("API key variable must be the name of an environment variable, not the key itself")
+    return {key: value for key, value in values.items() if value is not None or key in stored_now}
