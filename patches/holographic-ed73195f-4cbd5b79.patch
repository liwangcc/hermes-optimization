+"""Desktop settings for search by meaning. Hermes renders this schema in its memory provider panel and hands reads and
+writes to read_config_fields / write_config_fields (config_fields.py): plugins.hermes-memory-store in the config.yaml of
+the profile being configured, the section `hermes memory setup` writes. The other settings stay with setup.
+
+Hermes reads this file from disk and never imports it as part of the package: it may import only the pure-data module.
+A blank field is unset, so the plugin's own default applies; the placeholder shows it.
+"""
+
+from dataclasses import replace
+
+from plugins.memory.config_schema import (
+    KIND_BOOL,
+    KIND_NUMBER,
+    KIND_SELECT,
+    STORAGE_PROVIDER,
+    ProviderConfigSchema,
+    ProviderField,
+    ProviderFieldOption,
+)
+
+_MORE = "Search by meaning"
+
+
+_ZH = {
+    "embeddings": {
+        "label": "按语义搜索",
+        "description": "开启后，会将事实文本、消息和事实库搜索词发往下方的向量接口。从新会话起生效。关闭后，下一个可写会话会删除该接口生成的存储向量。",
+    },
+    "embedding_url": {
+        "label": "向量 API 地址",
+        "description": "支持 OpenAI 兼容的向量接口。公网地址使用 HTTPS，本机或内网地址可以使用 HTTP。",
+    },
+    "embedding_model": {
+        "label": "向量模型",
+        "description": "填入接口实际提供的模型 ID。更换模型后，事实需要重新生成向量。",
+    },
+    "embedding_key_env": {
+        "label": "密钥环境变量",
+        "description": "填入变量名，例如 OPENAI_API_KEY，实际密钥保存在该配置的凭据中。无需密钥的本地服务可使用一个未设置的变量名。",
+    },
+    "embedding_prefetch_facts": {
+        "label": "仅凭语义召回的事实数",
+        "group": "语义搜索",
+        "description": "每轮开始前，可单凭语义加入的事实数。设为 0 时，语义仅用于关键词结果重排和事实库搜索。",
+    },
+    "embedding_dimensions": {
+        "label": "向量维度",
+        "group": "语义搜索",
+        "description": "留空使用模型原生维度。仅支持缩短向量的模型接受指定维度。",
+    },
+    "embedding_timeout": {
+        "label": "请求超时",
+        "group": "语义搜索",
+        "description": "单次请求可用的时间，范围为 0.5 至 6 秒。",
+    },
+    "embedding_min_score": {
+        "label": "最低相似度",
+        "group": "语义搜索",
+        "description": "仅凭语义召回时的相似度下限，范围为 -1 到 1。留空表示不设下限。",
+    },
+    "embedding_weight": {
+        "label": "语义权重",
+        "group": "语义搜索",
+        "description": "语义相似度在混合评分中的权重，范围为 0 到 0.8。",
+    },
+    "embedding_space": {
+        "label": "向量空间标识",
+        "group": "语义搜索",
+        "description": "同一地址和模型 ID 背后更换了模型时，可更改此标识，重新生成事实向量。",
+    },
+    "embedding_catch_up_seconds": {
+        "label": "每轮补建时间",
+        "group": "语义搜索",
+        "description": "每轮结束后为已有事实补建向量的时间，范围为 2 至 60 秒。",
+    },
+}
+
+CONFIG_SCHEMA = ProviderConfigSchema(
+    name="holographic",
+    label="Holographic",
+    storage=STORAGE_PROVIDER,
+    fields=(
+        ProviderField(
+            "embeddings", "Search by meaning", KIND_BOOL, default="false", inline=True,
+            description="ONLINE: fact texts, messages and fact_store search queries are sent to the embeddings API "
+                        "below, so a question worded differently from a fact can still find it. Off: no network "
+                        "calls, and the next writable session deletes stored vectors. Applies from the next session."),
+        ProviderField(
+            "embedding_url", "Embeddings API", placeholder="https://api.openai.com/v1", inline=True,
+            description="OpenAI-compatible (https; plain http only to localhost or a private address, e.g. Ollama)."),
+        ProviderField(
+            "embedding_model", "Embedding model", placeholder="text-embedding-3-small", inline=True,
+            description="Changing it makes every fact's vector again."),
+        ProviderField(
+            "embedding_key_env", "API key variable", placeholder="OPENAI_API_KEY", inline=True,
+            description="Name of the environment variable (e.g. in .env) that holds the API key; the key itself is "
+                        "never written to config. A local endpoint needs none."),
+        ProviderField(
+            "embedding_prefetch_facts", "Facts recalled on meaning alone", KIND_SELECT, default="1", group=_MORE,
+            options=tuple(ProviderFieldOption(n, n) for n in "0123"),
+            description="Before a turn, when they stand far out (0 = meaning only reorders facts that share words, "
+                        "and fact_store search uses it)."),
+        ProviderField(
+            "embedding_dimensions", "Vector size", KIND_NUMBER, group=_MORE,
+            description="Ask the model for vectors of this size; blank = the model's own. A model that cannot "
+                        "shorten its vectors rejects it."),
+        ProviderField(
+            "embedding_timeout", "Timeout", KIND_NUMBER, placeholder="3.0", group=_MORE,
+            description="Seconds one request may take (0.5-6)."),
+        ProviderField(
+            "embedding_min_score", "Minimum similarity", KIND_NUMBER, group=_MORE,
+            description="Optional floor (-1 to 1) for a fact recalled on meaning alone; blank = none."),
+        ProviderField(
+            "embedding_weight", "Weight of meaning", KIND_NUMBER, placeholder="0.3", group=_MORE,
+            description="How much meaning counts in the blended score (0-0.8)."),
+        ProviderField(
+            "embedding_space", "Vector space label", group=_MORE,
+            description="A label of your own: change it when the server starts serving another model under the same "
+                        "address and name, and every vector is made again."),
+        ProviderField(
+            "embedding_catch_up_seconds", "Vector time after a turn", KIND_NUMBER, placeholder="8", group=_MORE,
+            description="Seconds the fact vectors after a turn may take (2-60)."),
+    ),
+)
+
+CONFIG_SCHEMA = replace(
+    CONFIG_SCHEMA,
+    translations={"zh": {"label": "Holographic"}},
+    fields=tuple(replace(field, translations={"zh": _ZH[field.key]}) for field in CONFIG_SCHEMA.fields),
+)
