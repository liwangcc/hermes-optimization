+++ b/tests/test_holographic_config_schema.py
@@ -0,0 +1,86 @@
+"""The Desktop's memory provider panel for search by meaning: config_schema.py, read_config_fields, write_config_fields.
+
+Hermes loads config_schema.py by path from where the plugin is installed and hands reads and writes to the provider
+with the home of the profile being configured. What the panel saves must land in that profile's
+plugins.hermes-memory-store, be what search by meaning then runs with, and never put an API key into config.yaml.
+"""
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+import hermes_yaml as yaml
+import pytest
+
+from hermes_plugin_holographic import HolographicMemoryProvider
+
+REPO = Path(__file__).resolve().parent.parent
+
+
+def test_hermes_loads_the_schema_from_where_the_plugin_is_installed(_isolated_hermes_home):
+    from plugins.memory.config_schema import STORAGE_PROVIDER, get_provider_config_schema
+
+    plugin = _isolated_hermes_home / "plugins" / "holographic"  # as `hermes plugins install` lays it out
+    plugin.mkdir(parents=True)
+    for name in ("__init__.py", "config_schema.py"):  # the loader runs only config_schema.py, never the package
+        shutil.copy(REPO / name, plugin / name)
+
+    schema = get_provider_config_schema("holographic")
+
+    assert schema is not None and schema.storage == STORAGE_PROVIDER
+    assert "embeddings" in {field.key for field in schema.inline_fields()}
+
+
+def test_a_save_lands_in_that_profile_and_is_what_search_by_meaning_runs_with(tmp_path, monkeypatch,
+                                                                              _isolated_hermes_home):
+    profile = tmp_path / "work"
+    profile.mkdir()
+    (profile / "config.yaml").write_text("model:\n  default: keep-me\nplugins:\n  hermes-memory-store:\n"
+                                         "    scope: user\n")
+
+    HolographicMemoryProvider(config={}).write_config_fields({  # natives, as Hermes coerces the form
+        "embeddings": True, "embedding_url": "http://127.0.0.1:11434/v1", "embedding_model": "bge-m3",
+        "embedding_key_env": None, "embedding_prefetch_facts": "2", "embedding_dimensions": None,
+        "embedding_timeout": 5, "embedding_weight": 0.5, "embedding_space": "local",
+    }, str(profile))
+
+    raw = yaml.safe_load((profile / "config.yaml").read_text())
+    assert raw["model"]["default"] == "keep-me"
+    section = raw["plugins"]["hermes-memory-store"]
+    assert section["scope"] == "user"
+    assert "embedding_key_env" not in section and "embedding_dimensions" not in section  # blank, never stored
+    assert not (_isolated_hermes_home / "config.yaml").exists()  # the profile this process runs is untouched
+
+    monkeypatch.setenv("HERMES_HOME", str(profile))
+    on = HolographicMemoryProvider()._embedding
+    assert (on.url, on.model, on.key_env, on.recall_facts, on.dimensions, on.timeout, on.weight, on.space) == (
+        "http://127.0.0.1:11434/v1", "bge-m3", "OPENAI_API_KEY", 2, None, 5, 0.5, "local")
+
+
+def test_the_panel_reads_that_profile_and_a_cleared_field_goes_back_to_its_default(tmp_path, monkeypatch):
+    profile = tmp_path / "work"
+    profile.mkdir()
+    (profile / "config.yaml").write_text("plugins:\n  hermes-memory-store:\n    embeddings: on\n"
+                                         "    embedding_model: old-model\n    db_path: custom.db\n")
+    provider = HolographicMemoryProvider(config={})
+
+    values = provider.read_config_fields(str(profile))["values"]
+    assert values == {"embeddings": True, "embedding_model": "old-model"}  # YAML's on; only the panel's keys
+
+    provider.write_config_fields({"embedding_model": None}, str(profile))
+
+    assert provider.read_config_fields(str(profile))["values"] == {"embeddings": True}
+    monkeypatch.setenv("HERMES_HOME", str(profile))
+    assert HolographicMemoryProvider()._embedding.model == "text-embedding-3-small"
+
+
+@pytest.mark.parametrize("pasted", ["sk-proj-abc123", "OPENAI API KEY"])
+def test_an_api_key_pasted_as_the_variable_name_never_reaches_config(_isolated_hermes_home, pasted):
+    before = "plugins:\n  hermes-memory-store:\n    embeddings: off\n"
+    (_isolated_hermes_home / "config.yaml").write_text(before)
+
+    with pytest.raises(ValueError):
+        HolographicMemoryProvider(config={}).write_config_fields({"embedding_key_env": pasted},
+                                                                 str(_isolated_hermes_home))
+
+    assert (_isolated_hermes_home / "config.yaml").read_text() == before
