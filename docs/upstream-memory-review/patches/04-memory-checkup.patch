@@ -0,0 +1,215 @@
+import { act, cleanup, fireEvent, render, screen, within } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type * as SystemApi from '@/api/system'
+import { runMemoryCheckup } from '@/api/system'
+import type * as ComposerFocus from '@/app/chat/composer/focus'
+import { requestComposerInsert } from '@/app/chat/composer/focus'
+import type { MemoryCheckupLayer, MemoryCheckupResponse } from '@/types/memory-checkup'
+
+vi.mock('@/api/system', async importOriginal => ({
+  ...(await importOriginal<typeof SystemApi>()),
+  runMemoryCheckup: vi.fn()
+}))
+
+vi.mock('@/app/chat/composer/focus', async importOriginal => ({
+  ...(await importOriginal<typeof ComposerFocus>()),
+  requestComposerInsert: vi.fn()
+}))
+
+const { clearMemoryCheckupRun } = await import('@/store/memory-checkup')
+
+const { MemoryCheckupPanel } = await import('./memory-checkup')
+
+const layer = (over: Partial<MemoryCheckupLayer> = {}): MemoryCheckupLayer => ({
+  state: 'ok',
+  total: 0,
+  reviewed: 0,
+  changes: [],
+  needs_evidence: [],
+  keep: [],
+  ...over
+})
+
+function review(): MemoryCheckupResponse {
+  return {
+    model: 'synthetic-model',
+    generated_at: 1,
+    dropped: 1,
+    layers: {
+      user: layer({
+        total: 2,
+        reviewed: 2,
+        changes: [
+          {
+            action: 'update',
+            target: { layer: 'user', id: '2', text: 'Works at Acme' },
+            with: [],
+            basis: 'outdated',
+            evidence: 'The entry itself says the contract ended in March.',
+            preserve: 'That the user consulted for Acme.',
+            new_text: 'Consulted for Acme until March'
+          }
+        ],
+        keep: [{ layer: 'user', id: '1', text: 'Prefers replies in Chinese' }]
+      }),
+      memory: layer({ state: 'disabled' }),
+      facts: layer({
+        total: 5,
+        reviewed: 4,
+        changes: [
+          {
+            action: 'remove',
+            target: { layer: 'facts', id: '7', text: 'The database is Postgres' },
+            with: [{ layer: 'facts', id: '8', text: 'The database is PostgreSQL 16' }],
+            basis: 'duplicate',
+            evidence: 'Fact 8 says the same and adds the version.',
+            preserve: '',
+            new_text: ''
+          }
+        ],
+        needs_evidence: [
+          {
+            action: 'needs_evidence',
+            proposed: 'remove',
+            held: 'grace',
+            target: { layer: 'facts', id: '9', text: 'Trying out a new editor', exempt: 'grace' },
+            with: [],
+            basis: 'outdated',
+            evidence: 'It reads like a passing note.',
+            preserve: '',
+            new_text: ''
+          }
+        ],
+        keep: [{ layer: 'facts', id: '8', text: 'The database is PostgreSQL 16' }]
+      })
+    }
+  }
+}
+
+const within_ = (testId: string) => within(screen.getByTestId(testId))
+
+beforeEach(() => {
+  vi.mocked(runMemoryCheckup).mockReset()
+  vi.mocked(requestComposerInsert).mockReset()
+  act(() => clearMemoryCheckupRun())
+})
+
+afterEach(cleanup)
+
+describe('memory checkup panel', () => {
+  it('runs the model only on "Review now" and shows what it proposed, layer by layer', async () => {
+    vi.mocked(runMemoryCheckup).mockResolvedValue(review())
+    render(<MemoryCheckupPanel />)
+
+    expect(runMemoryCheckup).not.toHaveBeenCalled()
+    fireEvent.click(screen.getByRole('button', { name: 'Review now' }))
+    await screen.findByTestId('memory-checkup-results')
+    expect(runMemoryCheckup).toHaveBeenCalledTimes(1)
+
+    expect(screen.getByText(/These are proposals. Nothing has been changed./)).toBeTruthy()
+    expect(screen.getByText(/Reviewed by synthetic-model/)).toBeTruthy()
+
+    const user = within_('memory-checkup-user')
+
+    expect(user.getByText('2 reviewed')).toBeTruthy()
+    expect(user.getByText('Update')).toBeTruthy()
+    expect(user.getByText('Works at Acme')).toBeTruthy()
+    expect(user.getByText('Consulted for Acme until March')).toBeTruthy()
+    expect(user.getByText('The entry itself says the contract ended in March.')).toBeTruthy()
+    expect(user.getByText('That the user consulted for Acme.')).toBeTruthy()
+    expect(user.getByRole('button', { name: /Keep \(1\)/ })).toBeTruthy()
+
+    // A layer that is switched off was not reviewed, and says so instead of "nothing to change".
+    expect(within_('memory-checkup-memory').getByText('Off, so not reviewed.')).toBeTruthy()
+
+    const facts = within_('memory-checkup-facts')
+
+    expect(facts.getByText('4 of 5 reviewed')).toBeTruthy()
+    expect(facts.getByText('Remove')).toBeTruthy()
+    expect(facts.getByText('#8 The database is PostgreSQL 16')).toBeTruthy()
+    expect(facts.getByText('Needs evidence')).toBeTruthy()
+    expect(facts.getByText(/Suggested: Remove\. Added in the last 7 days/)).toBeTruthy()
+  })
+
+  it('writes nothing: approved changes become a chat request, and only the ticked ones', async () => {
+    vi.mocked(runMemoryCheckup).mockResolvedValue(review())
+    render(<MemoryCheckupPanel />)
+    fireEvent.click(screen.getByRole('button', { name: 'Review now' }))
+    await screen.findByTestId('memory-checkup-results')
+
+    const add = () => screen.getByRole('button', { name: 'Add selected to chat' }) as HTMLButtonElement
+
+    expect(add().disabled).toBe(true)
+    // What needs evidence cannot be approved: only the two standing changes have a checkbox.
+    expect(screen.getAllByRole('checkbox')).toHaveLength(2)
+
+    fireEvent.click(within_('memory-checkup-facts').getByRole('checkbox'))
+    fireEvent.click(add())
+
+    expect(requestComposerInsert).toHaveBeenCalledTimes(1)
+
+    const [request, target] = vi.mocked(requestComposerInsert).mock.calls[0]
+
+    expect(target).toEqual({ mode: 'block', target: 'main' })
+    expect(request).toContain('Remove #7 "The database is Postgres"')
+    expect(request).not.toContain('Acme')
+    expect(screen.getByText('Added to the chat box. Send it to apply the changes.')).toBeTruthy()
+    expect(runMemoryCheckup).toHaveBeenCalledTimes(1)
+  })
+
+  it('shows a failed checkup as a failure with a retry, never as results', async () => {
+    vi.mocked(runMemoryCheckup).mockRejectedValueOnce(
+      new Error(
+        'Error invoking remote method \'hermes:api\': Error: 503: {"detail":"The memory checkup could not reach the model (AuxiliaryClientUnavailable). Nothing was changed."}'
+      )
+    )
+    render(<MemoryCheckupPanel />)
+    fireEvent.click(screen.getByRole('button', { name: 'Review now' }))
+
+    const alert = await screen.findByRole('alert')
+
+    expect(within(alert).getByText(/could not reach the model/)).toBeTruthy()
+    expect(within(alert).getByText('Nothing was changed.')).toBeTruthy()
+    expect(screen.queryByTestId('memory-checkup-results')).toBeNull()
+    expect(requestComposerInsert).not.toHaveBeenCalled()
+
+    vi.mocked(runMemoryCheckup).mockResolvedValueOnce(review())
+    fireEvent.click(within(alert).getByRole('button', { name: 'Retry' }))
+    await screen.findByTestId('memory-checkup-results')
+    expect(runMemoryCheckup).toHaveBeenCalledTimes(2)
+  })
+
+  it('tells the user to update a Hermes that has no checkup, instead of offering a retry', async () => {
+    vi.mocked(runMemoryCheckup).mockRejectedValueOnce(
+      new Error(
+        'Error invoking remote method \'hermes:api\': Error: 404: {"detail":"No such API endpoint: /api/memory/checkup"}'
+      )
+    )
+    render(<MemoryCheckupPanel />)
+    fireEvent.click(screen.getByRole('button', { name: 'Review now' }))
+
+    await screen.findByText('This Hermes version has no memory checkup. Update Hermes to use it.')
+    expect(screen.queryByRole('alert')).toBeNull()
+    expect(screen.queryByRole('button', { name: 'Retry' })).toBeNull()
+  })
+
+  it('says there was nothing to review when every layer is empty or off', async () => {
+    vi.mocked(runMemoryCheckup).mockResolvedValue({
+      model: '',
+      generated_at: 2,
+      dropped: 0,
+      layers: {
+        user: layer({ state: 'empty' }),
+        memory: layer({ state: 'disabled' }),
+        facts: layer({ state: 'unsupported' })
+      }
+    })
+    render(<MemoryCheckupPanel />)
+    fireEvent.click(screen.getByRole('button', { name: 'Review now' }))
+
+    await screen.findByText('Nothing to review: no layer holds any entries.')
+    expect(within_('memory-checkup-facts').getByText('This provider does not offer its facts for review.')).toBeTruthy()
+    expect(screen.queryByRole('button', { name: 'Add selected to chat' })).toBeNull()
+  })
+})
diff --git a/apps/desktop/src/app/command-center/memory-checkup.tsx b/apps/desktop/src/app/command-center/memory-checkup.tsx
