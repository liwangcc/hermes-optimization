--- /dev/null
+++ b/apps/desktop/src/app/command-center/memory-checkup.tsx
@@ -0,0 +1,279 @@
+import { useStore } from '@nanostores/react'
+import { useEffect, useRef, useState } from 'react'
+
+import { $apiRequestScope } from '@/api/client'
+import { requestComposerInsert } from '@/app/chat/composer/focus'
+import { Button } from '@/components/ui/button'
+import { Checkbox } from '@/components/ui/checkbox'
+import { DisclosureCaret } from '@/components/ui/disclosure-caret'
+import { useI18n } from '@/i18n'
+import type { MemoryCheckupTranslations } from '@/i18n/types_memory_checkup'
+import { AlertCircle } from '@/lib/icons'
+import { memoryCheckupRequest } from '@/lib/memory-checkup-request'
+import { $memoryCheckupRun, memoryCheckupScope, startMemoryCheckup } from '@/store/memory-checkup'
+import { $activeGatewayProfile } from '@/store/profile'
+import type {
+  MemoryCheckupEntry,
+  MemoryCheckupLayer,
+  MemoryCheckupLayerName,
+  MemoryCheckupProposal,
+  MemoryCheckupResponse
+} from '@/types/memory-checkup'
+
+import { ListRow, Pill } from '../settings/primitives'
+
+const LAYERS: readonly MemoryCheckupLayerName[] = ['user', 'memory', 'facts']
+const CAPTION = 'text-[length:var(--conversation-caption-font-size)] text-(--ui-text-tertiary)'
+const TEXT = 'text-[length:var(--conversation-text-font-size)]'
+const HEADING = 'mb-1 mt-2 text-[0.625rem] font-medium uppercase tracking-[0.08em] text-(--ui-text-tertiary)'
+
+const proposalKey = (p: MemoryCheckupProposal) => `${p.target.layer}:${p.target.id}`
+const entryLabel = (e: MemoryCheckupEntry) => (e.layer === 'facts' ? `#${e.id} ${e.text}` : e.text)
+
+function Detail({ label, value }: { label: string; value: string }) {
+  return value ? (
+    <div className={CAPTION}>
+      <span className="font-medium text-(--ui-text-secondary)">{label}: </span>
+      {value}
+    </div>
+  ) : null
+}
+
+function Proposal({
+  m,
+  onToggle,
+  proposal,
+  selected
+}: {
+  m: MemoryCheckupTranslations
+  onToggle?: (key: string) => void
+  proposal: MemoryCheckupProposal
+  selected?: boolean
+}) {
+  const change = proposal.action === 'needs_evidence' ? proposal.proposed : proposal.action
+
+  return (
+    <li className="flex items-start gap-2 rounded-lg border border-(--ui-stroke-tertiary) bg-(--ui-bg-quinary) p-2.5">
+      {onToggle && (
+        <Checkbox
+          aria-label={m.select}
+          checked={selected}
+          className="mt-0.5"
+          onCheckedChange={() => onToggle(proposalKey(proposal))}
+        />
+      )}
+      <div className="grid min-w-0 gap-1">
+        <div className={`flex items-start gap-2 ${TEXT}`} data-selectable-text="true">
+          {proposal.action !== 'needs_evidence' && <Pill tone="warn">{m.action[proposal.action]}</Pill>}
+          <span className="min-w-0 wrap-break-word">{entryLabel(proposal.target)}</span>
+        </div>
+        <Detail label={m.becomes} value={proposal.new_text} />
+        <Detail label={m.related} value={proposal.with.map(entryLabel).join(' · ')} />
+        <Detail label={m.evidence} value={proposal.evidence} />
+        <Detail label={m.preserve} value={proposal.preserve} />
+        {proposal.held && (
+          <div className={CAPTION}>
+            {change ? `${m.suggested(m.action[change])}. ` : ''}
+            {m.held[proposal.held]}
+          </div>
+        )}
+      </div>
+    </li>
+  )
+}
+
+function Layer({
+  layer,
+  m,
+  name,
+  onToggle,
+  selected
+}: {
+  layer: MemoryCheckupLayer
+  m: MemoryCheckupTranslations
+  name: MemoryCheckupLayerName
+  onToggle: (key: string) => void
+  selected: ReadonlySet<string>
+}) {
+  const [keepOpen, setKeepOpen] = useState(false)
+  const title = name === 'facts' ? m.factsLayer : name === 'user' ? 'USER.md' : 'MEMORY.md'
+  const reviewed = layer.state === 'ok' ? m.reviewed(layer.reviewed, layer.total) : m.layerState[layer.state]
+
+  return (
+    <section className="mt-3" data-testid={`memory-checkup-${name}`}>
+      <div className="flex items-baseline gap-2">
+        <span className={`${TEXT} font-medium`}>{title}</span>
+        <span className={CAPTION}>{reviewed}</span>
+      </div>
+      {layer.changes.length > 0 && (
+        <>
+          <div className={HEADING}>{m.changes}</div>
+          <ul className="grid gap-1.5">
+            {layer.changes.map(p => (
+              <Proposal
+                key={proposalKey(p)}
+                m={m}
+                onToggle={onToggle}
+                proposal={p}
+                selected={selected.has(proposalKey(p))}
+              />
+            ))}
+          </ul>
+        </>
+      )}
+      {layer.needs_evidence.length > 0 && (
+        <>
+          <div className={HEADING}>{m.needsEvidence}</div>
+          <ul className="grid gap-1.5">
+            {layer.needs_evidence.map(p => (
+              <Proposal key={proposalKey(p)} m={m} proposal={p} />
+            ))}
+          </ul>
+        </>
+      )}
+      {layer.state === 'ok' && layer.changes.length + layer.needs_evidence.length === 0 && (
+        <div className={`mt-1 ${CAPTION}`}>{m.noFindings}</div>
+      )}
+      {layer.keep.length > 0 && (
+        <>
+          <Button
+            aria-expanded={keepOpen}
+            className="mt-1.5"
+            onClick={() => setKeepOpen(open => !open)}
+            size="inline"
+            type="button"
+            variant="text"
+          >
+            <DisclosureCaret open={keepOpen} />
+            {m.keep(layer.keep.length)}
+          </Button>
+          {keepOpen && (
+            <ul className={`mt-1 grid gap-0.5 ${CAPTION}`} data-selectable-text="true">
+              {layer.keep.map(e => (
+                <li className="wrap-break-word" key={e.id}>
+                  {entryLabel(e)}
+                </li>
+              ))}
+            </ul>
+          )}
+        </>
+      )}
+    </section>
+  )
+}
+
+function Results({ m, result }: { m: MemoryCheckupTranslations; result: MemoryCheckupResponse }) {
+  const [selected, setSelected] = useState<ReadonlySet<string>>(new Set())
+  const [added, setAdded] = useState(false)
+  const chosen = LAYERS.flatMap(name => result.layers[name].changes).filter(p => selected.has(proposalKey(p)))
+
+  const toggle = (key: string) => {
+    setAdded(false)
+    setSelected(current => {
+      const next = new Set(current)
+
+      if (!next.delete(key)) {
+        next.add(key)
+      }
+
+      return next
+    })
+  }
+
+  // The only step toward a write, and it writes nothing: the ticked changes become a chat request the user sends.
+  const addToChat = () => {
+    requestComposerInsert(memoryCheckupRequest(chosen), { mode: 'block', target: 'main' })
+    setAdded(true)
+  }
+
+  const nothing = LAYERS.every(name => result.layers[name].reviewed === 0)
+
+  return (
+    <div className="mt-2" data-testid="memory-checkup-results">
+      <div className={CAPTION}>
+        {nothing ? m.nothingToReview : `${m.proposalsOnly} ${result.model ? m.reviewedBy(result.model) : ''}`}
+        {result.dropped > 0 ? ` ${m.dropped(result.dropped)}` : ''}
+      </div>
+      {LAYERS.map(name => (
+        <Layer key={name} layer={result.layers[name]} m={m} name={name} onToggle={toggle} selected={selected} />
+      ))}
+      {!nothing && (
+        <div className="mt-3 flex flex-wrap items-center gap-3">
+          <Button disabled={chosen.length === 0} onClick={addToChat} size="xs" type="button" variant="textStrong">
+            {m.addToChat}
+          </Button>
+          <span className={`min-w-0 flex-1 ${CAPTION}`}>{added ? m.addedToChat : m.addToChatHint}</span>
+        </div>
+      )}
+    </div>
+  )
+}
+
+/**
+ * Command Center > Maintenance: "Review now", and what the checkup proposed.
+ * The run belongs to the (connection, profile) it was started on; after a
+ * switch, another profile's proposals are not shown here.
+ */
+export function MemoryCheckupPanel() {
+  const { t } = useI18n()
+  const m = t.memoryCheckup
+  const run = useStore($memoryCheckupRun)
+
+  // Re-render on a profile or connection switch: the scope below is read from them.
+  useStore($activeGatewayProfile)
+  useStore($apiRequestScope)
+
+  const mine = run.status !== 'idle' && run.scope === memoryCheckupScope() ? run : null
+  const running = run.status === 'running'
+  const root = useRef<HTMLDivElement>(null)
+
+  // Bring the checkup the user just asked for into view.
+  useEffect(() => {
+    if (running) {
+      root.current?.scrollIntoView?.({ block: 'nearest' })
+    }
+  }, [running])
+
+  return (
+    <div data-testid="memory-checkup" ref={root}>
+      <ListRow
+        action={
+          <Button disabled={running} onClick={() => void startMemoryCheckup()} size="xs" type="button" variant="textStrong">
+            {m.reviewNow}
+          </Button>
+        }
+        description={m.desc}
+        title={m.title}
+      />
+      {mine?.status === 'running' && (
+        <div className={`py-2 ${CAPTION}`} role="status">
+          {m.running}
+        </div>
+      )}
+      {mine?.status === 'unsupported' && <div className={`py-2 ${CAPTION}`}>{m.olderBackend}</div>}
+      {mine?.status === 'failed' && (
+        <div
+          className="mt-1 rounded-lg border border-destructive/35 p-3 text-[length:var(--conversation-caption-font-size)]"
+          role="alert"
+        >
+          <div className="flex items-center gap-1.5 font-medium text-destructive">
+            <AlertCircle className="size-3.5" />
+            {mine.message}
+          </div>
+          {mine.detail && (
+            <div className="mt-1 text-(--ui-text-secondary)" data-selectable-text="true">
+              {mine.detail}
+            </div>
+          )}
+          <div className="mt-2 flex items-center gap-3">
+            <span className="text-(--ui-text-tertiary)">{m.nothingChanged}</span>
+            <Button onClick={() => void startMemoryCheckup()} size="xs" type="button" variant="textStrong">
+              {m.retry}
+            </Button>
+          </div>
+        </div>
+      )}
+      {mine?.status === 'done' && <Results key={mine.result.generated_at} m={m} result={mine.result} />}
+    </div>
+  )
+}
