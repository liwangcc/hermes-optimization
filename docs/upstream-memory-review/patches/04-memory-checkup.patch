+def test_a_failed_model_call_is_an_error_to_retry_and_no_memory_is_written(home, client, model):
+    from agent.auxiliary_unavailable import AuxiliaryClientUnavailable
+
+    _write_home(home)
+    before = _memory_state(home)
+    model.error = AuxiliaryClientUnavailable("No LLM provider configured for task=memory_checkup. Run: hermes setup")
+    response = client.post("/api/memory/checkup")
+    assert response.status_code == 503
+    detail = response.json()["detail"]
+    assert "No LLM provider configured" in detail and "Nothing was changed" in detail and "retry" in detail
+    assert "layers" not in response.json()  # a failure, not an empty review
+    assert len(model.calls) == 1 and _memory_state(home) == before
+
+    model.error, model.reply = None, "Sorry, I cannot help with that."
+    response = client.post("/api/memory/checkup")
+    assert response.status_code == 502 and "Nothing was changed" in response.json()["detail"]
+    assert _memory_state(home) == before
+
+    model.reply = '{"proposals": []}'
+    assert client.post("/api/memory/checkup").status_code == 200  # the retry
+    assert len(model.calls) == 3 and _memory_state(home) == before
+
