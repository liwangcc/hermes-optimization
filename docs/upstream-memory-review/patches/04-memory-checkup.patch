+
+    plugins_mod._reset_plugin_managers_for_tests()
+    yield get_hermes_home()
+    plugins_mod._reset_plugin_managers_for_tests()
+
+
+@pytest.fixture
+def client(home):
+    from starlette.testclient import TestClient
+    from hermes_cli.web_server import _SESSION_HEADER_NAME, _SESSION_TOKEN, app
+
+    return TestClient(app, headers={_SESSION_HEADER_NAME: _SESSION_TOKEN})
+
+
+@pytest.fixture
+def model(monkeypatch):
+    return _Model(monkeypatch)
+
+
+def test_a_checkup_returns_proposals_by_layer_and_writes_nothing(home, client, model):
+    _write_home(home)
+
+    def reply(messages):
+        prompt = messages[-1]["content"]
+        return json.dumps({"proposals": [
+            {"target": _ref(prompt, "The database is Postgres"), "action": "remove", "basis": "duplicate",
+             "with": [_ref(prompt, "The database is PostgreSQL 16")], "evidence": "The other fact adds the version.",
+             "preserve": "the version"},
+            {"target": _ref(prompt, "Works at Acme"), "action": "update", "basis": "outdated",
+             "evidence": "The user said the contract ended.", "preserve": "that they consulted for Acme",
+             "new_text": "Consulted for Acme until March"},
+            {"target": _ref(prompt, "Trying out a new editor"), "action": "remove", "basis": "outdated", "evidence": "passing note"},
+            {"target": _ref(prompt, "Never deploy on Fridays"), "action": "remove", "basis": "outdated", "evidence": "old"},
+            {"target": _ref(prompt, "Deploy from the release branch"), "action": "remove", "basis": "unused",
+             "evidence": "nothing refers to it"},
+            {"target": "f404", "action": "remove", "basis": "outdated", "evidence": "invented"},
+        ]})
+
+    model.reply, model.tool_calls = reply, [{"function": {"name": "memory", "arguments": '{"action": "remove"}'}}]
+    before = _memory_state(home)
+    response = client.post("/api/memory/checkup")
+    assert response.status_code == 200, response.text
+    data = response.json()
+
+    # One call, the user's main model (an unconfigured task), and nothing it could act with.
+    [call] = model.calls
+    assert call["task"] == "memory_checkup" and not call.get("tools")
+    assert not {"provider", "model", "base_url", "api_key"} & set(call)
+    assert _memory_state(home) == before and not (home / "pending").exists()
+
+    assert data["model"] == "synthetic-model" and data["dropped"] == 1
+    layers = data["layers"]
+    assert [(c["action"], c["target"]["id"], c["target"]["text"], [w["id"] for w in c["with"]])
+            for c in layers["facts"]["changes"]] == [("remove", "7", "The database is Postgres", ["8"])]
+    assert layers["facts"]["changes"][0]["preserve"] == "the version"
+    assert {q["target"]["id"]: (q["proposed"], q["held"]) for q in layers["facts"]["needs_evidence"]} == {
+        "9": ("remove", "grace"), "10": ("remove", "protected")}
+    assert [k["id"] for k in layers["facts"]["keep"]] == ["8"]
+    [update] = layers["user"]["changes"]
+    assert (update["action"], update["target"]["text"], update["new_text"]) == (
+        "update", "Works at Acme", "Consulted for Acme until March")
+    assert [k["text"] for k in layers["user"]["keep"]] == ["Prefers replies in Chinese"]
+    assert [(q["proposed"], q["held"]) for q in layers["memory"]["needs_evidence"]] == [("remove", "usage")]
+    assert {name: (layer["state"], layer["reviewed"], layer["total"]) for name, layer in layers.items()} == {
+        "user": ("ok", 2, 2), "memory": ("ok", 1, 1), "facts": ("ok", 4, 4)}
