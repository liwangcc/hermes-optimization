diff --git a/tests/hermes_cli/test_web_memory_checkup.py b/tests/hermes_cli/test_web_memory_checkup.py
new file mode 100644
index 00000000..c018d22e
--- /dev/null
+++ b/tests/hermes_cli/test_web_memory_checkup.py
@@ -0,0 +1,278 @@
+"""``POST /api/memory/checkup``, against a real temp ``HERMES_HOME``: synthetic MEMORY.md / USER.md, a synthetic
+provider plugin, and a model that is a function in this file.
+
+The checkup must only read. Each test that runs it compares every memory file before and after."""
+
+import hashlib
+import json
+from types import SimpleNamespace
+
+import hermes_yaml as yaml
+import pytest
+
+from hermes_cli import plugins as plugins_mod
+
+_CHECKUPPROV = '''
+import json
+import time
+from pathlib import Path
+
+from agent.memory_provider import MemoryProvider
+
+
+class CheckupProv(MemoryProvider):
+    """Reads <hermes_home>/checkupprov.json. A checkup that initialized it or called its tools leaves a mark."""
+
+    @property
+    def name(self):
+        return "checkupprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        Path(kwargs["hermes_home"], "checkupprov.touched").write_text("initialize")
+
+    def get_tool_schemas(self):
+        return [{"name": "checkupprov_write", "description": "d", "parameters": {"type": "object", "properties": {}}}]
+
+    def handle_tool_call(self, tool_name, args, **kwargs):
+        Path(kwargs["hermes_home"], "checkupprov.touched").write_text(tool_name)
+        return "{}"
+
+    def _data(self, hermes_home):
+        data = json.loads(Path(hermes_home, "checkupprov.json").read_text(encoding="utf-8"))
+        if data.get("broken"):
+            raise RuntimeError("store is locked")
+        return data
+
+    def review_items(self, hermes_home):
+        now = time.time()
+        items = self._data(hermes_home).get("items")
+        if items is None:
+            return {}
+        return {"items": [{**i, "created_at": now - i["age_days"] * 86400} for i in items]}
+
+
+def register(ctx):
+    ctx.register_memory_provider(CheckupProv())
+'''
+
+_PLAINPROV = '''
+from agent.memory_provider import MemoryProvider
+
+
+class PlainProv(MemoryProvider):
+    """A provider written before the optional reads existed."""
+
+    @property
+    def name(self):
+        return "plainprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        pass
+
+    def get_tool_schemas(self):
+        return []
