+++ b/apps/desktop/src/types/memory-checkup.ts
@@ -0,0 +1,48 @@
+// The memory checkup a user starts: `POST /api/memory/checkup`.
+
+import type { MemoryLayerState } from './memory-layers'
+
+export type MemoryCheckupLayerName = 'facts' | 'memory' | 'user'
+
+export interface MemoryCheckupEntry {
+  layer: MemoryCheckupLayerName
+  id: string
+  text: string
+  /** Why a routine review may not propose removing it. */
+  exempt?: 'grace' | 'protected'
+}
+
+export type MemoryCheckupChange = 'merge' | 'remove' | 'update'
+
+export interface MemoryCheckupProposal {
+  action: 'needs_evidence' | MemoryCheckupChange
+  target: MemoryCheckupEntry
+  /** The entries that prove it (duplicate, superseded, contradicted) or are folded in (merge). */
+  with: MemoryCheckupEntry[]
+  basis: string
+  evidence: string
+  preserve: string
+  new_text: string
+  /** A change the backend kept only as a question, and why. */
+  held?: 'evidence' | 'grace' | 'protected' | 'usage'
+  proposed?: MemoryCheckupChange
+}
+
+export interface MemoryCheckupLayer {
+  state: MemoryLayerState
+  total: number
+  reviewed: number
+  changes: MemoryCheckupProposal[]
+  needs_evidence: MemoryCheckupProposal[]
+  keep: MemoryCheckupEntry[]
+}
+
+/** Proposals only: nothing here was written. */
+export interface MemoryCheckupResponse {
+  /** The model that answered; empty when there was nothing to review. */
+  model: string
+  generated_at: number
+  /** Proposals the backend dropped: an unknown entry, action, or a second verdict. */
+  dropped: number
+  layers: Record<MemoryCheckupLayerName, MemoryCheckupLayer>
+}
diff --git a/hermes_cli/web_routers/memory_checkup.py b/hermes_cli/web_routers/memory_checkup.py
new file mode 100644
index 00000000..12016a15
--- /dev/null
+++ b/hermes_cli/web_routers/memory_checkup.py
@@ -0,0 +1,69 @@
+"""The memory checkup a user starts (``POST /api/memory/checkup``).
+
+One model call with no tools: it reads USER.md, MEMORY.md and the provider's items, returns proposals and applies none.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Optional
+
+from fastapi import APIRouter, HTTPException
+
+from agent import memory_checkup
+from hermes_cli.web_deps import late
+from hermes_cli.web_routers._common import client_error, config_scoped_to_thread, destructive_profile
+from hermes_cli.web_routers.memory_layers import active_provider, builtin_layers, provider_read
+
+_log = logging.getLogger("hermes_cli.web_server")
+router = APIRouter()
+
+# Late-bound so a test's monkeypatch on the owning module wins at call time.
+load_config = late("load_config", "hermes_cli.config")
+call_llm = late("call_llm", "agent.auxiliary_client")
+extract_content_or_reasoning = late("extract_content_or_reasoning", "agent.auxiliary_client")
+
+_CHECKUP_TIMEOUT_S = 120.0
+_CHECKUP_MAX_TOKENS = 4096
+
+
+def _checkup_input(config: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    """What the checkup reads. A layer that is switched off, unreadable or unsupported keeps its state and
+    sends nothing."""
+    layers: dict[str, dict[str, Any]] = {}
+    for name, layer in builtin_layers(config).items():
+        entries = layer["entries"] if layer["state"] == "ok" else []
+        layers[name] = {"state": layer["state"], "items": [{"id": n, "text": text} for n, text in enumerate(entries, 1)]}
+    state, report = provider_read(active_provider(config), "review_items")
+    items = [i for i in report.get("items") or [] if isinstance(i, dict) and "id" in i] if state == "ok" else []
+    layers["facts"] = {"state": "empty" if state == "ok" and not items else state, "items": items}
+    return layers
+
+
+def _run_checkup(config: dict[str, Any], now: float) -> dict[str, Any]:
+    prepared = memory_checkup.prepare(_checkup_input(config), now)
+    if not any(prepared[name]["items"] for name in memory_checkup.LAYERS):
+        return {"model": "", "generated_at": now, **memory_checkup.read_reply('{"proposals": []}', prepared)}
+    try:
+        # No tools: the model can only answer. An unconfigured task resolves to the profile's main model.
+        response = call_llm(task="memory_checkup", messages=memory_checkup.build_messages(prepared, now),
+                            temperature=None, max_tokens=_CHECKUP_MAX_TOKENS, timeout=_CHECKUP_TIMEOUT_S)
+    except Exception as exc:
+        _log.warning("POST /api/memory/checkup: the model call failed", exc_info=True)
+        raise HTTPException(status_code=503, detail=client_error(
+            f"The memory checkup could not reach the model ({type(exc).__name__}: {exc}). Nothing was changed. "
+            "Check the model and its credentials under Settings, then retry.")) from exc
+    try:
+        result = memory_checkup.read_reply(extract_content_or_reasoning(response), prepared)
+    except memory_checkup.CheckupReplyError as exc:
+        raise HTTPException(status_code=502, detail=f"The memory checkup failed: {exc}. Nothing was changed. "
+                                                    "Retry, or try another model.") from exc
+    return {"model": str(getattr(response, "model", "") or ""), "generated_at": now, **result}
+
+
+@router.post("/api/memory/checkup")
+async def checkup_memory(profile: Optional[str] = None):
+    """Proposals only: nothing is written here or later without the user approving it elsewhere."""
+    profile = destructive_profile(profile, "POST /api/memory/checkup")  # it sends one profile's memory to a model
+    return await config_scoped_to_thread(profile, lambda: _run_checkup(load_config(), time.time()))
