+def register(ctx):
+    ctx.register_memory_provider(PlainProv())
+'''
+
+_ITEMS = [
+    {"id": "7", "text": "The database is Postgres", "age_days": 90, "uses": 0, "score": 0.5},
+    {"id": "8", "text": "The database is PostgreSQL 16", "age_days": 40, "uses": 6, "score": 0.9},
+    {"id": "9", "text": "Trying out a new editor", "age_days": 2, "uses": 0, "score": 0.5},
+    {"id": "10", "text": "Never deploy on Fridays", "age_days": 300, "uses": 0, "score": 0.2, "protected": True},
+]
+
+
+def _write_home(home, *, provider="checkupprov", memory=None, data=None, user="Prefers replies in Chinese\n§\nWorks at Acme",
+                notes="Deploy from the release branch"):
+    (home / "memories").mkdir(parents=True, exist_ok=True)
+    (home / "memories" / "USER.md").write_text(user, encoding="utf-8")
+    (home / "memories" / "MEMORY.md").write_text(notes, encoding="utf-8")
+    for name, source in (("checkupprov", _CHECKUPPROV), ("plainprov", _PLAINPROV)):
+        (home / "plugins" / name).mkdir(parents=True, exist_ok=True)
+        (home / "plugins" / name / "__init__.py").write_text(source, encoding="utf-8")
+    (home / "checkupprov.json").write_text(json.dumps(data if data is not None else {"items": _ITEMS}),
+                                          encoding="utf-8")
+    (home / "config.yaml").write_text(yaml.safe_dump({"memory": {"provider": provider, **(memory or {})}}), encoding="utf-8")
+
+
+def _memory_state(home):
+    """Every byte a checkup could have written: the built-in files, staged writes and the provider's store."""
+    files = sorted(p for root in (home / "memories", home / "pending") if root.exists() for p in root.rglob("*") if p.is_file())
+    files += [p for p in (home / "checkupprov.json", home / "checkupprov.touched") if p.exists()]
+    return {str(p.relative_to(home)): hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
+
+
+class _Model:
+    """The model: what it was asked, and the reply (or the exception) it gives."""
+
+    def __init__(self, monkeypatch):
+        self.calls, self.reply, self.error, self.tool_calls = [], '{"proposals": []}', None, None
+        monkeypatch.setattr("agent.auxiliary_client.call_llm", self)
+
+    def __call__(self, **kwargs):
+        self.calls.append(kwargs)
+        if self.error:
+            raise self.error
+        reply = self.reply(kwargs["messages"]) if callable(self.reply) else self.reply
+        message = SimpleNamespace(content=reply, tool_calls=self.tool_calls)
+        return SimpleNamespace(model="synthetic-model", choices=[SimpleNamespace(message=message)])
+
+    @property
+    def prompt(self):
+        return self.calls[-1]["messages"][-1]["content"]
+
+
+def _ref(prompt, text):
+    """The id the prompt gave the entry whose text is *text*."""
+    return next(line.split(":", 1)[0].split(" ", 1)[0] for line in prompt.splitlines() if line.endswith(": " + text))
+
+
+@pytest.fixture
+def home(_isolate_hermes_home):
