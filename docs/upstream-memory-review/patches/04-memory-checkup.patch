new file mode 100644
index 00000000..049d1019
--- /dev/null
+++ b/apps/desktop/src/lib/memory-checkup-request.ts
@@ -0,0 +1,42 @@
+import type { MemoryCheckupEntry, MemoryCheckupLayerName, MemoryCheckupProposal } from '@/types/memory-checkup'
+
+const WHERE: Record<MemoryCheckupLayerName, string> = {
+  user: 'USER.md (memory tool, target "user")',
+  memory: 'MEMORY.md (memory tool, target "memory")',
+  facts: 'the stored facts of the memory provider'
+}
+
+// The entry's own words, so the agent matches the entry the user saw; a fact also carries its id.
+const entry = (e: MemoryCheckupEntry) => `${e.layer === 'facts' ? `#${e.id} ` : ''}${JSON.stringify(e.text)} in ${WHERE[e.layer]}`
+
+function step(p: MemoryCheckupProposal): string {
+  if (p.action === 'remove') {
+    return `Remove ${entry(p.target)}.`
+  }
+
+  const rewrite = `${entry(p.target)} so it reads ${JSON.stringify(p.new_text)}`
+
+  return p.action === 'merge'
+    ? `Merge into ${rewrite}, then remove ${p.with.map(entry).join(' and ')}.`
+    : `Update ${rewrite}.`
+}
+
+/**
+ * The changes the user ticked, as a request for an ordinary chat turn. The
+ * checkup itself writes nothing: the agent makes these with its normal memory
+ * tools once the user sends this, under whatever write approval is set.
+ * English on purpose: it is a prompt for the model, like the composer's
+ * other inserted requests.
+ */
+export function memoryCheckupRequest(proposals: MemoryCheckupProposal[]): string {
+  const lines = proposals.map(
+    (p, index) =>
+      `${index + 1}. ${step(p)}${p.evidence ? ` Why: ${p.evidence}` : ''}${p.preserve ? ` Preserve: ${p.preserve}` : ''}`
+  )
+
+  return [
+    'I reviewed my memory and approved the changes below. Make exactly these with your normal memory tools and nothing else, then list what you changed.',
+    '',
+    ...lines
+  ].join('\n')
+}
