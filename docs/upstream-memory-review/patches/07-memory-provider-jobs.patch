+import type { ActionResponse } from '@/types/hermes'
+import type { ProviderJobsResponse } from '@/types/provider-jobs'
+
+import { hermesApi, profileScoped } from './client'
+
+/** The action name a provider job runs under; its log is tailed through `/api/actions/<name>/status`. */
+export const MEMORY_JOB_ACTION = 'memory-action'
+
+export function getMemoryJobs(profile?: null | string): Promise<ProviderJobsResponse> {
+  return hermesApi<ProviderJobsResponse>({ ...profileScoped(profile), path: '/api/memory/actions' })
+}
+
+/** Starts `hermes memory action <action>` on the backend; the job writes the provider's own data. */
+export function runMemoryJob(action: string, profile?: null | string): Promise<ActionResponse> {
+  return hermesApi<ActionResponse>({ ...profileScoped(profile), path: '/api/memory/actions', method: 'POST', body: { action } })
+}
