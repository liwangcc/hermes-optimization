diff --git a/hermes_cli/web_routers/memory_actions.py b/hermes_cli/web_routers/memory_actions.py
new file mode 100644
index 00000000..3828cc1a
--- /dev/null
+++ b/hermes_cli/web_routers/memory_actions.py
@@ -0,0 +1,60 @@
+"""The active memory provider's maintenance jobs, for the Desktop's provider settings.
+
+``GET /api/memory/actions`` lists them; ``POST /api/memory/actions`` starts one as ``hermes memory action <id>``,
+tailed through ``/api/actions/memory-action/status`` like the other maintenance actions.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Optional
+
+from fastapi import APIRouter, HTTPException
+from pydantic import BaseModel
+
+from hermes_cli.memory_actions import ACTION_ID_RE, provider_actions
+from hermes_cli.web_deps import LateState, late
+from hermes_cli.web_routers._common import config_scoped_to_thread, destructive_profile, spawn_profile_action
+
+router = APIRouter()
+
+# Late-bound so a test's monkeypatch on the owning module wins at call time.
+_load_memory_provider = late("_load_memory_provider", "hermes_cli.web_server_memory")
+get_hermes_home = late("get_hermes_home", "hermes_cli.config")
+load_config = late("load_config", "hermes_cli.config")
+_ACTION_PROCS = LateState("_ACTION_PROCS", "hermes_cli.web_server_gateway")
+
+ACTION_NAME = "memory-action"
+
+
+class MemoryActionRequest(BaseModel):
+    action: str
+
+
+def _actions() -> dict[str, Any]:
+    return provider_actions(load_config(), str(get_hermes_home()),
+                            lambda name: _load_memory_provider(name, register_skills=False))
+
+
+@router.get("/api/memory/actions")
+async def list_memory_actions(profile: Optional[str] = None):
+    return await config_scoped_to_thread(profile, _actions)
+
+
+@router.post("/api/memory/actions")
+async def run_memory_action(body: MemoryActionRequest, profile: Optional[str] = None):
+    """Start one job; it writes the provider's own data, so it names its profile like the other such routes."""
+    profile = destructive_profile(profile, "POST /api/memory/actions")
+    if not ACTION_ID_RE.fullmatch(body.action or ""):
+        raise HTTPException(status_code=400, detail="A job id is letters, digits, '-' and '_'.")
+    proc = _ACTION_PROCS.get(ACTION_NAME)
+    if proc is not None and proc.poll() is None:
+        raise HTTPException(status_code=409, detail="A memory provider job is already running. Wait for it to finish.")
+    listing = await config_scoped_to_thread(profile, _actions)
+    action = next((a for a in listing["actions"] if a["id"] == body.action), None)
+    if action is None:
+        raise HTTPException(status_code=404, detail=f"The active memory provider offers no job {body.action!r}.")
+    if not action["ready"]:
+        raise HTTPException(status_code=409, detail=f"{action['label']} cannot run yet: {action['status']}")
+    return spawn_profile_action(profile, ["memory", "action", body.action], ACTION_NAME,
+                                log_msg="Failed to spawn a memory provider job",
+                                prefix="Could not start the memory provider job")
