new file mode 100644
index 00000000..3b67f3e5
--- /dev/null
+++ b/apps/desktop/src/app/settings/memory/provider-jobs.tsx
@@ -0,0 +1,141 @@
+import { useCallback, useEffect, useState } from 'react'
+
+import { getMemoryJobs, MEMORY_JOB_ACTION, runMemoryJob } from '@/api/memory-jobs'
+import { getActionStatus } from '@/api/system'
+import { Button } from '@/components/ui/button'
+import { useI18n } from '@/i18n'
+import { notifyError } from '@/store/notifications'
+import type { ActionStatusResponse } from '@/types/hermes'
+import type { ProviderJob } from '@/types/provider-jobs'
+
+import { ListRow } from '../primitives'
+
+const POLL_MS = 1200
+const LOG_LINES = 200
+const CAPTION = 'text-[length:var(--conversation-caption-font-size)] text-(--ui-text-tertiary)'
+const HEADING = 'mt-3 text-[0.625rem] font-medium uppercase tracking-[0.08em] text-(--ui-text-tertiary)'
+
+/**
+ * The provider's one-click jobs, under its settings: where each stands, Run, the job's output while it runs and
+ * how it ended. A job runs in a process of its own, so leaving the page does not stop it; what it does is the
+ * provider's. Nothing shows for a provider without jobs or on a Hermes older than the route.
+ */
+export function ProviderJobs({ profile, provider }: { profile?: string; provider: string }) {
+  const { t } = useI18n()
+  const j = t.settings.memoryLayers.jobs
+  const [jobs, setJobs] = useState<ProviderJob[]>([])
+  // A fresh object per launch: the backend reuses one action name, so a bare id would not restart the tail.
+  const [tail, setTail] = useState<null | { id: string }>(null)
+  const [status, setStatus] = useState<ActionStatusResponse | null>(null)
+
+  const refresh = useCallback(async () => {
+    try {
+      const next = await getMemoryJobs(profile)
+      setJobs(next.state === 'ok' && next.provider === provider ? next.actions : [])
+    } catch {
+      setJobs([]) // an older Hermes (no route) or a backend hiccup: the settings above stay usable
+    }
+  }, [profile, provider])
+
+  useEffect(() => {
+    void refresh()
+  }, [refresh])
+
+  // Follow the job's output until it ends, then read where every job stands now.
+  useEffect(() => {
+    if (!tail) {
+      return
+    }
+
+    let cancelled = false
+    let timer: null | number = null
+
+    const poll = async () => {
+      try {
+        const next = await getActionStatus(MEMORY_JOB_ACTION, LOG_LINES, profile)
+
+        if (cancelled) {
+          return
+        }
+
+        setStatus(next)
+
+        if (next.running) {
+          timer = window.setTimeout(() => void poll(), POLL_MS)
+        } else {
+          void refresh()
+        }
+      } catch {
+        // The status route hiccuped: stop following; the job itself keeps running.
+      }
+    }
+
+    void poll()
+
+    return () => {
+      cancelled = true
+
+      if (timer !== null) {
+        window.clearTimeout(timer)
+      }
+    }
+  }, [tail, profile, refresh])
+
+  const start = async (job: ProviderJob) => {
+    try {
+      await runMemoryJob(job.id, profile)
+      setStatus(null)
+      setTail({ id: job.id })
+    } catch (err) {
+      notifyError(err, j.startFailed(job.label))
+    }
+  }
+
+  if (jobs.length === 0 && !tail) {
+    return null
+  }
+
+  const running = tail !== null && (status === null || status.running)
+
+  return (
+    <div data-testid="provider-jobs">
+      <div className={HEADING}>{j.title}</div>
+      {jobs.map(job => (
+        <ListRow
+          action={
+            <Button
+              disabled={!job.ready || running}
+              onClick={() => void start(job)}
+              size="xs"
+              type="button"
+              variant="textStrong"
+            >
+              {running && tail?.id === job.id ? j.running : j.run}
+            </Button>
+          }
+          description={
+            <>
+              {job.description}
+              {job.status && <span className={`block ${CAPTION}`}>{job.status}</span>}
+            </>
+          }
+          key={job.id}
+          title={job.label}
+        />
+      ))}
+      {tail && status && (
+        <div className="mt-2" data-testid="provider-job-output">
+          <div className={CAPTION} role="status">
+            {status.running ? j.running : status.exit_code === 0 ? j.finished : j.failed(status.exit_code)}
+          </div>
+          <pre
+            className="mt-1 max-h-48 overflow-auto whitespace-pre-wrap wrap-break-word rounded-lg border border-(--ui-stroke-tertiary) bg-(--ui-bg-quinary) p-3 font-mono text-[0.65rem] leading-relaxed text-(--ui-text-tertiary)"
+            data-selectable-text="true"
+          >
+            {status.lines.join('\n')}
+          </pre>
+        </div>
+      )}
+    </div>
+  )
+}
