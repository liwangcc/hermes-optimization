diff --git a/tests/test_holographic_recall_margin_shown.py b/tests/test_holographic_recall_margin_shown.py
new file mode 100644
index 0000000..d18eea8
--- /dev/null
+++ b/tests/test_holographic_recall_margin_shown.py
@@ -0,0 +1,91 @@
+"""embeddings.RECALL_MARGIN_SHOWN: a margin of its own before a turn that already shows a fact (a measurement).
+
+A fact let in by meaning turns silence into noise only in a turn that shows nothing else. With the value set, a turn
+in which the words found a fact, or the message names an entity that has one, admits by meaning at that margin; a turn
+that would stay silent keeps RECALL_MARGIN. None, the default, is one margin before every turn. The meaning is given
+(no request), as in test_holographic_names_fit_cases; the facts are made up."""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+np = pytest.importorskip("numpy")
+pytest.importorskip("snowballstemmer")
+
+from hermes_plugin_holographic import HolographicMemoryProvider, embeddings  # noqa: E402
+
+ON = {"embeddings": "on", "embedding_url": "https://embeddings.example.net/v1", "embedding_model": "m",
+      "embedding_key_env": "TEST_EMBEDDINGS_KEY"}
+
+KEY = "The spare key hangs behind the blue flowerpot on the balcony."  # what the meaning stream may add
+COFFEE = "Black coffee without sugar is the morning drink."  # what the words of ASKS_COFFEE find
+FILLERS = [f"Shelf {n} of the archive holds the folders of year {1990 + n}." for n in range(32)]
+ASKS_COFFEE = "Which coffee is the morning drink?"
+ASKS_NOTHING = "Whereabouts of the hidden gadget?"  # no word of a fact, no name: the words leave the turn silent
+
+
+class _NoNetwork:
+    def open(self, *a, **k):
+        raise AssertionError("no request in these tests: meaning is given")
+
+
+@pytest.fixture
+def provider(tmp_path, monkeypatch):
+    monkeypatch.setattr(embeddings, "_OPENER", _NoNetwork())
+    monkeypatch.setenv("TEST_EMBEDDINGS_KEY", "sk-test-not-a-real-key")
+    p = HolographicMemoryProvider(config={"db_path": str(tmp_path / "memory_store.db"), "hrr_dim": 64, **ON})
+    p.initialize(session_id="s1")
+    yield p
+    p.shutdown()
+
+
+def _add(p, text, entities=()) -> int:
+    args = {"action": "add", "content": text, **({"entities": list(entities)} if entities else {})}
+    result = json.loads(p.handle_tool_call("fact_store", args))
+    assert "fact_id" in result, result
+    return result["fact_id"]
+
+
+def _between_the_margins(provider, monkeypatch, texts):
+    """The store with KEY standing out more than 0.5 over the chance maximum and less than RECALL_MARGIN."""
+    ids = {text: _add(provider, text) for text in texts}
+    order = list(ids)
+    sims = [0.30 if t == KEY else 0.10 + 0.01 * (i % 12) for i, t in enumerate(order)]
+    meaning = embeddings.Meaning([ids[t] for t in order], np.array(sims), 0.3,
+                                 [embeddings.text_hash(t) for t in order])
+    assert meaning.standout(ids[KEY], 0.5, None) and not meaning.standout(ids[KEY], embeddings.RECALL_MARGIN, None)
+    monkeypatch.setattr(provider, "_meaning_of", lambda q, before_turn: meaning)
+    return ids
+
+
+def _by_meaning(block: str, fact_id: int) -> bool:
+    return any(f"#{fact_id} " in line and line.endswith("(by meaning)") for line in block.splitlines())
+
+
+def test_one_margin_before_every_turn_by_default(provider, monkeypatch):
+    ids = _between_the_margins(provider, monkeypatch, [KEY, COFFEE, *FILLERS])
+    assert embeddings.RECALL_MARGIN_SHOWN is None
+    block = provider.prefetch(ASKS_COFFEE)
+    assert f"#{ids[COFFEE]} " in block and not _by_meaning(block, ids[KEY])
+
+
+def test_a_turn_the_words_already_answer_admits_at_the_second_margin(provider, monkeypatch):
+    ids = _between_the_margins(provider, monkeypatch, [KEY, COFFEE, *FILLERS])
+    monkeypatch.setattr(embeddings, "RECALL_MARGIN_SHOWN", 0.5)
+    block = provider.prefetch(ASKS_COFFEE)
+    assert f"#{ids[COFFEE]} " in block and _by_meaning(block, ids[KEY])
+
+
+def test_a_turn_that_would_stay_silent_keeps_the_recall_margin(provider, monkeypatch):
+    _between_the_margins(provider, monkeypatch, [KEY, COFFEE, *FILLERS])
+    monkeypatch.setattr(embeddings, "RECALL_MARGIN_SHOWN", 0.5)
+    assert provider.prefetch(ASKS_NOTHING) == ""
+
+
+def test_an_entity_the_message_names_counts_as_a_fact_shown(provider, monkeypatch):
+    """Stream 3 runs after the meaning stream, so whether it will show a fact is asked beforehand."""
+    _between_the_margins(provider, monkeypatch, [KEY, COFFEE, *FILLERS])
+    _add(provider, "Mirabel waters the orchids on Sundays.", ["Mirabel"])
+    assert provider._names_a_fact("Anything about Mirabel?", set(), "s1", 1)
+    assert not provider._names_a_fact(ASKS_NOTHING, set(), "s1", 1)
