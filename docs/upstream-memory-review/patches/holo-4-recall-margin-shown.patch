+
+
+# --- a second margin for a turn that already shows a fact (provenance_probe --recall-margin-shown) ---
+
+
+def test_the_report_names_the_second_margin_of_the_proposal(tmp_path, capsys):
+    """The default side carries none (also rows written before the stamp existed), the proposal one."""
+    hi, lo = _rescued()
+    lo[-1]["keys"], lo[-1]["wrong5"] = ["t", "a", "b", "c", "d", "X"], []
+    for r in lo:
+        r["margin_shown"] = 0.5
+    mcnemar.report_margins(_pair(hi, lo, tmp_path))
+    out = capsys.readouterr().out
+    assert "margins 1.0 (default) vs 0.6 (0.5 where the turn already shows a fact) (proposal)" in out
+    assert "gate PASSES" in out
+
+
+def test_two_second_margins_under_one_margin_are_refused(tmp_path):
+    """Rows of two runs that share `margin` and differ in `margin_shown` are not one proposal."""
+    hi, lo = _rescued()
+    for r in lo:
+        r["margin_shown"] = 0.5
+    lo[0]["margin_shown"] = 0.4
+    with pytest.raises(SystemExit, match="margin_shown"):
+        mcnemar.report_margins(_pair(hi, lo, tmp_path))
