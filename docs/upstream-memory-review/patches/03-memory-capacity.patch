+"""``GET /api/memory`` capacity by layer, against a real temp ``HERMES_HOME``: synthetic MEMORY.md / USER.md and a
+synthetic provider plugin loaded through real discovery."""
+
+import json
+
+import hermes_yaml as yaml
+import pytest
+
+from hermes_cli import plugins as plugins_mod
+
+_LAYERSPROV = '''
+import json
+from pathlib import Path
+
+from agent.memory_provider import MemoryProvider
+
+
+class LayersProv(MemoryProvider):
+    """Reports what <hermes_home>/layersprov.json says it holds."""
+
+    @property
+    def name(self):
+        return "layersprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        pass
+
+    def get_tool_schemas(self):
+        return []
+
+    def usage_report(self, hermes_home):
+        data = json.loads(Path(hermes_home, "layersprov.json").read_text(encoding="utf-8"))
+        if data.get("broken"):
+            raise RuntimeError("store is locked")
+        return data.get("usage", {})
+
+
+def register(ctx):
+    ctx.register_memory_provider(LayersProv())
+'''
+
+_PLAINPROV = '''
+from agent.memory_provider import MemoryProvider
+
+
+class PlainProv(MemoryProvider):
+    """A provider written before the optional reads existed."""
+
+    @property
+    def name(self):
+        return "plainprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        pass
+
+    def get_tool_schemas(self):
+        return []
+
+
+def register(ctx):
+    ctx.register_memory_provider(PlainProv())
+'''
+
+_USAGE = {"items": 4, "storage_bytes": 180224, "budgets": [
+    {"key": "catalog", "label": "Fact catalog", "enabled": True, "used": 1170, "limit": 3000,
+     "unit": "estimated tokens", "listed": 3, "eligible": 4},
+    {"key": "made-up", "label": "no numbers"},  # says neither how much nor of what: not shown
+]}
+
+
+def _write_home(home, *, provider="layersprov", memory=None, data=None, user="Prefers replies in Chinese\n§\nWorks at Acme",
+                notes="Deploy from the release branch"):
+    (home / "memories").mkdir(parents=True, exist_ok=True)
+    (home / "memories" / "USER.md").write_text(user, encoding="utf-8")
+    (home / "memories" / "MEMORY.md").write_text(notes, encoding="utf-8")
+    for name, source in (("layersprov", _LAYERSPROV), ("plainprov", _PLAINPROV)):
+        (home / "plugins" / name).mkdir(parents=True, exist_ok=True)
+        (home / "plugins" / name / "__init__.py").write_text(source, encoding="utf-8")
+    (home / "layersprov.json").write_text(json.dumps(data if data is not None else {"usage": _USAGE}), encoding="utf-8")
+    (home / "config.yaml").write_text(yaml.safe_dump({"memory": {"provider": provider, **(memory or {})}}), encoding="utf-8")
+
+
+@pytest.fixture
+def home(_isolate_hermes_home):
+    from hermes_constants import get_hermes_home
+
+    plugins_mod._reset_plugin_managers_for_tests()
+    yield get_hermes_home()
+    plugins_mod._reset_plugin_managers_for_tests()
+
+
+@pytest.fixture
+def client(home):
+    from starlette.testclient import TestClient
+    from hermes_cli.web_server import _SESSION_HEADER_NAME, _SESSION_TOKEN, app
+
+    return TestClient(app, headers={_SESSION_HEADER_NAME: _SESSION_TOKEN})
+
+
+def test_each_layer_reports_its_own_usage_and_only_limits_something_enforces(home, client):
+    _write_home(home, memory={"user_char_limit": 500},
+                user="likes tea\n§\n  works remotely  \n§\nlikes tea\n§\n\n")  # a duplicate, padding, an empty entry
+    from tools.memory_tool import ENTRY_DELIMITER, load_on_disk_store
+
+    layers = client.get("/api/memory").json()["layers"]
+    store = load_on_disk_store()  # the store writes are checked against
+    assert layers["user"] == {"state": "ok", "chars": len(ENTRY_DELIMITER.join(store.user_entries)),
+                              "char_limit": 500, "entries": 2}
+    assert layers["user"]["chars"] < len((home / "memories" / "USER.md").read_text(encoding="utf-8"))  # not the file size
+    assert layers["memory"] == {"state": "ok", "chars": len("Deploy from the release branch"), "char_limit": 2200, "entries": 1}
+    # The provider's own numbers, passed on as given; a budget without numbers is not a budget.
+    assert layers["provider"] == {"state": "ok", "name": "layersprov", "items": 4, "storage_bytes": 180224, "budgets": [
+        {"enabled": True, "key": "catalog", "label": "Fact catalog", "unit": "estimated tokens", "used": 1170,
+         "limit": 3000, "listed": 3, "eligible": 4}]}
+    assert not {"limit", "char_limit", "percent"} & set(layers["provider"])  # no ceiling is invented for the store
+
+
+def test_off_empty_unreadable_and_unsupported_are_different_answers(home, client):
+    _write_home(home, memory={"memory_enabled": False}, user="", data={"usage": {"items": 0}})
+    (home / "memories" / "USER.md").unlink()
+    layers = client.get("/api/memory").json()["layers"]
+    assert layers["memory"]["state"] == "disabled" and layers["memory"]["chars"] > 0  # off, with what is on disk
+    assert layers["user"] == {"state": "empty", "chars": 0, "char_limit": 1375, "entries": 0}
+    assert layers["provider"] == {"state": "empty", "name": "layersprov", "items": 0}
+
+    (home / "memories" / "USER.md").write_bytes(b"\xff\xfe not utf-8 \xff")
+    (home / "layersprov.json").write_text(json.dumps({"broken": True}), encoding="utf-8")
+    layers = client.get("/api/memory").json()["layers"]
+    assert layers["user"]["state"] == "unavailable"
+    assert layers["provider"] == {"state": "unavailable", "name": "layersprov"}  # the provider's read failed
+
+
+@pytest.mark.parametrize("provider, expected", [
+    ("", {"state": "disabled", "name": ""}),  # no provider: no fact store
+    ("plainprov", {"state": "unsupported", "name": "plainprov"}),  # a provider without the optional read
+    ("no-such-provider", {"state": "unavailable", "name": "no-such-provider"}),  # configured but not loadable
+])
+def test_a_provider_that_reports_nothing_is_not_an_empty_store(home, client, provider, expected):
+    _write_home(home, provider=provider)
+    data = client.get("/api/memory").json()
+    assert data["layers"]["provider"] == expected
+    assert {"active", "providers", "builtin_files"} <= set(data)  # what older clients read is still there
+
+
+def test_each_profile_reports_its_own_layers(home, client):
+    _write_home(home)
+    _write_home(home / "profiles" / "work", provider="", user="Work profile: writes Rust", notes="")
+    work = client.get("/api/memory?profile=work").json()["layers"]
+    assert work["user"]["chars"] == len("Work profile: writes Rust") and work["provider"]["state"] == "disabled"
+    default = client.get("/api/memory?profile=default").json()["layers"]
+    assert default["user"]["entries"] == 2 and default["provider"]["name"] == "layersprov"
