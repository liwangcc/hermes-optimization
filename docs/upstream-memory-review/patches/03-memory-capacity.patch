index 00000000..1f0dd45e
--- /dev/null
+++ b/hermes_cli/web_routers/memory_layers.py
@@ -0,0 +1,95 @@
+"""Memory capacity by layer, the ``layers`` of ``GET /api/memory``: USER.md, MEMORY.md and the provider's store.
+
+Only reads. Each layer carries its own state and only the limits something enforces.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Optional
+
+from hermes_cli.web_deps import late
+from hermes_cli.web_server_memory import _normalize_memory_provider_name
+
+_log = logging.getLogger("hermes_cli.web_server")
+
+# Late-bound so a test's monkeypatch on the owning module wins at call time.
+_load_memory_provider = late("_load_memory_provider", "hermes_cli.web_server_memory")
+get_hermes_home = late("get_hermes_home", "hermes_cli.config")
+builtin_memory_layers = late("builtin_memory_layers", "tools.memory_tool")
+
+_BUDGET_TEXT, _BUDGET_INT = ("key", "label", "unit"), ("used", "limit", "listed", "eligible")
+
+
+def _is_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def layer_state(enabled: bool, readable: bool, count: Optional[int]) -> str:
+    """``disabled`` (switched off), ``unavailable`` (could not be read), ``empty`` or ``ok``: never all "zero"."""
+    if not enabled:
+        return "disabled"
+    if not readable:
+        return "unavailable"
+    return "ok" if count else "empty"
+
+
+def active_provider(config: dict[str, Any]) -> str:
+    section = config.get("memory")
+    return _normalize_memory_provider_name(section.get("provider")) if isinstance(section, dict) else ""
+
+
+def provider_read(active: str, method: str) -> tuple[str, dict[str, Any]]:
+    """``(state, report)`` of the active provider's optional read *method*: ``disabled`` (no provider is
+    configured), ``unavailable`` (it did not load, or the read failed), ``unsupported`` (it reports nothing)."""
+    if not active:
+        return "disabled", {}
+    provider = _load_memory_provider(active, register_skills=False)
+    if provider is None:
+        return "unavailable", {}
+    try:
+        report = getattr(provider, method)(str(get_hermes_home()))
+    except Exception:  # health: allow BLE001 -- a plugin's read may raise anything; the layer then reads as unavailable
+        _log.warning("memory provider %s failed in %s()", active, method, exc_info=True)
+        return "unavailable", {}
+    return ("ok", report) if isinstance(report, dict) and report else ("unsupported", {})
+
+
+def _budget(raw: Any) -> Optional[dict[str, Any]]:
+    """One provider-enforced budget, or None when it does not say how much of what is used."""
+    if not isinstance(raw, dict) or not _is_int(raw.get("used")) or not _is_int(raw.get("limit")):
+        return None
+    budget: dict[str, Any] = {"enabled": raw.get("enabled") is not False}
+    budget.update({k: str(raw[k]) for k in _BUDGET_TEXT if raw.get(k)})
+    budget.update({k: raw[k] for k in _BUDGET_INT if _is_int(raw.get(k))})
+    return budget
+
+
+def builtin_layers(config: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    """USER.md and MEMORY.md as the store reads them, each with its ``state``."""
+    layers = builtin_memory_layers(config)
+    for layer in layers.values():
+        layer["state"] = layer_state(layer["enabled"], layer["readable"], len(layer["entries"]))
+    return layers
+
+
+def memory_layers(config: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    """USER.md, MEMORY.md and the provider's store, each with its own state and only the limits something
+    enforces: the built-in files' character caps, and whatever budgets the provider reports."""
+    layers: dict[str, dict[str, Any]] = {
+        name: {"state": layer["state"], "chars": layer["chars"], "char_limit": layer["char_limit"],
+               "entries": len(layer["entries"])}
+        for name, layer in builtin_layers(config).items()
+    }
+    active = active_provider(config)
+    state, report = provider_read(active, "usage_report")
+    provider: dict[str, Any] = {"state": state, "name": active}
+    if state == "ok":
+        provider.update({k: report[k] for k in ("items", "storage_bytes") if _is_int(report.get(k))})
+        budgets = [b for b in map(_budget, report.get("budgets") or []) if b]
+        if budgets:
+            provider["budgets"] = budgets
+        if provider.get("items") == 0:
+            provider["state"] = "empty"
+    layers["provider"] = provider
+    return layers
