@@ -0,0 +1,41 @@
+// Memory capacity by layer: `GET /api/memory` → `layers`.
+
+/** Never all "zero": `disabled` is switched off, `empty` holds nothing,
+ *  `unavailable` could not be read, `unsupported` reports nothing. */
+export type MemoryLayerState = 'disabled' | 'empty' | 'ok' | 'unavailable' | 'unsupported'
+
+/** USER.md or MEMORY.md against the character cap Hermes enforces on writes. */
+export interface BuiltinMemoryLayer {
+  state: MemoryLayerState
+  chars: number
+  char_limit: number
+  entries: number
+}
+
+/** A budget the provider itself enforces, counted the way it enforces it. */
+export interface MemoryBudget {
+  key?: string
+  label?: string
+  /** e.g. "estimated tokens": the provider's own count, not model input. */
+  unit?: string
+  enabled: boolean
+  used: number
+  limit: number
+  listed?: number
+  eligible?: number
+}
+
+/** The active provider's store. No ceiling: only what the provider reports. */
+export interface ProviderMemoryLayer {
+  state: MemoryLayerState
+  name: string
+  items?: number
+  storage_bytes?: number
+  budgets?: MemoryBudget[]
+}
+
+export interface MemoryLayers {
+  user: BuiltinMemoryLayer
+  memory: BuiltinMemoryLayer
+  provider: ProviderMemoryLayer
+}
