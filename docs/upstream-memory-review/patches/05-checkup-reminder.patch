diff --git a/apps/desktop/src/store/memory-checkup-reminder.test.ts b/apps/desktop/src/store/memory-checkup-reminder.test.ts
new file mode 100644
index 00000000..bbd5f54e
--- /dev/null
+++ b/apps/desktop/src/store/memory-checkup-reminder.test.ts
@@ -0,0 +1,290 @@
+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type * as CheckupStore from './memory-checkup'
+import type * as ReminderStore from './memory-checkup-reminder'
+
+const mocks = vi.hoisted(() => {
+  const makeAtom = <T>(initial: T) => {
+    let value = initial
+    const listeners = new Set<(value: T) => void>()
+
+    return {
+      get: () => value,
+      listen(listener: (value: T) => void) {
+        listeners.add(listener)
+
+        return () => listeners.delete(listener)
+      },
+      set(next: T) {
+        value = next
+
+        for (const listener of listeners) {
+          listener(value)
+        }
+      },
+      subscribe(listener: (value: T) => void) {
+        listener(value)
+
+        return this.listen(listener)
+      }
+    }
+  }
+
+  return {
+    activeProfile: makeAtom('default'),
+    apiScope: makeAtom<{ connectionId: null | string; profile: null | string }>({ connectionId: null, profile: null }),
+    gatewayState: makeAtom<'closed' | 'open'>('closed'),
+    runMemoryCheckup: vi.fn()
+  }
+})
+
+vi.mock('@/api/client', () => ({
+  $apiRequestScope: mocks.apiScope,
+  resolveOwnerNow: () => ({ connectionId: mocks.apiScope.get().connectionId, profile: mocks.activeProfile.get() })
+}))
+
+vi.mock('@/api/system', () => ({ runMemoryCheckup: mocks.runMemoryCheckup }))
+
+vi.mock('@/i18n', () => ({ translateNow: (key: string) => key }))
+
+vi.mock('@/store/notifications', () => ({
+  readableError: (error: unknown, fallback: string) => ({ message: fallback, detail: String((error as Error).message) })
+}))
+
+vi.mock('@/store/profile', () => ({
+  $activeGatewayProfile: mocks.activeProfile,
+  normalizeProfileKey: (name: null | string | undefined) => (name ?? '').trim() || 'default'
+}))
+
+vi.mock('@/store/session', () => ({ $gatewayState: mocks.gatewayState }))
+
+type Store = typeof CheckupStore & typeof ReminderStore
+
+const DAY = 24 * 60 * 60 * 1000
+const T0 = Date.UTC(2026, 0, 1, 9)
+
+// One Desktop window: its own module state over the storage every window shares.
+async function openWindow(): Promise<Store> {
+  vi.resetModules()
+
+  const reminder = await import('./memory-checkup-reminder')
+  const checkup = await import('./memory-checkup')
+
+  reminder.startMemoryCheckupReminder()
+
+  return { ...checkup, ...reminder }
+}
+
+let app: Store
+
+beforeEach(async () => {
+  vi.useFakeTimers({ toFake: ['Date', 'setInterval', 'clearInterval'] })
+  vi.setSystemTime(T0)
+  window.localStorage.clear()
+  mocks.activeProfile.set('default')
+  mocks.apiScope.set({ connectionId: null, profile: null })
+  mocks.gatewayState.set('open')
+  mocks.runMemoryCheckup.mockReset()
+  app = await openWindow()
+})
+
+afterEach(() => {
+  app.stopMemoryCheckupReminder()
+  vi.useRealTimers()
+})
+
+describe('memory checkup reminder', () => {
+  it('is off until the user turns it on, and then offers 10 or 14 days with 14 as the default', () => {
+    vi.setSystemTime(T0 + 400 * DAY)
+    app.checkMemoryCheckupDue()
+    expect(app.$memoryCheckupReminder.get()).toEqual({ enabled: false, intervalDays: 14, dueAt: null, pending: false })
+
+    expect(app.REMINDER_INTERVAL_DAYS).toEqual([10, 14])
+    app.setMemoryCheckupReminder({ enabled: true })
+    expect(app.$memoryCheckupReminder.get()).toMatchObject({ enabled: true, intervalDays: 14, pending: false })
+    expect(app.$memoryCheckupReminder.get().dueAt).toBe(Date.now() + 14 * DAY)
+
+    app.setMemoryCheckupReminder({ intervalDays: 10 })
+    expect(app.$memoryCheckupReminder.get().dueAt).toBe(Date.now() + 10 * DAY)
+  })
+
+  it('shows one reminder when it came due while the app was closed, and starts the next interval when shown', async () => {
+    app.setMemoryCheckupReminder({ enabled: true })
+    app.stopMemoryCheckupReminder()
+
+    // Closed across almost three intervals: one reminder, not three.
+    vi.setSystemTime(T0 + 40 * DAY)
+    app = await openWindow()
+    expect(app.$memoryCheckupReminder.get()).toMatchObject({ enabled: true, pending: true })
+
+    // On screen: the next one is due 14 days from now, not from the date that passed.
+    app.markMemoryCheckupReminderShown()
+    expect(app.$memoryCheckupReminder.get()).toEqual({
+      enabled: true,
+      intervalDays: 14,
+      dueAt: T0 + 54 * DAY,
+      pending: true
+    })
+  })
+
+  it('starts the interval when the reminder is first shown, not while it waits behind another offer', () => {
+    app.setMemoryCheckupReminder({ enabled: true })
+    vi.setSystemTime(T0 + 14 * DAY)
+    app.checkMemoryCheckupDue()
+
+    // Pending, but another offer holds the composer slot for two days: the clock has not moved.
+    vi.setSystemTime(T0 + 16 * DAY)
+    app.checkMemoryCheckupDue()
+    expect(app.$memoryCheckupReminder.get()).toMatchObject({ dueAt: T0 + 14 * DAY, pending: true })
+
+    app.markMemoryCheckupReminderShown()
+    expect(app.$memoryCheckupReminder.get()).toMatchObject({ dueAt: T0 + 30 * DAY, pending: true })
+  })
+
+  it('keeps the reminder and its clock across a restart, a rerender and the hourly check', async () => {
+    app.setMemoryCheckupReminder({ enabled: true })
+    vi.setSystemTime(T0 + 15 * DAY)
+    app.checkMemoryCheckupDue()
+    app.markMemoryCheckupReminderShown()
+
+    const shown = app.$memoryCheckupReminder.get()
+    const seen: unknown[] = []
+
+    app.$memoryCheckupReminder.listen(value => seen.push(value))
+
+    // The strip mounts again (a rerender, a second composer) and the hourly check runs: nothing moves.
+    vi.setSystemTime(T0 + 15 * DAY + 3_600_000)
+    app.markMemoryCheckupReminderShown()
+    app.checkMemoryCheckupDue()
+    vi.advanceTimersByTime(3 * 3_600_000)
+    expect(app.$memoryCheckupReminder.get()).toBe(shown)
+    expect(seen).toEqual([])
+
+    app.stopMemoryCheckupReminder()
+    app = await openWindow()
+    app.markMemoryCheckupReminderShown()
+    expect(app.$memoryCheckupReminder.get()).toEqual(shown)
+  })
+
+  it('becomes due while the app stays open, without waiting for a restart', () => {
+    app.setMemoryCheckupReminder({ enabled: true, intervalDays: 10 })
+
+    vi.setSystemTime(T0 + 10 * DAY - 1)
+    vi.advanceTimersByTime(3_600_000)
+
+    expect(app.$memoryCheckupReminder.get().pending).toBe(true)
+  })
+
+  it('does not move the clock again from a second window, and an answer in one window reaches the other', async () => {
+    app.setMemoryCheckupReminder({ enabled: true })
+    vi.setSystemTime(T0 + 20 * DAY)
+    app.checkMemoryCheckupDue()
+    app.markMemoryCheckupReminderShown()
+
+    const first = app
+    const due = first.$memoryCheckupReminder.get().dueAt
+
+    vi.setSystemTime(T0 + 20 * DAY + 60_000)
+
+    const second = await openWindow()
+
+    second.markMemoryCheckupReminderShown()
+    expect(second.$memoryCheckupReminder.get()).toEqual({ enabled: true, intervalDays: 14, dueAt: due, pending: true })
+
+    second.dismissMemoryCheckupReminder()
+    window.dispatchEvent(new StorageEvent('storage', { key: 'hermes:memory-checkup-reminder:local::default' }))
+
+    expect(first.$memoryCheckupReminder.get()).toEqual({ enabled: true, intervalDays: 14, dueAt: due, pending: false })
+    second.stopMemoryCheckupReminder()
+  })
+
+  it('"Next time" takes the reminder away without a model call, a recorded checkup or a new clock', () => {
+    app.setMemoryCheckupReminder({ enabled: true })
+    vi.setSystemTime(T0 + 14 * DAY)
+    app.checkMemoryCheckupDue()
+    app.markMemoryCheckupReminderShown()
+
+    const due = app.$memoryCheckupReminder.get().dueAt
+
+    vi.setSystemTime(T0 + 14 * DAY + 60_000)
+    app.dismissMemoryCheckupReminder()
+
+    expect(app.$memoryCheckupReminder.get()).toEqual({ enabled: true, intervalDays: 14, dueAt: due, pending: false })
+    expect(mocks.runMemoryCheckup).not.toHaveBeenCalled()
+    expect(app.$memoryCheckupRun.get()).toEqual({ status: 'idle' })
+
+    // Still dismissed on the next check: the cycle is not replayed.
+    vi.setSystemTime(T0 + 14 * DAY + 3_600_000)
+    app.checkMemoryCheckupDue()
+    expect(app.$memoryCheckupReminder.get().pending).toBe(false)
+  })
+
+  it('keeps one clock per connection and profile', () => {
+    app.setMemoryCheckupReminder({ enabled: true, intervalDays: 10 })
+
+    mocks.activeProfile.set('work')
+    expect(app.$memoryCheckupReminder.get()).toEqual({ enabled: false, intervalDays: 14, dueAt: null, pending: false })
+
+    // Due on "default" while "work" is in view: nothing shows, and the clock of "default" has not moved.
+    vi.setSystemTime(T0 + 30 * DAY)
+    app.checkMemoryCheckupDue()
+    app.markMemoryCheckupReminderShown()
+    expect(app.$memoryCheckupReminder.get().pending).toBe(false)
+
+    mocks.apiScope.set({ connectionId: 'remote-1', profile: null })
+    mocks.activeProfile.set('default')
+    expect(app.$memoryCheckupReminder.get().enabled).toBe(false)
+
+    mocks.apiScope.set({ connectionId: null, profile: null })
+    expect(app.$memoryCheckupReminder.get()).toEqual({
+      enabled: true,
+      intervalDays: 10,
+      dueAt: T0 + 10 * DAY,
+      pending: true
+    })
+  })
+
+  it('does not raise a reminder before the gateway says which profile is in view', async () => {
+    app.setMemoryCheckupReminder({ enabled: true })
+    app.stopMemoryCheckupReminder()
+    mocks.gatewayState.set('closed')
+    vi.setSystemTime(T0 + 20 * DAY)
+    app = await openWindow()
+
+    expect(app.$memoryCheckupReminder.get().pending).toBe(false)
+    expect(JSON.parse(window.localStorage.getItem('hermes:memory-checkup-reminder:local::default')!).pending).toBe(false)
+
+    mocks.gatewayState.set('open')
+    expect(app.$memoryCheckupReminder.get().pending).toBe(true)
+  })
+
+  it('moves the clock of a renamed profile and drops the clock of a deleted one', () => {
+    app.setMemoryCheckupReminder({ enabled: true })
+    app.migrateMemoryCheckupReminder('default', 'main')
+
+    mocks.activeProfile.set('main')
+    expect(app.$memoryCheckupReminder.get().enabled).toBe(true)
+
+    app.dropMemoryCheckupReminder('main')
+    app.checkMemoryCheckupDue()
+    expect(app.$memoryCheckupReminder.get().enabled).toBe(false)
+  })
+
+  it('"Review now" answers a waiting reminder, also one that was never shown, and starts its clock then', () => {
+    app.setMemoryCheckupReminder({ enabled: true })
+    vi.setSystemTime(T0 + 20 * DAY)
+    app.checkMemoryCheckupDue()
+
+    app.dismissMemoryCheckupReminder()
+
+    expect(app.$memoryCheckupReminder.get()).toEqual({
+      enabled: true,
+      intervalDays: 14,
+      dueAt: T0 + 34 * DAY,
+      pending: false
+    })
+    app.checkMemoryCheckupDue()
+    expect(app.$memoryCheckupReminder.get().pending).toBe(false)
+  })
+})
diff --git a/apps/desktop/src/store/memory-checkup-reminder.ts b/apps/desktop/src/store/memory-checkup-reminder.ts
new file mode 100644
index 00000000..7354a330
--- /dev/null
+++ b/apps/desktop/src/store/memory-checkup-reminder.ts
@@ -0,0 +1,213 @@
+import { LOCAL_CONNECTION_ID } from '@hermes/shared'
+import { atom } from 'nanostores'
+
+import { $apiRequestScope } from '@/api/client'
+import { readJson, writeJson } from '@/lib/storage'
+import { $activeGatewayProfile } from '@/store/profile'
+import { $gatewayState } from '@/store/session'
+
+import { checkupScopeFor, memoryCheckupScope } from './memory-checkup'
+
+// The memory checkup's opt-in reminder: a clock kept per (connection, profile)
+// on this device. No cron, no background model turn, nothing in the system
+// prompt: the reminder is this app's alone.
+
+const KEY_PREFIX = 'hermes:memory-checkup-reminder:'
+const DAY_MS = 24 * 60 * 60 * 1000
+const CHECK_INTERVAL_MS = 60 * 60 * 1000
+
+export const REMINDER_INTERVAL_DAYS = [10, 14] as const
+export type ReminderIntervalDays = (typeof REMINDER_INTERVAL_DAYS)[number]
+export const DEFAULT_REMINDER_INTERVAL_DAYS: ReminderIntervalDays = 14
+
+export interface MemoryCheckupReminder {
+  enabled: boolean
+  intervalDays: ReminderIntervalDays
+  /** When the next reminder is due (epoch ms); null while off. */
+  dueAt: null | number
+  /** A reminder waits for the user's answer: on screen, or queued behind another offer. */
+  pending: boolean
+}
+
+const OFF: MemoryCheckupReminder = {
+  enabled: false,
+  intervalDays: DEFAULT_REMINDER_INTERVAL_DAYS,
+  dueAt: null,
+  pending: false
+}
+
+function readReminder(scope: string): MemoryCheckupReminder {
+  const stored = readJson<Partial<MemoryCheckupReminder>>(KEY_PREFIX + scope)
+
+  if (!stored || typeof stored !== 'object') {
+    return OFF
+  }
+
+  const intervalDays = REMINDER_INTERVAL_DAYS.find(days => days === stored.intervalDays) ?? OFF.intervalDays
+  const dueAt = typeof stored.dueAt === 'number' && Number.isFinite(stored.dueAt) ? stored.dueAt : null
+  const enabled = stored.enabled === true && dueAt !== null
+
+  return { enabled, intervalDays, dueAt: enabled ? dueAt : null, pending: enabled && stored.pending === true }
+}
+
+export const $memoryCheckupReminder = atom<MemoryCheckupReminder>(OFF)
+
+function show(next: MemoryCheckupReminder): void {
+  const shown = $memoryCheckupReminder.get()
+
+  // Reference identity on no-ops: an hourly check must not repaint the strip.
+  if (JSON.stringify(shown) !== JSON.stringify(next)) {
+    $memoryCheckupReminder.set(next)
+  }
+}
+
+function save(scope: string, next: MemoryCheckupReminder): void {
+  writeJson(KEY_PREFIX + scope, next.enabled || next.intervalDays !== OFF.intervalDays ? next : null)
+
+  if (scope === memoryCheckupScope()) {
+    show(next)
+  }
+}
+
+/**
+ * A due reminder becomes pending: one reminder, however many intervals passed
+ * while the app was closed. The clock does not move here; it moves when the
+ * reminder is actually shown (below), which can be later when another offer
+ * holds the composer's one slot.
+ */
+export function checkMemoryCheckupDue(now = Date.now()): void {
+  const scope = memoryCheckupScope()
+  const stored = readReminder(scope)
+
+  if (stored.enabled && !stored.pending && stored.dueAt !== null && now >= stored.dueAt) {
+    save(scope, { ...stored, pending: true })
+  } else {
+    show(stored)
+  }
+}
+
+/**
+ * The reminder is on screen: the next interval starts now, when it is first
+ * shown, not when a checkup completes. The read is fresh from storage, so a
+ * rerender, a reload or another window finds the due date already in the
+ * future and changes nothing.
+ */
+// shortcut: localStorage has no cross-window transaction; two windows that first show it within the same few
+// milliseconds both write a due date, a moment apart. Move the clock to the main process if that must be exact.
+export function markMemoryCheckupReminderShown(now = Date.now()): void {
+  const scope = memoryCheckupScope()
+  const stored = readReminder(scope)
+
+  if (stored.pending && stored.dueAt !== null && now >= stored.dueAt) {
+    save(scope, { ...stored, dueAt: now + stored.intervalDays * DAY_MS })
+  }
+}
+
+/** The user's setting. Turning it on or changing the interval starts the clock from now. */
+export function setMemoryCheckupReminder(
+  change: { enabled?: boolean; intervalDays?: ReminderIntervalDays },
+  now = Date.now()
+): void {
+  const scope = memoryCheckupScope()
+  const current = readReminder(scope)
+  const enabled = change.enabled ?? current.enabled
+  const intervalDays = change.intervalDays ?? current.intervalDays
+
+  save(scope, {
+    enabled,
+    intervalDays,
+    dueAt: enabled ? now + intervalDays * DAY_MS : null,
+    pending: enabled && current.pending
+  })
+}
+
+/** "Next time", and the first half of "Review now" (on the strip or in
+ *  Maintenance): the reminder leaves the screen and no checkup is recorded. The
+ *  clock moved when it was shown; one answered before it ever was starts it now. */
+export function dismissMemoryCheckupReminder(now = Date.now()): void {
+  const scope = memoryCheckupScope()
+  const current = readReminder(scope)
+
+  if (current.pending && current.dueAt !== null) {
+    const dueAt = now >= current.dueAt ? now + current.intervalDays * DAY_MS : current.dueAt
+
+    save(scope, { ...current, dueAt, pending: false })
+  }
+}
+
+/** Rename counterpart (local connection only, like the tiles it joins). */
+export function migrateMemoryCheckupReminder(from: string, to: string): void {
+  const stored = readJson<unknown>(KEY_PREFIX + checkupScopeFor(LOCAL_CONNECTION_ID, from))
+
+  writeJson(KEY_PREFIX + checkupScopeFor(LOCAL_CONNECTION_ID, to), stored)
+  writeJson(KEY_PREFIX + checkupScopeFor(LOCAL_CONNECTION_ID, from), null)
+}
+
+/** A deleted profile's clock, so a later profile of the same name starts without one. */
+export function dropMemoryCheckupReminder(profile: string, connectionId?: string): void {
+  writeJson(KEY_PREFIX + checkupScopeFor(connectionId ?? $apiRequestScope.get().connectionId, profile), null)
+}
+
+let stop: (() => void) | null = null
+
+/** Wire the reminder to gateway/profile state. Idempotent. */
+export function startMemoryCheckupReminder(): void {
+  if (stop || typeof window === 'undefined') {
+    return
+  }
+
+  let timer: null | ReturnType<typeof setInterval> = null
+
+  const disarm = () => {
+    if (timer !== null) {
+      clearInterval(timer)
+      timer = null
+    }
+  }
+
+  // Only while the gateway is connected: before that the profile in view is
+  // not known, and the wrong profile's reminder would be raised.
+  const arm = () => {
+    disarm()
+
+    if ($gatewayState.get() === 'open') {
+      checkMemoryCheckupDue()
+      timer = setInterval(() => checkMemoryCheckupDue(), CHECK_INTERVAL_MS)
+    } else {
+      show(OFF)
+    }
+  }
+
+  // Another window answered or changed it: show what is stored, move nothing.
+  const onStorage = (event: StorageEvent) => {
+    if (event.key === KEY_PREFIX + memoryCheckupScope() && $gatewayState.get() === 'open') {
+      show(readReminder(memoryCheckupScope()))
+    }
+  }
+
+  let observedConnection = $apiRequestScope.get().connectionId
+
+  const offs = [
+    $gatewayState.subscribe(arm),
+    $activeGatewayProfile.listen(arm),
+    $apiRequestScope.listen(({ connectionId }) => {
+      if (connectionId !== observedConnection) {
+        observedConnection = connectionId
+        arm()
+      }
+    })
+  ]
+
+  window.addEventListener('storage', onStorage)
+
+  stop = () => {
+    disarm()
+    offs.forEach(off => off())
+    window.removeEventListener('storage', onStorage)
+    stop = null
+  }
+}
+
+export function stopMemoryCheckupReminder(): void {
+  stop?.()
+}
