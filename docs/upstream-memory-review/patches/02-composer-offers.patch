+++ b/apps/desktop/src/app/chat/composer/status-stack/offers.tsx
@@ -0,0 +1,29 @@
+import { useStore } from '@nanostores/react'
+import type { ReactNode } from 'react'
+
+import { FreeTierNoticeStrip, useFreeTierNoticeOwner } from '@/components/free-tier/notice-strip'
+import { SharedMetricsConsentStrip } from '@/components/shared-metrics/consent-strip'
+import { $freeTierRoute, $freeTierStatus, freeTierStripPending } from '@/store/free-tier'
+import { $sharedMetricsConsent, sharedMetricsOfferPending } from '@/store/shared-metrics'
+
+// In the order they are offered: the metrics question waits for the free-tier notice.
+const OFFERS: readonly { key: string; node: ReactNode }[] = [
+  { key: 'free-tier', node: <FreeTierNoticeStrip /> },
+  { key: 'shared-metrics', node: <SharedMetricsConsentStrip /> }
+]
+
+/**
+ * The one offer this composer shows, if any. One claimed owner across every
+ * mounted composer, so a split view shows it once and a non-owning stack adds
+ * no empty row to its card; one offer at a time.
+ */
+export function useComposerOffer(): { key: string; node: ReactNode } | undefined {
+  const owns = useFreeTierNoticeOwner()
+  const freeTierStatus = useStore($freeTierStatus)
+  const freeTierRoute = useStore($freeTierRoute)
+  const sharedMetricsConsent = useStore($sharedMetricsConsent)
+
+  const pending = [freeTierStripPending(freeTierStatus, freeTierRoute), sharedMetricsOfferPending(sharedMetricsConsent)]
+
+  return owns ? OFFERS[pending.indexOf(true)] : undefined
+}
