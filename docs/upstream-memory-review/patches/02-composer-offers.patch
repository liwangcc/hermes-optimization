diff --git a/apps/desktop/src/app/chat/composer/status-stack/offers.test.tsx b/apps/desktop/src/app/chat/composer/status-stack/offers.test.tsx
new file mode 100644
index 00000000..4a53b6a3
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/status-stack/offers.test.tsx
@@ -0,0 +1,53 @@
+import { act, renderHook } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { $freeTierRoute, $freeTierStatus } from '@/store/free-tier'
+import { markOnboardingDecided } from '@/store/onboarding-presence'
+import { $sharedMetricsConsent } from '@/store/shared-metrics'
+
+import { useComposerOffer } from './offers'
+
+const owner = vi.hoisted(() => ({ owns: true }))
+
+vi.mock('@/components/free-tier/notice-strip', () => ({
+  FreeTierNoticeStrip: () => null,
+  useFreeTierNoticeOwner: () => owner.owns
+}))
+
+type FreeTierStatus = NonNullable<ReturnType<typeof $freeTierStatus.get>>
+
+const notice = (pending: boolean) => ({ has_guest: true, notice_pending: pending }) as FreeTierStatus
+const consent = (decided: boolean) => ({ decided }) as NonNullable<ReturnType<typeof $sharedMetricsConsent.get>>
+
+beforeEach(() => {
+  owner.owns = true
+  markOnboardingDecided() // first-run onboarding is done: the free-tier notice may show
+  $freeTierRoute.set(false)
+  $freeTierStatus.set(notice(false))
+  $sharedMetricsConsent.set(null)
+})
+
+describe('composer offers', () => {
+  it('shows one offer at a time, and the metrics question waits for the free-tier notice', () => {
+    const { result } = renderHook(() => useComposerOffer())
+
+    expect(result.current).toBeUndefined()
+
+    act(() => $sharedMetricsConsent.set(consent(false)))
+    expect(result.current?.key).toBe('shared-metrics')
+
+    act(() => $freeTierStatus.set(notice(true)))
+    expect(result.current?.key).toBe('free-tier')
+
+    // Acknowledged: the question, still unanswered, takes the slot back.
+    act(() => $freeTierStatus.set(notice(false)))
+    expect(result.current?.key).toBe('shared-metrics')
+  })
+
+  it('shows nothing in a composer that does not own the slot', () => {
+    owner.owns = false
+    $sharedMetricsConsent.set(consent(false))
+
+    expect(renderHook(() => useComposerOffer()).result.current).toBeUndefined()
+  })
+})
diff --git a/apps/desktop/src/app/chat/composer/status-stack/offers.tsx b/apps/desktop/src/app/chat/composer/status-stack/offers.tsx
new file mode 100644
index 00000000..5963e331
