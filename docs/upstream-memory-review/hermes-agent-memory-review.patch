+    })
+    render(<MemoryCheckupPanel />)
+    fireEvent.click(screen.getByRole('button', { name: 'Review now' }))
+
+    await screen.findByText('Nothing to review: no layer holds any entries.')
+    expect(within_('memory-checkup-facts').getByText('This provider does not offer its facts for review.')).toBeTruthy()
+    expect(screen.queryByRole('button', { name: 'Add selected to chat' })).toBeNull()
+  })
+
+  it('offers the reminder as an opt-in, with 10 and 14 days and 14 chosen first', () => {
