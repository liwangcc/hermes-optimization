+def builtin_memory_layers(config: Optional[dict[str, Any]] = None) -> dict[str, dict[str, Any]]:
+    """``{"memory" | "user": {"enabled", "readable", "entries", "chars", "char_limit"}}`` as the store would
+    load them: the same parse, de-duplication and count writes are refused by. A read for displays and
+    reviews, so unlike ``load_on_disk_store`` it creates no directory, logs nothing and scans nothing.
+    ``readable`` is False when the file exists but cannot be decoded."""
+    section = get_builtin_memory_config(config)
+    enabled = dict(zip(("memory", "user"), get_builtin_memory_store_flags(config)))
+    limits = {"memory": int(section.get("memory_char_limit", 2200)), "user": int(section.get("user_char_limit", 1375))}
+    layers = {}
+    for target in ("memory", "user"):
+        raw, readable = MemoryStore._read_raw_checked(MemoryStore._path_for(target))
+        entries = list(dict.fromkeys(MemoryStore._parse_entries(raw)))
+        layers[target] = {"enabled": enabled[target], "readable": readable, "entries": entries,
+                          "chars": len(ENTRY_DELIMITER.join(entries)), "char_limit": limits[target]}
+    return layers
+
