+import * as fs from 'node:fs'
+import * as path from 'node:path'
+
+import type { Page } from '@playwright/test'
+
+import { writeEnvFile, writeMockProviderConfig } from '../../../tests-js/scripts/mock-provider-config'
+import { startMockServer } from '../../../tests-js/scripts/mock-server'
+
+import { buildAppEnv, createSandbox, launchDesktop, type MockBackendFixture, waitForAppReady } from './fixtures'
+import { expect, test } from './test'
+
+// Real Electron, a real `hermes serve`, a provider plugin loaded through real discovery, and the job run by the
+// real `hermes memory action` process the backend starts. The job indexes items into a file in the sandbox home.
+
+const ITEMS = ['alpha', 'beta', 'gamma', 'delta', 'epsilon']
+
+const SCHEMA = `
+from plugins.memory.config_schema import KIND_TEXT, ProviderConfigSchema, ProviderField
+
+CONFIG_SCHEMA = ProviderConfigSchema(
+    name="jobprov", label="Job provider",
+    fields=(ProviderField("index_url", "Index address", KIND_TEXT, default="http://127.0.0.1:1", inline=True),),
+)
+`
+
+const PROVIDER = `
+import json
+import time
+from pathlib import Path
+
+from agent.memory_provider import MemoryProvider
+
+
+class JobProv(MemoryProvider):
+    @property
+    def name(self):
+        return "jobprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        pass
+
+    def get_tool_schemas(self):
+        return []
+
+    def _state(self, home):
+        items = json.loads(Path(home, "jobprov.json").read_text(encoding="utf-8"))
+        index = Path(home, "jobprov.index.json")
+        return items, (json.loads(index.read_text(encoding="utf-8")) if index.exists() else []), index
+
+    def maintenance_actions(self, hermes_home):
+        items, done, _ = self._state(hermes_home)
+        return [{"id": "index", "label": "Build index", "description": "Index every stored item.",
+                 "status": f"{len(done)} of {len(items)} items indexed", "ready": True}]
+
+    def run_maintenance_step(self, action_id, hermes_home):
+        items, done, index = self._state(hermes_home)
+        time.sleep(0.4)  # one batch takes a moment: the Desktop shows the job running
+        done = items[: len(done) + 2]
+        index.write_text(json.dumps(done), encoding="utf-8")
+        status = f"{len(done)} of {len(items)} items indexed"
+        if len(done) == len(items):
+            return {"done": True, "status": status, "result": f"All {len(items)} items are indexed."}
+        return {"done": False, "status": status}
+
+
+def register(ctx):
+    ctx.register_memory_provider(JobProv())
+`
+
+function seed(hermesHome: string): void {
+  const dir = path.join(hermesHome, 'plugins', 'jobprov')
+
+  fs.mkdirSync(dir, { recursive: true })
+  fs.writeFileSync(path.join(dir, '__init__.py'), PROVIDER, 'utf8')
+  fs.writeFileSync(path.join(dir, 'config_schema.py'), SCHEMA, 'utf8')
+  fs.writeFileSync(path.join(hermesHome, 'jobprov.json'), JSON.stringify(ITEMS), 'utf8')
+}
+
+const openRoute = (page: Page, route: string) => page.evaluate(hash => void (window.location.hash = hash), `#${route}`)
+
+test('a provider job runs from its settings to the end and says how it ended', async () => {
+  test.setTimeout(240_000)
+
+  const testInfo = test.info()
+  const mock = await startMockServer({ replyForPrompt: () => 'ok' })
+  const sandbox = createSandbox('memory-provider-jobs')
+
+  seed(sandbox.hermesHome)
+  writeMockProviderConfig(sandbox.hermesHome, mock.url, 'language: en\n', 'memory:\n  provider: jobprov\n')
+  writeEnvFile(sandbox.hermesHome)
+
+  const { app, page } = await launchDesktop(buildAppEnv(sandbox))
+
+  const fixture: MockBackendFixture = {
+    app,
+    page,
+    mock,
+    mockUrl: mock.url,
+    sandbox,
+    cleanup: async () => {
+      await app.close().catch(() => undefined)
+      await mock.close()
+      sandbox.cleanup()
+    }
+  }
+
+  try {
+    await waitForAppReady(fixture)
+    await openRoute(page, '/settings?tab=config:memory')
+
+    const jobs = page.getByTestId('provider-jobs')
+
+    await expect(jobs.getByText('0 of 5 items indexed')).toBeVisible({ timeout: 60_000 })
+    expect(fs.existsSync(path.join(sandbox.hermesHome, 'jobprov.index.json'))).toBe(false)
+
+    await jobs.getByRole('button', { name: 'Run' }).click()
+
+    const output = page.getByTestId('provider-job-output')
+
+    await expect(output.getByRole('status')).toHaveText('Finished.', { timeout: 120_000 })
+    await expect(output).toContainText('2 of 5 items indexed')
+    await expect(output).toContainText('All 5 items are indexed.')
+    // Read again once the job ended: the list says where it stands now.
+    await expect(jobs.getByText('5 of 5 items indexed', { exact: true })).toBeVisible()
+    expect(JSON.parse(fs.readFileSync(path.join(sandbox.hermesHome, 'jobprov.index.json'), 'utf8'))).toEqual(ITEMS)
+
+    await jobs.scrollIntoViewIfNeeded()
+    await page.screenshot({ path: testInfo.outputPath('memory-provider-jobs.png') })
+  } finally {
+    await fixture.cleanup()
+  }
+})
