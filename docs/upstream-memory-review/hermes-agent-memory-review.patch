@@ -0,0 +1,71 @@
+import { LOCAL_CONNECTION_ID } from '@hermes/shared'
+import { atom } from 'nanostores'
+
+import { $apiRequestScope, resolveOwnerNow } from '@/api/client'
+import { runMemoryCheckup } from '@/api/system'
+import { translateNow } from '@/i18n'
+import { isMissingRestEndpoint } from '@/lib/gateway-rpc'
+import { readableError } from '@/store/notifications'
+import { $activeGatewayProfile, normalizeProfileKey } from '@/store/profile'
+import type { MemoryCheckupResponse } from '@/types/memory-checkup'
+
+// Memory checkup: the one run a click starts, kept per (connection, profile).
+// No cron, no background model turn, nothing in the system prompt.
+
+export const checkupScopeFor = (connectionId: null | string | undefined, profile: null | string | undefined) =>
+  `${(connectionId ?? '').trim() || LOCAL_CONNECTION_ID}::${normalizeProfileKey(profile)}`
+
+/** The (connection, profile) the gateway is on: one profile's checkup never answers for another. */
+export const memoryCheckupScope = () => checkupScopeFor($apiRequestScope.get().connectionId, $activeGatewayProfile.get())
+
+export type MemoryCheckupRun =
+  | { status: 'done'; scope: string; result: MemoryCheckupResponse }
+  | { status: 'failed'; scope: string; message: string; detail?: string }
+  | { status: 'idle' }
+  | { status: 'running'; scope: string }
+  | { status: 'unsupported'; scope: string }
+
+/** This window's run. Proposals only: nothing in it has been written. */
+export const $memoryCheckupRun = atom<MemoryCheckupRun>({ status: 'idle' })
+
+let runToken = 0
+
+/**
+ * Only a click calls this. One model call on the backend with no tools; a
+ * failure is a failure the user can retry, never a fall back to a chat.
+ */
+export async function startMemoryCheckup(): Promise<void> {
+  if ($memoryCheckupRun.get().status === 'running') {
+    return
+  }
+
+  // Resolved now: a profile switch while the model works must not move the call or relabel its answer.
+  const owner = resolveOwnerNow()
+  const scope = memoryCheckupScope()
+  const token = ++runToken
+
+  $memoryCheckupRun.set({ status: 'running', scope })
+
+  try {
+    const result = await runMemoryCheckup(owner)
+
+    if (token === runToken) {
+      $memoryCheckupRun.set({ status: 'done', scope, result })
+    }
+  } catch (error) {
+    // A Hermes older than the route: a capability verdict, not a failure to retry. The route has no path
+    // params, so its 404 can mean nothing else.
+    if (token === runToken && isMissingRestEndpoint(error)) {
+      $memoryCheckupRun.set({ status: 'unsupported', scope })
+    } else if (token === runToken) {
+      const { message, detail } = readableError(error, translateNow('memoryCheckup.failed'))
+
+      $memoryCheckupRun.set({ status: 'failed', scope, message, detail })
+    }
+  }
+}
+
+export function clearMemoryCheckupRun(): void {
+  runToken += 1
+  $memoryCheckupRun.set({ status: 'idle' })
+}
