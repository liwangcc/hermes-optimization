@@ -223,6 +223,22 @@ class MemoryProvider(ABC):
         """Write non-secret setup ``values`` to the provider's native config. Plugins MUST either
         override this or use only env vars (every schema field carrying ``env_var``)."""
 
+    # -- Maintenance jobs (Desktop provider settings, ``hermes memory action``). Uninitialized instance, outside any
+    # session, ``hermes_home`` passed in; JSON values only, so they cross ``plugins.isolation: host``. --
+
+    def maintenance_actions(self, hermes_home: str) -> list[dict[str, Any]]:
+        """One-click jobs for the provider's store (building a search index for what is stored, say); ``[]`` (the
+        default) = none. Quick: it runs when the settings page opens. Each: ``{"id", "label", "description",
+        "status", "ready"}``. ``status`` says where the job stands now ("80 of 120 facts indexed"); ``ready`` False,
+        with ``status`` saying why, when it cannot run yet. ``id``: letters, digits, ``-`` and ``_``."""
+        return []
+
+    def run_maintenance_step(self, action_id: str, hermes_home: str) -> dict[str, Any]:
+        """One bounded step of a job from ``maintenance_actions``; Hermes calls it again until ``done``, in a process
+        of its own whose output the Desktop shows. ``{"done": bool, "status": "..."}``, plus ``"result"`` (one line)
+        once done. Raise to fail the job: the message is shown. A step that changes nothing must say ``done``."""
+        raise ValueError(f"memory provider {self.name} has no maintenance action {action_id!r}")
+
     def on_memory_write(self, action: str, target: str, content: str, metadata: Optional[dict[str, Any]] = None) -> None:
         """Mirror a built-in memory-tool write (``action``: add | replace | remove; ``target``:
         memory | user; ``metadata``: provenance such as write_origin, session_id, tool_name).
@@ -265,3 +281,23 @@ class MemoryProvider(ABC):
         returns). Raise ``ValueError`` (a subclass such as ``json.JSONDecodeError`` counts, also under
         ``plugins.isolation: host``) to refuse the save (the dashboard shows it as a 400)."""
         raise NotImplementedError(f"memory provider {self.name} declares storage=provider but cannot write it")
+
+    # -- Memory reads for displays and the checkup (``GET /api/memory``, ``POST /api/memory/checkup``).
+    # Uninitialized instance: read the profile at ``hermes_home`` and nothing else, change nothing, no
+    # network. JSON values only. --
+
+    def usage_report(self, hermes_home: str) -> dict[str, Any]:
+        """What the store holds, for a capacity display; ``{}`` (the default) = not reported. Every key is
+        optional: ``items`` (active stored items), ``storage_bytes``, and ``budgets``, a list of
+        ``{"key", "label", "enabled", "used", "limit", "unit", "listed", "eligible"}`` for each budget the
+        provider itself enforces, counted the way it enforces it (``unit`` e.g. ``"estimated tokens"``;
+        ``listed`` of ``eligible`` items fit). Report no limit the provider does not enforce."""
+        return {}
+
+    def review_items(self, hermes_home: str) -> dict[str, Any]:
+        """The stored items a user-started memory checkup reads; ``{}`` (the default) = not supported.
+        ``{"items": [{"id", "text", ...}]}``; optional per item: ``created_at`` (epoch seconds),
+        ``protected`` (the user marked it to keep), ``uses`` (times recalled), ``score`` (the provider's own
+        0-1 trust, higher is better), ``unconfirmed`` (a conclusion nobody confirmed). Hermes orders the checkup
+        by these and never proposes removing a protected or week-old item; the provider decides nothing."""
+        return {}
diff --git a/apps/desktop/AGENTS.md b/apps/desktop/AGENTS.md
