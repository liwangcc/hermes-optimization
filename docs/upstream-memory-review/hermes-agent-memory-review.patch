diff --git a/hermes_cli/memory_actions.py b/hermes_cli/memory_actions.py
new file mode 100644
index 00000000..ef72e670
--- /dev/null
+++ b/hermes_cli/memory_actions.py
@@ -0,0 +1,118 @@
+"""Memory provider maintenance jobs: what the active provider offers (``GET /api/memory/actions``) and running one to
+the end (``hermes memory action <id>``, the process the Desktop starts and tails).
+
+A job is the provider's: Hermes lists it, calls its steps in order and prints where it stands; it decides nothing.
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+from typing import Any, Callable, Optional
+
+_log = logging.getLogger(__name__)
+
+ACTION_ID_RE = re.compile(r"[A-Za-z0-9_-]{1,64}")
+_MAX_STEPS = 100_000
+_STALLED_AFTER = 20  # the same status this many steps in a row: the job is not moving
+
+
+def active_provider_name(config: dict[str, Any]) -> str:
+    from agent.memory_provider import is_core_memory_provider
+
+    section = config.get("memory")
+    name = str(section.get("provider") or "").strip() if isinstance(section, dict) else ""
+    return "" if is_core_memory_provider(name) else name
+
+
+def _clean(raw: Any) -> Optional[dict[str, Any]]:
+    """One job as the Desktop may show it, or None when it is not one."""
+    if not isinstance(raw, dict) or not ACTION_ID_RE.fullmatch(str(raw.get("id") or "")):
+        return None
+    return {"id": str(raw["id"]), "label": str(raw.get("label") or raw["id"]),
+            "description": str(raw.get("description") or ""), "status": str(raw.get("status") or ""),
+            "ready": raw.get("ready") is not False}
+
+
+def _listed(provider: Any, hermes_home: str) -> list[dict[str, Any]]:
+    raw = provider.maintenance_actions(hermes_home)
+    return [a for a in map(_clean, raw if isinstance(raw, list) else []) if a]
+
+
+def provider_actions(config: dict[str, Any], hermes_home: str, load: Callable[[str], Any]) -> dict[str, Any]:
+    """``{"provider", "state", "actions"}``; ``state``: ``disabled`` (no provider), ``unavailable`` (it did not load,
+    or listing raised), ``unsupported`` (it offers no job) or ``ok``."""
+    name = active_provider_name(config)
+    if not name:
+        return {"provider": "", "state": "disabled", "actions": []}
+    provider = load(name)
+    if provider is None:
+        return {"provider": name, "state": "unavailable", "actions": []}
+    try:
+        actions = _listed(provider, hermes_home)
+    except Exception:  # health: allow BLE001 -- a plugin's listing may raise anything; its jobs then read as unavailable
+        _log.warning("memory provider %s failed in maintenance_actions()", name, exc_info=True)
+        return {"provider": name, "state": "unavailable", "actions": []}
+    return {"provider": name, "state": "ok" if actions else "unsupported", "actions": actions}
+
+
+def _say(line: str) -> None:
+    print(line, flush=True)  # the Desktop tails this process's log while it runs
+
+
+def run_action(action_id: str, provider: Any, hermes_home: str, out: Callable[[str], None] = _say) -> int:
+    """Run one job to the end. The exit code is the job's outcome the Desktop shows: 0 done, 1 failed or could
+    not start, 2 no such job."""
+    action = next((a for a in _listed(provider, hermes_home) if a["id"] == action_id), None)
+    if action is None:
+        out(f"{provider.name} offers no job {action_id!r}.")
+        return 2
+    if not action["ready"]:
+        out(f"{action['label']} cannot run yet: {action['status']}")
+        return 1
+    out(f"{action['label']}: {action['status']}" if action["status"] else action["label"])
+    last, same = None, 0
+    for _ in range(_MAX_STEPS):
+        try:
+            step = provider.run_maintenance_step(action_id, hermes_home)
+        except Exception as exc:  # health: allow BLE001 -- the provider's failure ends its job, in its own words
+            _log.warning("memory provider %s failed in run_maintenance_step(%s)", provider.name, action_id, exc_info=True)
+            out(f"Failed: {exc}")
+            return 1
+        step = step if isinstance(step, dict) else {}
+        status = str(step.get("status") or "")
+        if status:
+            out(status)
+        if step.get("done"):
+            out(str(step.get("result") or "Done."))
+            return 0
+        same, last = (same + 1 if status == last else 0), status
+        if same >= _STALLED_AFTER:
+            out(f"Stopped: {_STALLED_AFTER} steps in a row changed nothing ({status or 'no status'}).")
+            return 1
+    out("Stopped: the job did not finish.")
+    return 1
+
+
+def cmd_memory_action(args: Any) -> None:
+    """``hermes memory action [ID]``: list the active provider's jobs, or run one."""
+    from hermes_cli.config import load_config
+    from hermes_constants import get_hermes_home
+    from plugins.memory import load_memory_provider
+
+    name = active_provider_name(load_config())
+    if not name:
+        _say("No memory provider is active, so there are no provider jobs. Choose one: hermes memory setup")
+        raise SystemExit(1)
+    provider = load_memory_provider(name, register_skills=False)
+    if provider is None:
+        _say(f"Memory provider {name} could not be loaded; see: hermes memory status")
+        raise SystemExit(1)
+    home = str(get_hermes_home())
+    if args.action_id:
+        raise SystemExit(run_action(args.action_id, provider, home))
+    actions = _listed(provider, home)
+    if not actions:
+        _say(f"{name} offers no jobs.")
+    for a in actions:
+        _say(f"{a['id']}: {a['label']}{'' if a['ready'] else ' (not ready)'} — {a['status']}")
