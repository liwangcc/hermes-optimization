+import { LOCAL_CONNECTION_ID } from '@hermes/shared'
+
+import { dropBrowserProfilePrefs, migrateBrowserProfilePrefs } from '@/lib/browser-profile-prefs'
+
+import { dropQueuedLaunchPicksForProfile, migrateQueuedLaunchPicksForProfile } from './composer-queued-pick'
+import { dropMemoryCheckupReminder, migrateMemoryCheckupReminder } from './memory-checkup-reminder'
+import { dropPreviewTabsForProfile, migratePreviewTabsForProfile } from './preview'
+
+// The profile-keyed localStorage families beside the session tiles: the rail's
+// tabs, the browser prefs, the queued launch pick and the memory-checkup
+// reminder. A new family joins both functions.
+
+/** A deleted profile's records go with it: a later profile of the same name must not inherit them. */
+export function dropProfileFamilies(name: string, route?: { connectionId?: string }): void {
+  // F4: the cookie jar lives in LOCAL userData — clear it only for a LOCAL delete, never a remote one.
+  dropPreviewTabsForProfile(name, (String(route?.connectionId ?? '').trim() || LOCAL_CONNECTION_ID) === LOCAL_CONNECTION_ID)
+  dropBrowserProfilePrefs(name, route?.connectionId?.trim() || undefined)
+  dropQueuedLaunchPicksForProfile(name, route ? (route.connectionId ?? '') : undefined)
+  dropMemoryCheckupReminder(name, route?.connectionId?.trim() || undefined)
+}
+
+/** A renamed profile's records move with it, or it opens without them and the old name keeps them. */
+export function migrateProfileFamilies(from: string, to: string): void {
+  migratePreviewTabsForProfile(from, to)
+  migrateBrowserProfilePrefs(from, to)
+  migrateQueuedLaunchPicksForProfile(from, to)
+  migrateMemoryCheckupReminder(from, to)
+}
