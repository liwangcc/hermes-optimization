+// @vitest-environment jsdom
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type * as MemoryCheckupStore from './memory-checkup'
+
+const mocks = vi.hoisted(() => {
+  const makeAtom = <T>(initial: T) => {
+    let value = initial
+
+    return {
+      get: () => value,
+      set(next: T) {
+        value = next
+      }
+    }
+  }
+
+  return {
+    activeProfile: makeAtom('default'),
+    apiScope: makeAtom<{ connectionId: null | string; profile: null | string }>({ connectionId: null, profile: null }),
+    runMemoryCheckup: vi.fn()
+  }
+})
+
+vi.mock('@/api/client', () => ({
+  $apiRequestScope: mocks.apiScope,
+  resolveOwnerNow: () => ({ connectionId: mocks.apiScope.get().connectionId, profile: mocks.activeProfile.get() })
+}))
+
+vi.mock('@/api/system', () => ({ runMemoryCheckup: mocks.runMemoryCheckup }))
+
+vi.mock('@/i18n', () => ({ translateNow: (key: string) => key }))
+
+vi.mock('@/store/notifications', () => ({
+  readableError: (error: unknown, fallback: string) => ({ message: fallback, detail: String((error as Error).message) })
+}))
+
+vi.mock('@/store/profile', () => ({
+  $activeGatewayProfile: mocks.activeProfile,
+  normalizeProfileKey: (name: null | string | undefined) => (name ?? '').trim() || 'default'
+}))
+
+let app: typeof MemoryCheckupStore
+
+beforeEach(async () => {
+  vi.resetModules()
+  mocks.activeProfile.set('default')
+  mocks.apiScope.set({ connectionId: null, profile: null })
+  mocks.runMemoryCheckup.mockReset()
+  app = await import('./memory-checkup')
+})
+
+describe('memory checkup run', () => {
+  it('runs the model once per click, for the profile in view when clicked', async () => {
+    let finish: (value: unknown) => void = () => undefined
+
+    mocks.runMemoryCheckup.mockReturnValue(new Promise(resolve => (finish = resolve)))
+    mocks.activeProfile.set('work')
+
+    const run = app.startMemoryCheckup()
+
+    void app.startMemoryCheckup()
+    mocks.activeProfile.set('default')
+    finish({ model: 'm', generated_at: 1, dropped: 0, layers: {} })
+    await run
+
+    expect(mocks.runMemoryCheckup).toHaveBeenCalledTimes(1)
+    expect(mocks.runMemoryCheckup).toHaveBeenCalledWith({ connectionId: null, profile: 'work' })
+    expect(app.$memoryCheckupRun.get()).toMatchObject({ status: 'done', scope: 'local::work' })
+  })
+
+  it('reports a failed model call as a failure the user can retry', async () => {
+    mocks.runMemoryCheckup.mockRejectedValueOnce(new Error('503: no credentials'))
+    await app.startMemoryCheckup()
+
+    expect(app.$memoryCheckupRun.get()).toEqual({
+      status: 'failed',
+      scope: 'local::default',
+      message: 'memoryCheckup.failed',
+      detail: '503: no credentials'
+    })
+
+    mocks.runMemoryCheckup.mockResolvedValueOnce({ model: 'm', generated_at: 2, dropped: 0, layers: {} })
+    await app.startMemoryCheckup()
+    expect(app.$memoryCheckupRun.get().status).toBe('done')
+    expect(mocks.runMemoryCheckup).toHaveBeenCalledTimes(2)
+  })
+})
