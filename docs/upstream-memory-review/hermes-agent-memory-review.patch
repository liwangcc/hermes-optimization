@@ -0,0 +1,98 @@
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type * as SystemApi from '@/api/system'
+import { runMemoryCheckup } from '@/api/system'
+import { $routeRequest } from '@/store/recovery-requests'
+import type { MemoryCheckupLayer, MemoryCheckupResponse } from '@/types/memory-checkup'
+
+vi.mock('@/api/system', async importOriginal => ({
+  ...(await importOriginal<typeof SystemApi>()),
+  runMemoryCheckup: vi.fn()
+}))
+
+const { $memoryCheckupRun, clearMemoryCheckupRun } = await import('@/store/memory-checkup')
+
+const { $memoryCheckupReminder, checkMemoryCheckupDue, setMemoryCheckupReminder } = await import(
+  '@/store/memory-checkup-reminder'
+)
+
+const { MemoryCheckupReminderStrip } = await import('./reminder-strip')
+
+const DAY = 24 * 60 * 60 * 1000
+
+const empty: MemoryCheckupLayer = { state: 'empty', total: 0, reviewed: 0, changes: [], needs_evidence: [], keep: [] }
+const done: MemoryCheckupResponse = { model: '', generated_at: 1, dropped: 0, layers: { user: empty, memory: empty, facts: empty } }
+
+const dueReminder = () =>
+  act(() => {
+    setMemoryCheckupReminder({ enabled: true }, Date.now() - 15 * DAY)
+    checkMemoryCheckupDue()
+  })
+
+beforeEach(() => {
+  window.localStorage.clear()
+  vi.mocked(runMemoryCheckup).mockReset()
+  act(() => {
+    clearMemoryCheckupRun()
+    checkMemoryCheckupDue()
+  })
+})
+
+afterEach(cleanup)
+
+describe('memory checkup reminder strip', () => {
+  it('starts the next interval once it has been on screen, and showing it again changes nothing', () => {
+    vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout'] })
+
+    try {
+      dueReminder()
+
+      const past = $memoryCheckupReminder.get().dueAt!
+
+      // A strip that only flashed (another offer took the slot back) has not been shown.
+      render(<MemoryCheckupReminderStrip />)
+      vi.advanceTimersByTime(200)
+      cleanup()
+      vi.advanceTimersByTime(5000)
+      expect($memoryCheckupReminder.get().dueAt).toBe(past)
+
+      render(<MemoryCheckupReminderStrip />)
+      act(() => void vi.advanceTimersByTime(1000))
+
+      const due = $memoryCheckupReminder.get().dueAt!
+
+      expect(due - Date.now()).toBeGreaterThan(13 * DAY)
+      cleanup()
+      render(<MemoryCheckupReminderStrip />)
+      act(() => void vi.advanceTimersByTime(5000))
+      expect($memoryCheckupReminder.get()).toMatchObject({ dueAt: due, pending: true })
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+
+  it('"Next time" dismisses it without running a model or recording a checkup', () => {
+    dueReminder()
+    render(<MemoryCheckupReminderStrip />)
+
+    fireEvent.click(screen.getByRole('button', { name: 'Next time' }))
+
+    expect($memoryCheckupReminder.get().pending).toBe(false)
+    expect(runMemoryCheckup).not.toHaveBeenCalled()
+    expect($memoryCheckupRun.get()).toEqual({ status: 'idle' })
+  })
+
+  it('"Review now" starts the one checkup and opens the panel that shows it', async () => {
+    vi.mocked(runMemoryCheckup).mockResolvedValue(done)
+    dueReminder()
+    render(<MemoryCheckupReminderStrip />)
+
+    fireEvent.click(screen.getByRole('button', { name: 'Review now' }))
+
+    expect($memoryCheckupReminder.get().pending).toBe(false)
+    expect($routeRequest.get()?.path).toBe('/command-center?section=maintenance')
+    await waitFor(() => expect($memoryCheckupRun.get().status).toBe('done'))
+    expect(runMemoryCheckup).toHaveBeenCalledTimes(1)
+  })
+})
diff --git a/apps/desktop/src/components/memory-checkup/reminder-strip.tsx b/apps/desktop/src/components/memory-checkup/reminder-strip.tsx
