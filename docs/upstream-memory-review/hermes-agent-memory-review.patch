diff --git a/tests/agent/test_memory_checkup.py b/tests/agent/test_memory_checkup.py
new file mode 100644
index 00000000..37ca4b4b
--- /dev/null
+++ b/tests/agent/test_memory_checkup.py
@@ -0,0 +1,156 @@
+"""The memory checkup's rules that a prompt cannot guarantee: what is exempt from removal, what is reviewed
+first, and which of a model's proposals stand. A fixed ``now`` stands in for the clock."""
+
+import json
+
+import pytest
+
+from agent import memory_checkup as mc
+
+NOW = 1_800_000_000.0
+DAY = 86400.0
+
+
+def _fact(fact_id, text, *, age_days=100.0, **signals):
+    return {"id": str(fact_id), "text": text, "created_at": NOW - age_days * DAY, **signals}
+
+
+def _layers(facts, user=("Prefers replies in Chinese",), memory=()):
+    return {
+        "user": {"state": "ok", "items": [{"id": n, "text": t} for n, t in enumerate(user, 1)]},
+        "memory": {"state": "ok" if memory else "empty", "items": [{"id": n, "text": t} for n, t in enumerate(memory, 1)]},
+        "facts": {"state": "ok", "items": facts},
+    }
+
+
+def _review(facts, proposals, **layers):
+    prepared = mc.prepare(_layers(facts, **layers), NOW)
+    return mc.read_reply(json.dumps({"proposals": proposals}), prepared), prepared
+
+
+def _ref(prepared, fact_id):
+    return next(i["ref"] for i in prepared["facts"]["items"] if i["id"] == str(fact_id))
+
+
+def test_a_protected_item_and_a_week_old_item_are_exempt_and_an_undated_one_is_not():
+    assert mc.exemption(_fact(1, "x", protected=True), NOW) == "protected"
+    assert mc.exemption(_fact(1, "x", age_days=6.9), NOW) == "grace"
+    assert mc.exemption(_fact(1, "x", age_days=7.0), NOW) == ""
+    assert mc.exemption({"id": "1", "text": "x"}, NOW) == ""  # no creation date: nothing says it is new
+
+
+def test_feedback_outranks_an_unconfirmed_origin_which_outranks_disuse():
+    disliked = _fact(1, "a", score=0.1, uses=9)
+    unconfirmed = _fact(2, "b", score=1.0, uses=9, unconfirmed=True)
+    idle = _fact(3, "c", score=1.0, uses=0)
+    fine = _fact(4, "d", score=1.0, uses=9)
+    assert mc.priority(disliked, NOW) > mc.priority(unconfirmed, NOW) > mc.priority(idle, NOW) > mc.priority(fine, NOW)
+    # Disuse alone is the weakest signal there is, and counts only once the item is a month old.
+    assert mc.priority(idle, NOW) == pytest.approx(0.2)
+    assert mc.priority(_fact(5, "e", age_days=20, score=1.0, uses=0), NOW) == 0.0
+    # A provider that reports no signals gives no priority, and an exempt item is never reviewed first.
+    assert mc.priority({"id": "6", "text": "f"}, NOW) == 0.0
+    assert mc.priority(_fact(7, "g", score=0.0, protected=True), NOW) == 0.0
+
+
+def test_the_input_budget_keeps_the_highest_priority_and_says_how_many_were_left_out():
+    facts = [_fact(1, "a" * 40, score=0.9), _fact(2, "b" * 40, score=0.1), _fact(3, "c" * 40, score=0.5)]
+    prepared = mc.prepare(_layers(facts), NOW, budget=90)
+    assert [i["id"] for i in prepared["facts"]["items"]] == ["2", "3"]
+    assert prepared["facts"]["total"] == 3
+    reply = mc.read_reply('{"proposals": []}', prepared)
+    assert (reply["layers"]["facts"]["reviewed"], reply["layers"]["facts"]["total"]) == (2, 3)
+
+
+def test_the_prompt_names_every_entry_and_marks_what_is_exempt():
+    facts = [_fact(1, "old fact", uses=3, score=0.4), _fact(2, "new fact", age_days=1), _fact(3, "kept", protected=True)]
+    prepared = mc.prepare(_layers(facts, memory=("Deploy from the release branch",)), NOW)
+    system, user = mc.build_messages(prepared, NOW)
+    assert system["role"] == "system" and user["role"] == "user"
+    for text in ("Prefers replies in Chinese", "Deploy from the release branch", "old fact", "new fact", "kept"):
+        assert text in user["content"]
+    line = {i["id"]: next(l for l in user["content"].splitlines() if l.startswith(i["ref"])) for i in prepared["facts"]["items"]}
+    assert "grace" in line["2"] and "protected" in line["3"] and "grace" not in line["1"]
+    assert "recalled 3x" in line["1"]
+
+
+def test_a_removal_with_a_named_duplicate_stands_and_everything_unmentioned_is_kept():
+    facts = [_fact(7, "The database is Postgres"), _fact(8, "The database is PostgreSQL 16")]
+    prepared = mc.prepare(_layers(facts), NOW)
+    reply = mc.read_reply(json.dumps({"proposals": [{
+        "target": _ref(prepared, 7), "action": "remove", "basis": "duplicate", "with": [_ref(prepared, 8)],
+        "evidence": "8 says the same and adds the version", "preserve": "the version"}]}), prepared)
+    facts_layer = reply["layers"]["facts"]
+    [change] = facts_layer["changes"]
+    assert change["action"] == "remove" and change["target"] == {"layer": "facts", "id": "7", "text": "The database is Postgres"}
+    assert change["with"] == [{"layer": "facts", "id": "8", "text": "The database is PostgreSQL 16"}]
+    assert (change["evidence"], change["preserve"]) == ("8 says the same and adds the version", "the version")
+    assert [k["id"] for k in facts_layer["keep"]] == ["8"] and not facts_layer["needs_evidence"]
+    assert [k["text"] for k in reply["layers"]["user"]["keep"]] == ["Prefers replies in Chinese"]
+
+
+@pytest.mark.parametrize("fact, proposal, held", [
+    # the user's protection: neither removal nor a rewrite is proposed
+    (_fact(1, "x", protected=True), {"action": "remove", "basis": "outdated", "evidence": "e"}, "protected"),
+    (_fact(1, "x", protected=True), {"action": "update", "basis": "outdated", "evidence": "e", "new_text": "y"}, "protected"),
+    # seven days of grace before a routine review may propose removal
+    (_fact(1, "x", age_days=2), {"action": "remove", "basis": "outdated", "evidence": "e"}, "grace"),
+    # low use alone never justifies removal, whatever else the model writes around it
+    (_fact(1, "x", uses=0), {"action": "remove", "basis": "unused", "evidence": "never recalled in 100 days"}, "usage"),
+    # no evidence, a basis that proves nothing, or a duplicate that names no other entry
+    (_fact(1, "x"), {"action": "remove", "basis": "outdated", "evidence": ""}, "evidence"),
+    (_fact(1, "x"), {"action": "remove", "basis": "unverified", "evidence": "e"}, "evidence"),
+    (_fact(1, "x"), {"action": "remove", "basis": "duplicate", "evidence": "e"}, "evidence"),
+    (_fact(1, "x"), {"action": "update", "basis": "outdated", "evidence": "e"}, "evidence"),  # says not what it becomes
+])
+def test_a_change_the_rules_do_not_allow_is_kept_only_as_a_question(fact, proposal, held):
+    _, prepared = _review([fact], [])
+    reply = mc.read_reply(json.dumps({"proposals": [{"target": _ref(prepared, 1), **proposal}]}), prepared)
+    layer = reply["layers"]["facts"]
+    assert not layer["changes"] and not layer["keep"]
+    [question] = layer["needs_evidence"]
+    assert (question["action"], question["proposed"], question["held"]) == ("needs_evidence", proposal["action"], held)
+
+
+def test_grace_covers_deletion_only_and_a_merge_may_not_swallow_an_exempt_item():
+    new, old = _fact(1, "The editor is Zed", age_days=2), _fact(2, "Uses the Zed editor")
+    _, prepared = _review([new, old], [])
+    reword = mc.read_reply(json.dumps({"proposals": [{
+        "target": _ref(prepared, 1), "action": "update", "basis": "other", "evidence": "clearer", "new_text": "Uses Zed"}]}), prepared)
+    assert [c["action"] for c in reword["layers"]["facts"]["changes"]] == ["update"]
+    swallow = mc.read_reply(json.dumps({"proposals": [{
+        "target": _ref(prepared, 2), "action": "merge", "basis": "duplicate", "with": [_ref(prepared, 1)],
+        "evidence": "same", "new_text": "Uses the Zed editor"}]}), prepared)
+    assert swallow["layers"]["facts"]["needs_evidence"][0]["held"] == "grace"
+    keep_new = mc.read_reply(json.dumps({"proposals": [{
+        "target": _ref(prepared, 1), "action": "merge", "basis": "duplicate", "with": [_ref(prepared, 2)],
+        "evidence": "same", "new_text": "Uses the Zed editor"}]}), prepared)
+    facts = keep_new["layers"]["facts"]
+    assert [c["action"] for c in facts["changes"]] == ["merge"] and not facts["keep"]  # the folded-in entry is not "keep"
+
+
+def test_a_proposal_about_nothing_real_is_dropped_and_counted():
+    _, prepared = _review([_fact(1, "x")], [])
+    ref = _ref(prepared, 1)
+    reply = mc.read_reply(json.dumps({"proposals": [
+        {"target": "f99", "action": "remove", "basis": "outdated", "evidence": "e"},
+        {"target": ref, "action": "delete_everything"},
+        "not an object",
+        {"target": ref, "action": "needs_evidence", "evidence": "check with the user"},
+        {"target": ref, "action": "remove", "basis": "outdated", "evidence": "a second verdict on one entry"},
+    ]}), prepared)
+    assert reply["dropped"] == 4
+    assert [q["evidence"] for q in reply["layers"]["facts"]["needs_evidence"]] == ["check with the user"]
+
+
+@pytest.mark.parametrize("text", ["", "I could not review this.", '{"proposals": "none"}', "{not json}", "[1, 2]"])
+def test_a_reply_that_is_not_the_review_is_an_error_not_an_empty_review(text):
+    prepared = mc.prepare(_layers([_fact(1, "x")]), NOW)
+    with pytest.raises(mc.CheckupReplyError):
+        mc.read_reply(text, prepared)
+
+
+def test_a_reply_wrapped_in_a_code_fence_is_read():
+    prepared = mc.prepare(_layers([_fact(1, "x")]), NOW)
+    reply = mc.read_reply('Here it is:\n```json\n{"proposals": []}\n```', prepared)
+    assert [k["id"] for k in reply["layers"]["facts"]["keep"]] == ["1"]
